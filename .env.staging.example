# Copy this file to .env.staging and edit values before starting staging.
# The staging launcher refuses unsafe DB names and shared production ports.

PORT=3100
NODE_ENV=production
APP_ENV=staging
APP_ORIGIN=http://localhost:3100,https://rx.camperos.net:10443
APP_WRITABLE_ROOT=staging/runtime

# HTTPS enforcement for staging/proxy testing.
# Browser -> FortiGate is HTTPS. FortiGate -> Node staging is HTTP on port 3100.
# Use FortiGate backend URL /http/192.168.15.87:3100, not /https/192.168.15.87:3100.
# FORCE_HTTPS redirects plain external HTTP to HTTPS unless backend HTTP is explicitly allowed.
# HTTPS_ALLOW_LOCAL_HTTP keeps http://localhost:3100 available for local smoke tests.
# HTTPS_ALLOW_BACKEND_HTTP lets the HTTPS proxy reach the plain HTTP Node backend.
# HTTPS_ASSUME_PROXY_HTTPS marks that backend hop as browser-facing HTTPS for Secure cookies.
# ENABLE_HSTS can be enabled after the HTTPS proxy URL is stable.
FORCE_HTTPS=true
HTTPS_ALLOW_LOCAL_HTTP=true
HTTPS_ALLOW_BACKEND_HTTP=true
HTTPS_ASSUME_PROXY_HTTPS=true
ENABLE_HSTS=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_staging_db_password_here
DB_NAME=patient_rx_staging
STAGING_AUTO_MIGRATE=false
STAGING_ALLOW_DB_BOOTSTRAP=false

JWT_SECRET=replace_with_a_staging_only_secret
SOFTPHONE_CREDENTIAL_KEY=replace_with_a_staging_only_softphone_encryption_secret
# Set a staging-only administrator PIN (at least 6 digits/characters) to protect
# RX Softphone account saves. Do not reuse the production PIN.
SOFTPHONE_ACCOUNT_ADMIN_PIN=
TZ=America/New_York

# Keep scheduled jobs off in staging unless you intentionally enable them.
BACKUP_SCHEDULE=off
SITE_BACKUP_SCHEDULE=off
STAGING_ALLOW_SCHEDULED_BACKUPS=false
STAGING_DESTRUCTIVE_GUARD=true
STAGING_DESTRUCTIVE_CONFIRM_TOKEN=replace-with-strong-token
STAGING_CONFIRM_HEADER=x-staging-confirm

# Default staging folders stay under APP_WRITABLE_ROOT.
DOCUMENT_UPLOAD_MAX_MB=25
DOCUMENT_STORAGE_LOCAL_DIR=uploads/documents
DOCUMENT_STORAGE_REQUIRE_DRIVE=false
DOCUMENT_STORAGE_ALLOW_LOCAL_FALLBACK=true
SITE_BACKUP_DIR=staging/runtime/site-backups

# Use false for normal staging unless you are specifically testing Drive.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Patient RX Staging Documents
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Set true only for an empty staging DB when you need a temporary first admin.
# After first login, change the password and set this back to false.
ALLOW_DEFAULT_SEED=false

# Optional SMTP for staging email tests. Leave blank to avoid sending mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Patient RX Staging
