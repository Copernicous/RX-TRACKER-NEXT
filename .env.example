PORT=3000
NODE_ENV=development
# Long-running server credentials. In production, use the restricted RX Tracker
# runtime role, not postgres. Project Control requests the separate maintenance
# login in memory when an update or rollback needs backup/migration privileges.
DB_USER=postgres
DB_PASS=your_db_password_here
DB_NAME=patient_rx_dev
DB_HOST=127.0.0.1
JWT_SECRET=supersecretjwtkey_12345
# Separate encryption secret for server-managed SIP passwords. Use a long,
# stable random value in production and keep it unchanged across upgrades.
# When omitted, RX Tracker falls back to JWT_SECRET for backward compatibility.
SOFTPHONE_CREDENTIAL_KEY=
# Dedicated HMAC secret for outbound softphone pairing codes and device tokens.
# Use a separate long, stable random value in production. When omitted, the
# relay falls back to JWT_SECRET for backward compatibility.
SOFTPHONE_RELAY_SECRET=
# Optional shared administrator PIN required when a user saves or changes the
# assigned RX Softphone account. Use at least 6 digits/characters in production.
# It is compared only on the server and is never returned to the browser.
SOFTPHONE_ACCOUNT_ADMIN_PIN=
TZ=America/New_York
APP_ORIGIN=http://localhost:3000
# Add every URL users type in the browser, separated by commas.
# Example for a LAN server on port 3050:
# APP_ORIGINS=http://localhost:3050,http://127.0.0.1:3050,http://192.168.15.12:3050
# RX Tracker production / second-server validation example:
# APP_ORIGINS=https://rx.rbandrc.com,https://rx.camperos.net:10443,https://portal.rbandrc.com,http://192.168.60.21:3000,http://localhost:3000
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Number of successful PostgreSQL dump files and full-site ZIP files retained.
# Changes require an RX Tracker restart. These are file counts, not days.
BACKUP_RETAIN=10
SITE_BACKUP_RETAIN=5

# Scheduler startup controls. Keep these true for the application-managed
# schedules. Set false in isolated tests or when an approved external scheduler
# owns the job; false prevents the internal cron handle from starting.
BACKUP_SCHEDULER_ENABLED=true
SITE_BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
SITE_BACKUP_SCHEDULE=0 3 * * 0

# Delivery Log carbon-copy archive capacity. Archives remain local under the
# writable administration/delivery-log-archives folder and are never committed.
# Printing fails closed at the limit until an administrator performs cleanup.
DELIVERY_LOG_ARCHIVE_MAX_FILES=5000
DELIVERY_LOG_ARCHIVE_MAX_BYTES=1073741824

# Read-only Backoffice Routine Database Check thresholds. These checks never
# create/drop indexes, run VACUUM FULL, or perform a restore. Recoverability is
# reported only from separately produced isolated restore-validation evidence.
DB_HEALTH_SLOW_QUERY_MIN_CALLS=10
DB_HEALTH_SLOW_QUERY_MEAN_MS_WARNING=250
DB_HEALTH_SLOW_QUERY_TOTAL_MS_WARNING=5000

DB_HEALTH_MISSING_INDEX_MIN_ROWS=5000
DB_HEALTH_MISSING_INDEX_MIN_TABLE_MB=8
DB_HEALTH_MISSING_INDEX_MIN_CALLS=20
DB_HEALTH_MISSING_INDEX_MIN_MEAN_MS=120
DB_HEALTH_MISSING_INDEX_MIN_EVIDENCE_CALLS=20
DB_HEALTH_MISSING_INDEX_SEQ_IDX_RATIO=20
DB_HEALTH_MISSING_INDEX_STATS_HOURS=24
DB_HEALTH_MISSING_INDEX_TOP_TABLES=20
DB_HEALTH_MISSING_INDEX_CONF_SCORE_WARN=70

DB_HEALTH_UNUSED_INDEX_MIN_MB=10
DB_HEALTH_INDEX_OBSERVATION_DAYS=30
DB_HEALTH_UNUSED_INDEX_WARNING_WRITES=2500
DB_HEALTH_UNUSED_INDEX_IGNORE_LIKE=%cleanup%,%purge%,%retention%,%archive%,%_fkey%,%_fk_%

DB_HEALTH_LARGE_COLUMN_MIN_AVG_BYTES=1024
DB_HEALTH_LARGE_VARCHAR_MIN_LENGTH=1024
DB_HEALTH_LARGE_COLUMN_REPORTED_SIZE_MB=1
DB_HEALTH_LARGE_COLUMN_TOPN=12
DB_HEALTH_LARGE_COLUMN_QUERY_TIMEOUT_MS=1500
DB_HEALTH_LARGE_COLUMN_CHECK_BUDGET_MS=10000

DB_HEALTH_DEADROW_WARNING_RATIO_PCT=12
DB_HEALTH_SMALL_TABLE_ROWS=4000
DB_HEALTH_BACKUP_RECENT_HOURS=24
DB_HEALTH_BACKUP_VALIDATION_MAX_AGE_HOURS=48

# Optional branding defaults. Administrators can change the same values later
# under System Settings > General without editing .env. Image values must be
# blank or safe same-site paths under public/, such as /images/company-logo.png.
APP_NAME=Patient RX System
BRAND_TITLE=Patient RX
BRAND_SUBTITLE=Delivery Management System
BRAND_ICON_CLASS=fas fa-pills
BRAND_ICON_URL=
LOGIN_BACKGROUND_URL=

# HTTPS / reverse proxy handling.
# For FortiGate SSL VPN with HTTPS browser access and an internal HTTP backend,
# production commonly uses:
# FORCE_HTTPS=true
# HTTPS_ALLOW_BACKEND_HTTP=true
# HTTPS_ASSUME_PROXY_HTTPS=true
# ENABLE_HSTS=true only after the public HTTPS URL is stable.
FORCE_HTTPS=false
HTTPS_ALLOW_LOCAL_HTTP=false
HTTPS_ALLOW_BACKEND_HTTP=false
HTTPS_ASSUME_PROXY_HTTPS=false
ENABLE_HSTS=false

# ── Email / SMTP Settings ────────────────────────────────────────
# For Gmail: use an App Password (NOT your real Gmail password)
# Setup: myaccount.google.com/security → 2-Step → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Patient RX System

# Google Drive document storage
# Run npm run drive:auth locally to generate these values.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Patient RX Documents
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Patient/RX picture and document uploads.
# Production should use Google Drive. Local storage is only a dev fallback when Drive is disabled.
DOCUMENT_UPLOAD_MAX_MB=25
DOCUMENT_STORAGE_LOCAL_DIR=uploads/documents
DOCUMENT_STORAGE_REQUIRE_DRIVE=false
DOCUMENT_STORAGE_ALLOW_LOCAL_FALLBACK=false
