# Patient RX QA settings
# Copy this file to qa/.env.qa and adjust only if needed.

# Browser URL used by the smoke test.
QA_BASE_URL=https://localhost:3443

# Local QA topology:
# Browser -> HTTPS proxy on QA_HTTPS_PORT -> Node backend on QA_BACKEND_PORT
QA_HTTPS_PORT=3443
QA_BACKEND_PORT=3001

# Separate QA database. Do not point this at production.
QA_DB_NAME=patient_rx_qa

# Login used only for QA/staging smoke tests.
QA_LOGIN_USERNAME=admin
QA_LOGIN_PASSWORD=admin

# CORS origins used when qa/start-local-qa.js launches the app.
QA_APP_ORIGIN=https://localhost:3443,http://localhost:3001

# Browser mode.
# true  = fast invisible browser
# false = visible browser
QA_HEADLESS=true
QA_SLOW_MO=0

# Optional smoke-test mode.
# true seeds/checks an expired 90-day Needs Action workflow.
QA_SMOKE_NEEDS_ACTION=false

# Optional passwordless QA web dashboard.
QA_WEB_HOST=127.0.0.1
QA_WEB_PORT=3200

# Optional if Chrome is installed somewhere unusual.
# QA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Safety: the seeder refuses non-QA database names unless this is true.
QA_ALLOW_NON_QA_DB=false
