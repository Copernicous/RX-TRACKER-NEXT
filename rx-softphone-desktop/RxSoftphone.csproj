<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RxSoftphone</AssemblyName>
    <RootNamespace>RxSoftphone</RootNamespace>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.12" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="publish\**;publish-*\**;release\**" />
    <None Remove="publish\**;publish-*\**;release\**" />
  </ItemGroup>
</Project>
