<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Settings - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .setting-card { border-left: 4px solid var(--primary-color, #6366f1); transition: box-shadow .2s; }
        .setting-card:hover { box-shadow: 0 4px 20px rgba(99,102,241,.12); }
        .setting-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.2rem; }
        .tz-badge { display:inline-block; background:rgba(99,102,241,.12); color:#6366f1; border-radius:20px; padding:2px 12px; font-size:.78rem; font-weight:600; }
        .save-indicator { display:none; align-items:center; gap:6px; color:#22c55e; font-size:.85rem; font-weight:600; }
        .save-indicator.visible { display:flex; }
        .clock-live { font-family:'Inter',monospace; font-size:1.4rem; font-weight:700; letter-spacing:.04em; color:var(--primary-color,#6366f1); }
        .restart-notice { background:rgba(245,166,35,.08); border:1px solid rgba(245,166,35,.3); border-radius:10px; padding:10px 16px; font-size:.82rem; }

        /* API Key styles */
        .apikey-reveal {
            font-family: 'Courier New', monospace;
            font-size: .85rem;
            background: #0d1117;
            color: #58a6ff;
            border-radius: 8px;
            padding: 12px 16px;
            letter-spacing: .04em;
            word-break: break-all;
        }
        .key-prefix {
            font-family: 'Courier New', monospace;
            font-size: .82rem;
            background: rgba(99,102,241,.08);
            color: #6366f1;
            border-radius: 6px;
            padding: 2px 8px;
        }
        .key-row { transition: background .15s; }
        .key-row:hover { background: rgba(99,102,241,.04); }
        .status-dot { width:8px; height:8px; border-radius:50%; display:inline-block; margin-right:5px; }
        .status-dot.active   { background:#22c55e; box-shadow: 0 0 6px rgba(34,197,94,.5); }
        .status-dot.inactive { background:#ef4444; }
        .expiry-warning { color: #f59e0b; font-size: .75rem; }
        .new-key-banner {
            border: 1.5px solid #22c55e;
            border-radius: 12px;
            background: rgba(34,197,94,.05);
            padding: 16px;
            animation: fadeIn .4s ease;
        }
        @keyframes fadeIn { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }
        .copy-btn { cursor: pointer; transition: color .15s; }
        .copy-btn:hover { color: #22c55e !important; }
        .api-usage-box {
            font-family: 'Courier New', monospace;
            font-size: .78rem;
            background: #0d1117;
            color: #8b949e;
            border-radius: 8px;
            padding: 10px 14px;
        }
        .api-usage-box .hl { color: #58a6ff; }
        .api-usage-box .val { color: #a5d6ff; }

        .api-filter {
            font-size:.72rem; padding:3px 10px; border-radius:20px;
            border:1px solid rgba(99,102,241,.3); background:transparent;
            color:#6366f1; transition:all .15s; cursor:pointer;
        }
        .api-filter.active, .api-filter:hover {
            background:rgba(99,102,241,.15); border-color:#6366f1; font-weight:600;
        }
        .endpoint-row {
            border-left:3px solid transparent; border-radius:6px;
            padding:7px 12px; margin-bottom:3px; transition:background .12s;
        }
        .endpoint-row:hover { background:rgba(99,102,241,.04); }
        .endpoint-row.get    { border-left-color:#22c55e; }
        .endpoint-row.post   { border-left-color:#6366f1; }
        .endpoint-row.put    { border-left-color:#f59e0b; }
        .endpoint-row.patch  { border-left-color:#06b6d4; }
        .endpoint-row.delete { border-left-color:#ef4444; }
        .method-badge {
            font-size:.65rem; font-weight:700; padding:2px 7px; border-radius:4px;
            font-family:monospace; min-width:48px; display:inline-block; text-align:center;
        }
        .method-badge.get    { background:rgba(34,197,94,.15);  color:#16a34a; }
        .method-badge.post   { background:rgba(99,102,241,.15); color:#4f46e5; }
        .method-badge.put    { background:rgba(245,158,11,.15); color:#b45309; }
        .method-badge.patch  { background:rgba(6,182,212,.15);  color:#0e7490; }
        .method-badge.delete { background:rgba(239,68,68,.15);  color:#dc2626; }
        .endpoint-path { font-family:'Courier New',monospace; font-size:.8rem; font-weight:600; }
        .perm-badge { font-size:.68rem; padding:1px 6px; border-radius:3px; background:rgba(107,114,128,.1); color:#6b7280; }
        .perm-badge.admin { background:rgba(239,68,68,.1); color:#ef4444; }
        .section-divider { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:#9ca3af; padding:10px 0 4px; }
    </style>
</head>
<body>
<div class="wrapper">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>

<div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold fs-5"><i class="fas fa-sliders-h me-2 text-primary"></i>System Settings</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">

            <!-- Page Header -->
            <div class="glass-card p-4 mb-4" style="background:linear-gradient(135deg,rgba(99,102,241,.08) 0%,rgba(139,92,246,.05) 100%);border-left:4px solid #6366f1;">
                <div class="d-flex align-items-center gap-3">
                    <div class="setting-icon" style="background:rgba(99,102,241,.15);color:#6366f1;font-size:1.5rem;width:56px;height:56px;border-radius:16px;">
                        <i class="fas fa-sliders-h"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">System Settings</h4>
                        <p class="text-muted small mb-0">Configure system-wide preferences. Changes take effect immediately.</p>
                    </div>
                    <div class="ms-auto text-end">
                        <div class="text-muted small mb-1"><i class="fas fa-clock me-1"></i>Server Current Time</div>
                        <div class="clock-live" id="liveClock">&mdash;</div>
                        <div class="text-muted" style="font-size:.72rem" id="liveTimezone">Loading...</div>
                    </div>
                </div>
            </div>

            <!-- Admin guard -->
            <div id="adminGuard" class="d-none">
                <div class="glass-card p-5 text-center">
                    <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                    <h5 class="fw-bold">Administrator Access Required</h5>
                    <p class="text-muted">Only Administrators can manage system settings.</p>
                </div>
            </div>

            <div id="settingsContent">

                <!-- ── Tab navigation ──────────────────────────────────────── -->
                <ul class="nav nav-pills mb-4 gap-2" id="settingsTabs">
                    <li class="nav-item">
                        <button class="nav-link active" data-tab="general"><i class="fas fa-cog me-2"></i>General</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-tab="email"><i class="fas fa-envelope me-2"></i>Email Setup</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-tab="manual"><i class="fas fa-book me-2"></i>Manual</button>
                    </li>
                </ul>

                <!-- ══════════════════ GENERAL TAB ══════════════════ -->
                <div id="tab-general">

                    <!-- Timezone Card -->
                    <div class="glass-card p-4 mb-4 setting-card">
                        <div class="d-flex align-items-start gap-3">
                            <div class="setting-icon" style="background:rgba(99,102,241,.12);color:#6366f1;">
                                <i class="fas fa-globe"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h6 class="mb-0 fw-bold">Application Timezone</h6>
                                    <span class="tz-badge" id="currentTzBadge">Loading...</span>
                                </div>
                                <p class="text-muted small mb-3">All dates and times recorded by the system &mdash; workflow steps, audit logs, and patient records &mdash; will use this timezone.</p>

                                <div class="p-3 mb-3 rounded-3" style="background:rgba(99,102,241,.05);border:1px dashed rgba(99,102,241,.2);">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-auto">
                                            <div class="text-muted small">Current server time in selected zone:</div>
                                            <div class="fw-bold fs-5" id="previewClock">&mdash;</div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="text-muted small">UTC offset:</div>
                                            <div class="fw-bold" id="previewOffset">&mdash;</div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="text-muted small">Current UTC time:</div>
                                            <div class="fw-bold" id="previewUtc">&mdash;</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 align-items-end">
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold small">Select Timezone</label>
                                        <select class="form-select form-select-sm" id="tzSelect" style="max-width:340px;"><option value="">Loading...</option></select>
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-primary btn-sm" id="saveTzBtn"><i class="fas fa-save me-1"></i>Save Timezone</button>
                                    </div>
                                    <div class="col-auto">
                                        <div class="save-indicator" id="tzSaveOk"><i class="fas fa-check-circle"></i> Saved!</div>
                                    </div>
                                </div>

                                <div class="restart-notice mt-3">
                                    <i class="fas fa-info-circle me-2" style="color:#f5a623"></i>
                                    <strong>Note for Windows servers:</strong> After saving a new timezone, <strong>restart the server once</strong> to fully apply it. On Linux/macOS it takes effect immediately.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- App Name Card -->
                    <div class="glass-card p-4 mb-4 setting-card" style="border-left-color:#22c55e;">
                        <div class="d-flex align-items-start gap-3">
                            <div class="setting-icon" style="background:rgba(34,197,94,.12);color:#22c55e;">
                                <i class="fas fa-tag"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1 fw-bold">Application Name</h6>
                                <p class="text-muted small mb-3">Displayed in the browser tab. Default: "Patient RX System".</p>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-5">
                                        <input type="text" class="form-control form-control-sm" id="appNameInput" placeholder="Patient RX System" style="max-width:300px;">
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-success btn-sm" id="saveNameBtn"><i class="fas fa-save me-1"></i>Save Name</button>
                                    </div>
                                    <div class="col-auto">
                                        <div class="save-indicator" id="nameSaveOk"><i class="fas fa-check-circle"></i> Saved!</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Security / 2FA Global Toggle Card -->
                    <div class="glass-card p-4 mb-4 setting-card" style="border-left-color:#ef4444;">
                        <div class="d-flex align-items-start gap-3">
                            <div class="setting-icon" style="background:rgba(239,68,68,.12);color:#ef4444;">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                    <h6 class="mb-0 fw-bold">Global Two-Factor Authentication (2FA)</h6>
                                    <span id="twoFaBadge" class="badge bg-success">Enabled</span>
                                </div>
                                <p class="text-muted small mb-3">
                                    Controls whether 2FA is enforced system-wide at login. When <strong>disabled</strong>, users
                                    who have 2FA set up will skip the code step &mdash; their authenticator app setup is preserved and
                                    will work again if you re-enable it. This does <strong>not</strong> delete anyone's 2FA configuration.
                                </p>

                                <div class="p-3 rounded-3 mb-3 d-flex align-items-center gap-4 flex-wrap"
                                     style="background:rgba(239,68,68,.05);border:1px dashed rgba(239,68,68,.2);">
                                    <!-- Toggle switch -->
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="form-check form-switch mb-0" style="font-size:1.4rem;">
                                            <input class="form-check-input" type="checkbox" id="twoFaToggle"
                                                   style="width:3rem;height:1.5rem;cursor:pointer;">
                                        </div>
                                        <div>
                                            <div class="fw-semibold small" id="twoFaToggleLabel">2FA is <strong>Enabled</strong></div>
                                            <div class="text-muted" style="font-size:.75rem;">Users with 2FA set up will be prompted for their code</div>
                                        </div>
                                    </div>

                                    <!-- Status pills -->
                                    <div class="d-flex gap-2 flex-wrap ms-auto">
                                        <div class="d-flex align-items-center gap-1 small">
                                            <span class="status-dot" id="twoFaDot" style="background:#22c55e;width:8px;height:8px;border-radius:50%;display:inline-block;"></span>
                                            <span id="twoFaStatusText" class="text-muted">Active</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-danger btn-sm" id="saveTwoFaBtn">
                                        <i class="fas fa-save me-1"></i>Save 2FA Setting
                                    </button>
                                    <div class="save-indicator" id="twoFaSaveOk"><i class="fas fa-check-circle"></i> Saved!</div>
                                </div>
                                <div class="alert alert-warning py-2 small mt-3 mb-0" id="twoFaDisabledWarning" style="display:none;">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    <strong>Warning:</strong> Disabling 2FA globally means all users will log in with password only &mdash; even those who have an authenticator app configured.
                                    Only disable this if you are sure about the security implications.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Settings Summary -->
                    <div class="glass-card p-4 mb-4">
                        <h6 class="fw-bold mb-3"><i class="fas fa-list-alt me-2 text-muted"></i>All Current Settings</h6>
                        <table class="table table-sm table-hover align-middle">
                            <thead><tr><th>Setting Key</th><th>Current Value</th></tr></thead>
                            <tbody id="allSettingsBody">
                                <tr><td colspan="2" class="text-muted text-center py-3">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div><!-- /tab-general -->

                <!-- API Keys tab moved to Backoffice -->



                <!-- ══════════════════ EMAIL TAB ══════════════════ -->
                <div id="tab-email" class="d-none">

                    <!-- Status header card -->
                    <div class="glass-card p-4 mb-4" style="background:linear-gradient(135deg,rgba(99,102,241,.06) 0%,rgba(139,92,246,.03) 100%);border-left:4px solid #6366f1;">
                        <div class="d-flex align-items-start gap-3">
                            <div class="setting-icon" style="background:rgba(99,102,241,.12);color:#6366f1;width:52px;height:52px;border-radius:14px;font-size:1.3rem;">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1 fw-bold">Email / SMTP Configuration</h6>
                                <p class="text-muted small mb-0">
                                    Configure outgoing email so the system can send reports directly from the Reports page.
                                    Settings are stored in the database &mdash; no need to edit <code>.env</code> files.
                                </p>
                            </div>
                            <div class="ms-auto text-end">
                                <div class="text-muted small mb-1">Status</div>
                                <div id="emailStatusBadge" class="badge bg-secondary">Loading...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Provider quick-fill buttons -->
                    <div class="glass-card p-4 mb-4">
                        <h6 class="fw-bold mb-2"><i class="fas fa-bolt me-2 text-warning"></i>Quick Setup &mdash; Choose Your Email Provider</h6>
                        <p class="text-muted small mb-3">Click a provider to auto-fill the server settings. You still need to enter your email address and password.</p>
                        <div class="d-flex gap-2 flex-wrap" id="providerBtns">
                            <button class="btn btn-sm btn-outline-secondary provider-btn" data-host="smtp.gmail.com" data-port="587" data-name="Gmail">
                                <i class="fab fa-google me-1"></i>Gmail
                            </button>
                            <button class="btn btn-sm btn-outline-secondary provider-btn" data-host="smtp-mail.outlook.com" data-port="587" data-name="Outlook / Hotmail">
                                <i class="fab fa-microsoft me-1"></i>Outlook / Hotmail
                            </button>
                            <button class="btn btn-sm btn-outline-secondary provider-btn" data-host="smtp.office365.com" data-port="587" data-name="Office 365">
                                <i class="fas fa-building me-1"></i>Office 365
                            </button>
                            <button class="btn btn-sm btn-outline-secondary provider-btn" data-host="smtp.yahoo.com" data-port="465" data-name="Yahoo Mail">
                                <i class="fab fa-yahoo me-1"></i>Yahoo Mail
                            </button>
                            <button class="btn btn-sm btn-outline-secondary provider-btn" data-host="email-smtp.us-east-1.amazonaws.com" data-port="587" data-name="Amazon SES">
                                <i class="fab fa-aws me-1"></i>Amazon SES
                            </button>
                            <button class="btn btn-sm btn-outline-secondary provider-btn" data-host="smtp.sendgrid.net" data-port="587" data-name="SendGrid">
                                <i class="fas fa-paper-plane me-1"></i>SendGrid
                            </button>
                        </div>
                    </div>

                    <!-- Config form -->
                    <div class="glass-card p-4 mb-4 setting-card" style="border-left-color:#6366f1;">
                        <h6 class="fw-bold mb-3"><i class="fas fa-server me-2 text-muted"></i>SMTP Server Settings</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">SMTP Host</label>
                                <input type="text" class="form-control form-control-sm" id="smtpHost" placeholder="smtp.gmail.com">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-semibold small">Port</label>
                                <input type="number" class="form-control form-control-sm" id="smtpPort" placeholder="587" min="1" max="65535">
                                <div class="form-text">587 = TLS, 465 = SSL</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Sender Display Name</label>
                                <input type="text" class="form-control form-control-sm" id="smtpFromName" placeholder="Patient RX System">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Email Address (Username)</label>
                                <input type="email" class="form-control form-control-sm" id="smtpUser" placeholder="youremail@gmail.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">
                                    Password / App Password
                                    <span class="text-muted" style="font-weight:400;font-size:.72rem" id="smtpPassHint">&nbsp;</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <input type="password" class="form-control form-control-sm" id="smtpPass" placeholder="Leave blank to keep current password">
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassBtn" title="Show/hide password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <div class="form-text">Leave blank to keep the currently saved password.</div>
                            </div>
                        </div>

                        <!-- Gmail App Password guide -->
                        <div id="gmailGuide" class="mt-3 p-3 rounded-3 d-none" style="background:rgba(234,179,8,.06);border:1px solid rgba(234,179,8,.25);">
                            <div class="fw-semibold small mb-2"><i class="fab fa-google me-1 text-warning"></i>Gmail requires an App Password (not your regular password)</div>
                            <ol class="text-muted small mb-0 ps-3">
                                <li>Go to <a href="https://myaccount.google.com/security" target="_blank" rel="noopener">myaccount.google.com/security</a></li>
                                <li>Enable <strong>2-Step Verification</strong> if not already on</li>
                                <li>Search <strong>"App Passwords"</strong> in the search bar</li>
                                <li>Create one for <strong>Mail</strong> &mdash; copy the 16-character code</li>
                                <li>Paste that code in the Password field above (spaces are OK)</li>
                            </ol>
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
                            <button class="btn btn-primary btn-sm" id="saveSmtpBtn">
                                <i class="fas fa-save me-1"></i>Save Settings
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" id="testSmtpSettingsBtn">
                                <i class="fas fa-plug me-1"></i>Test Connection
                            </button>
                            <div class="save-indicator" id="smtpSaveOk">
                                <i class="fas fa-check-circle"></i> Saved!
                            </div>
                        </div>

                        <!-- Test result inline -->
                        <div id="smtpTestInlineResult" class="alert d-none mt-3 mb-0" role="alert"></div>
                    </div>

                    <!-- Send a test email -->
                    <div class="glass-card p-4 mb-4 setting-card" style="border-left-color:#22c55e;">
                        <div class="d-flex align-items-start gap-3">
                            <div class="setting-icon" style="background:rgba(34,197,94,.12);color:#22c55e;">
                                <i class="fas fa-vial"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1 fw-bold">Send a Test Email</h6>
                                <p class="text-muted small mb-2">Verify everything works end-to-end by sending a test message to any address.</p>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-5">
                                        <input type="email" class="form-control form-control-sm" id="testEmailTo" placeholder="test@example.com">
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-success btn-sm" id="sendTestEmailBtn">
                                            <i class="fas fa-paper-plane me-1"></i>Send Test
                                        </button>
                                    </div>
                                </div>
                                <div id="testEmailResult" class="alert d-none mt-2 mb-0 py-2 small" role="alert"></div>
                            </div>
                        </div>
                    </div>

                </div><!-- /tab-email -->


                <!-- ══════════════════ MANUAL TAB ══════════════════ -->
                <div id="tab-manual" class="d-none">

