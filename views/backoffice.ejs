      <div style="font-weight:700;font-size:.85rem;color:#f59e0b;margin-bottom:.3rem">API Key Authentication — Not Currently Active</div>
      <div style="font-size:.78rem;color:var(--text-muted);line-height:1.6">
        Keys can be <strong>generated and managed</strong> here, but the <code>X-API-Key</code> header is <strong>not yet wired into the authentication middleware</strong>.
        External requests using an API key will be rejected by JWT auth — they do not bypass it.
        <br><br>
        This is a planned feature. Until it is enabled, API keys are <strong>not usable for integrations</strong>.
        Do not share or use generated keys in production integrations at this time.
      </div>
    </div>
  </div>

  <!-- Generate form -->
  <div class="schema-card" id="boGenerateFormCard" style="display:none;border:1.5px dashed rgba(245,158,11,.4);margin-bottom:1rem">
    <div style="font-weight:700;font-size:.9rem;margin-bottom:1rem;color:#f59e0b"><i class="fas fa-plus me-2"></i>Generate New API Key</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.75rem;margin-bottom:1rem">
      <div>
        <label style="font-size:.75rem;font-weight:600;display:block;margin-bottom:.3rem">Key Name / Label <span style="color:#ef4444">*</span></label>
        <input type="text" id="boKeyName" class="form-control form-control-sm" placeholder="e.g. Integration System">
      </div>
      <div>
        <label style="font-size:.75rem;font-weight:600;display:block;margin-bottom:.3rem">Description (optional)</label>
        <input type="text" id="boKeyDescription" class="form-control form-control-sm" placeholder="What will this key be used for?">
      </div>
      <div>
        <label style="font-size:.75rem;font-weight:600;display:block;margin-bottom:.3rem">Expires In</label>
        <select id="boKeyExpiry" class="form-select form-select-sm">
          <option value="never">Never expires</option>
          <option value="30d">30 days</option>
          <option value="90d">90 days</option>
          <option value="180d">180 days</option>
          <option value="1y">1 year</option>
        </select>
      </div>
    </div>
    <div style="display:flex;gap:.5rem">
      <button class="btn-bo btn-bo-primary" onclick="boGenerateKey()"><i class="fas fa-key me-1"></i>Generate Key</button>
      <button class="btn-bo btn-bo-outline" onclick="boCancelGenerateForm()">Cancel</button>
    </div>
  </div>

  <!-- New key reveal banner -->
  <div id="boNewKeyBanner" style="display:none;border:1.5px solid #22c55e;border-radius:12px;background:rgba(34,197,94,.05);padding:1rem;margin-bottom:1rem">
    <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem">
      <i class="fas fa-check-circle" style="color:#22c55e"></i>
      <strong>API Key Generated Successfully!</strong>
      <span class="badge bg-danger ms-auto">Copy now &mdash; will not be shown again</span>
    </div>
    <div id="boNewKeyValue" style="font-family:monospace;font-size:.85rem;background:#0d1117;color:#58a6ff;border-radius:8px;padding:12px 16px;word-break:break-all;margin-bottom:.5rem">rxk_...</div>
    <div style="display:flex;align-items:center;gap:.5rem">
      <button class="btn-bo btn-bo-outline" onclick="boCopyNewKey()"><i class="fas fa-copy me-1"></i>Copy Key</button>
      <span style="font-size:.75rem;color:var(--text-muted)">Store this key securely. It cannot be retrieved again.</span>
    </div>
  </div>

  <!-- How to use + API Reference -->
  <div class="schema-card" style="margin-bottom:1rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;flex-wrap:wrap;gap:.5rem">
      <div style="font-weight:700;font-size:.85rem"><i class="fas fa-code me-2" style="color:var(--text-muted)"></i>How to Use API Keys</div>
      <button class="btn-bo btn-bo-outline" onclick="boToggleApiRef()" style="font-size:.75rem"><i class="fas fa-book me-1"></i>Show API Reference</button>
    </div>
    <p style="font-size:.78rem;color:var(--text-muted);margin-bottom:.75rem">Include the key in the <code>X-API-Key</code> HTTP header. All endpoints are prefixed with <code>/api</code>.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-bottom:.75rem">
      <div style="font-family:monospace;font-size:.76rem;background:#0d1117;color:#8b949e;border-radius:8px;padding:10px 14px">
        <span style="color:#8b949e"># HTTP Header</span><br>
        <span style="color:#58a6ff">GET</span> <span style="color:#a5d6ff">http://yourserver/api/patients</span><br>
        <span style="color:#58a6ff">X-API-Key:</span> <span style="color:#a5d6ff">rxk_your_key_here</span>
      </div>
      <div style="font-family:monospace;font-size:.76rem;background:#0d1117;color:#8b949e;border-radius:8px;padding:10px 14px">
        <span style="color:#8b949e"># curl example</span><br>
        curl \<br>
        &nbsp;&nbsp;-H <span style="color:#a5d6ff">"X-API-Key: rxk_your_key"</span> \<br>
        &nbsp;&nbsp;http://yourserver/api/patients
      </div>
    </div>
    <!-- API Reference panel (collapsed) -->
    <div id="boApiRefPanel" style="display:none;margin-top:.75rem">
      <hr style="margin:.75rem 0;opacity:.15">
      <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;flex-wrap:wrap">
        <span style="font-weight:700;font-size:.82rem"><i class="fas fa-book-open me-2" style="color:#6366f1"></i>Complete API Reference</span>
        <span style="font-size:.7rem;color:var(--text-muted)">Base URL: <code>http://localhost:3000/api</code></span>
        <span id="boApiRoutesTotal" style="font-size:.7rem;background:rgba(99,102,241,.12);color:#6366f1;border-radius:20px;padding:2px 10px;font-weight:600">Loading...</span>
        <button class="btn-bo btn-bo-outline" onclick="boRefreshApiRoutes()" style="margin-left:auto;font-size:.7rem;padding:2px 8px"><i class="fas fa-sync me-1"></i>Refresh</button>
      </div>
      <div id="boApiFilterPills" style="display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.75rem"></div>
      <div id="boApiEndpointsList"></div>
    </div>
  </div>

  <!-- All API Keys table -->
  <div class="schema-card">
    <div style="font-weight:700;font-size:.85rem;margin-bottom:1rem"><i class="fas fa-list me-2" style="color:var(--text-muted)"></i>All API Keys</div>
    <div style="overflow-x:auto">
      <table class="bo-table" style="width:100%">
        <thead>
          <tr>
            <th>Name / Label</th><th>Key Prefix</th><th>Status</th>
            <th>Created By</th><th>Created</th><th>Last Used</th><th>Expires</th>
            <th style="text-align:right">Actions</th>
          </tr>
        </thead>
        <tbody id="boApiKeysBody">
          <tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div><!-- /apiKeysContent -->

<!-- Revoke API Key Confirm Modal -->
<div class="bo-modal-backdrop" id="revokeKeyBackdrop" style="display:none" onclick="if(event.target===this)closeRevokeModal()">
  <div class="bo-modal" style="max-width:440px">
    <div class="bo-modal-header">
      <i class="fas fa-exclamation-triangle" style="color:#ef4444;font-size:1.1rem"></i>
      <h5>Revoke API Key</h5>
      <button class="btn-bo btn-bo-outline" style="margin-left:auto;padding:4px 10px" onclick="closeRevokeModal()"><i class="fas fa-times"></i></button>
    </div>
    <div class="bo-modal-body">
      <p style="margin-bottom:.75rem">Permanently revoke <strong id="revokeKeyName"></strong>?</p>
      <div style="background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);border-radius:8px;padding:.75rem;font-size:.8rem;color:#fca5a5">
        <i class="fas fa-ban me-1"></i>This action is <strong>irreversible</strong>. Any system using this key will immediately lose access.
      </div>
    </div>
    <div class="bo-modal-footer">
      <button class="btn-bo btn-bo-outline" onclick="closeRevokeModal()">Cancel</button>
      <button class="btn-bo btn-bo-danger" id="confirmRevokeBtn" onclick="boExecuteRevoke()"><i class="fas fa-trash me-1"></i>Revoke Key</button>
    </div>
  </div>
</div>
<!-- ================== END API KEYS PANEL ================== -->

    <div id="analyticsContent" class="schema-wrap">
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
            <div>
                <div style="font-size:1rem;font-weight:700">📊 Daily Analytics</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">Automated daily snapshots &mdash; captured every night at 00:05</div>
            </div>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                <input type="date" id="anlFrom" class="schema-search" style="margin:0" onchange="loadAnalytics()">
                <input type="date" id="anlTo"   class="schema-search" style="margin:0" onchange="loadAnalytics()">
                <button class="btn-bo btn-bo-outline" onclick="loadAnalytics()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                <button class="btn-bo" style="background:rgba(16,185,129,.12);color:#10b981;border:1px solid rgba(16,185,129,.3);font-size:0.78rem" onclick="captureNowSnapshot()"><i class="fas fa-camera me-1"></i>Capture Now</button>
                <button class="btn-bo btn-bo-outline" style="font-size:0.78rem" onclick="exportAnalyticsCSV()"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
            </div>
        </div>

        <!-- BO-06: Sparkline trend card -->
        <div class="schema-card" id="anlSparkCard" style="padding:1rem;margin-bottom:1rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem">
            <div>
                <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:0.5rem">
                    <i class="fas fa-users me-1" style="color:#10b981"></i>PATIENT TREND (30d)
                </div>
                <canvas id="sparkPatients" height="60"></canvas>
                <div id="sparkPatientsDelta" style="font-size:0.7rem;margin-top:0.3rem;color:var(--text-muted)"></div>
            </div>
            <div>
                <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:0.5rem">
                    <i class="fas fa-prescription-bottle-alt me-1" style="color:#f59e0b"></i>RX TREND (30d)
                </div>
                <canvas id="sparkRX" height="60"></canvas>
                <div id="sparkRXDelta" style="font-size:0.7rem;margin-top:0.3rem;color:var(--text-muted)"></div>
            </div>
        </div>

        <!-- KPI Cards (latest snapshot) -->
        <div id="anlKpiCards" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:0.65rem;margin-bottom:1.5rem"></div>

        <!-- Charts 2×2 grid -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem" id="anlChartGrid">
            <!-- Chart 1: Patients -->
            <div class="schema-card" style="padding:1rem">
                <div style="font-size:0.78rem;font-weight:600;margin-bottom:0.75rem;color:var(--text-muted)"><i class="fas fa-user-injured me-1" style="color:#6366f1"></i>PATIENTS OVER TIME</div>
                <canvas id="chartPatients" height="180"></canvas>
            </div>
            <!-- Chart 2: RX Activity -->
            <div class="schema-card" style="padding:1rem">
                <div style="font-size:0.78rem;font-weight:600;margin-bottom:0.75rem;color:var(--text-muted)"><i class="fas fa-prescription-bottle-alt me-1" style="color:#f59e0b"></i>RX RECORDS ACTIVITY</div>
                <canvas id="chartRX" height="180"></canvas>
            </div>
            <!-- Chart 3: Workflow -->
            <div class="schema-card" style="padding:1rem">
                <div style="font-size:0.78rem;font-weight:600;margin-bottom:0.75rem;color:var(--text-muted)"><i class="fas fa-tasks me-1" style="color:#10b981"></i>WORKFLOW COMPLETION RATE %</div>
                <canvas id="chartWorkflow" height="180"></canvas>
            </div>
            <!-- Chart 4: Errors & Audit -->
            <div class="schema-card" style="padding:1rem">
                <div style="font-size:0.78rem;font-weight:600;margin-bottom:0.75rem;color:var(--text-muted)"><i class="fas fa-exclamation-triangle me-1" style="color:#ef4444"></i>ERRORS & AUDIT EVENTS / DAY</div>
                <canvas id="chartActivity" height="180"></canvas>
            </div>
        </div>

        <!-- Raw data table -->
        <div style="font-size:0.75rem;font-weight:600;color:var(--text-muted);margin-bottom:0.5rem;text-transform:uppercase;letter-spacing:.06em">Snapshot Records</div>
        <div id="anlTableWrap"><p style="text-align:center;padding:3rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</p></div>
    </div>


</div><!-- /mainWrap -->

