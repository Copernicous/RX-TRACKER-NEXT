<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>document.documentElement.setAttribute('data-theme','dark');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Back Office &mdash; Data Control Center</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <script src="/assets/chart.umd.min.js"></script>
    <style>
        :root {
            --bg: #0a0f1e;
            --surface: #111827;
            --surface-2: #1a2235;
            --surface-3: #212d42;
            --border: rgba(255,255,255,0.07);
            --text: #e2e8f0;
            --text-muted: #64748b;
            --red: #ef4444;
            --radius: 14px;
            --radius-sm: 8px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }

        /* ── Header ── */
        .bo-header {
            background: linear-gradient(135deg, #0d1117 0%, #1a0a0a 50%, #0d1117 100%);
            border-bottom: 1px solid rgba(239,68,68,0.25);
            padding: 1.25rem 2rem;
            display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 200;
            backdrop-filter: blur(20px);
        }
        .bo-brand { display: flex; align-items: center; gap: 0.875rem; }
        .bo-brand-icon {
            width: 40px; height: 40px; border-radius: 10px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; box-shadow: 0 0 18px rgba(239,68,68,0.4);
        }
        .bo-brand h1 { font-size: 1.1rem; font-weight: 700; margin: 0; }
        .bo-brand small { font-size: 0.68rem; color: var(--red); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-top: 1px; }
        .badge-admin { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; padding: 0.28rem 0.7rem; border-radius: 20px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
        .btn-bo { border: none; border-radius: var(--radius-sm); padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; }
        .btn-bo-outline { background: transparent; border: 1px solid var(--border); color: var(--text-muted); }
        .btn-bo-outline:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }
        .btn-bo-danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; box-shadow: 0 0 14px rgba(239,68,68,0.3); }
        .btn-bo-danger:hover { box-shadow: 0 0 22px rgba(239,68,68,0.5); transform: translateY(-1px); }
        .btn-bo-danger:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }
        .btn-bo-success { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
        .btn-bo-success:hover { filter: brightness(1.1); transform: translateY(-1px); }
        .btn-bo-primary { background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; }
        .btn-bo-primary:hover { filter: brightness(1.1); transform: translateY(-1px); }

        /* ── Warning Banner ── */
        .warning-banner { background: linear-gradient(135deg, rgba(239,68,68,0.1), rgba(220,38,38,0.05)); border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius); padding: 0.875rem 1.125rem; display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1.75rem; }
        .warning-banner i { color: var(--red); font-size: 1.1rem; margin-top: 0.1rem; flex-shrink: 0; }
        .warning-banner p { margin: 0; font-size: 0.82rem; color: #fca5a5; line-height: 1.5; }

        /* ── Stats ── */
        .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.65rem; margin-bottom: 1.75rem; }
        .stat-pill { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.7rem 1rem; text-align: center; }
        .stat-pill .num { font-size: 1.5rem; font-weight: 800; line-height: 1; margin-bottom: 0.15rem; }
        .stat-pill .lbl { font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }

        /* ── Section Title ── */
        .section-title { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }

        /* ── Table Cards ── */
        .tables-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 0.75rem; margin-bottom: 2rem; }
        .table-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; position: relative; overflow: hidden; transition: all 0.2s; }
        .table-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, var(--card-color, #6366f1), transparent); opacity: 0; transition: opacity 0.2s; }
        .table-card:hover { border-color: rgba(255,255,255,0.1); transform: translateY(-1px); }
        .table-card.selected { border-color: var(--card-color, #6366f1) !important; background: var(--surface-2); }
        .table-card.selected::before { opacity: 1; }

        .tc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.5rem; }
        .tc-left { display: flex; align-items: center; gap: 0.55rem; }
        .table-icon { width: 32px; height: 32px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
        .table-name { font-size: 0.85rem; font-weight: 600; }
        .table-desc { font-size: 0.7rem; color: var(--text-muted); line-height: 1.4; margin-bottom: 0.625rem; }
        .tc-count { font-size: 1.4rem; font-weight: 800; line-height: 1; }
        .tc-count span { font-size: 0.62rem; font-weight: 400; color: var(--text-muted); margin-left: 0.2rem; }
        .count-zero { color: var(--text-muted) !important; }

        .check-dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center; transition: all 0.2s; flex-shrink: 0; cursor: pointer; }
        .table-card.selected .check-dot { background: var(--card-color, #6366f1); border-color: var(--card-color, #6366f1); }
        .check-dot i { font-size: 0.6rem; opacity: 0; transition: opacity 0.2s; }
        .table-card.selected .check-dot i { opacity: 1; }

        /* ── Card action buttons ── */
        .tc-actions { display: flex; gap: 0.4rem; margin-top: 0.625rem; }
        .tc-btn { flex: 1; border: none; border-radius: 6px; padding: 0.4rem 0.6rem; font-size: 0.72rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 0.3rem; }
        .tc-btn-view { background: rgba(99,102,241,0.12); border: 1px solid rgba(99,102,241,0.25); color: #a5b4fc; }
        .tc-btn-view:hover { background: rgba(99,102,241,0.22); border-color: rgba(99,102,241,0.5); color: #c7d2fe; }
        .tc-btn-export { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.22); color: #6ee7b7; }
        .tc-btn-export:hover { background: rgba(16,185,129,0.2); border-color: rgba(16,185,129,0.45); color: #a7f3d0; }
        .tc-btn-select { background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: var(--text-muted); }
        .tc-btn-select:hover { color: var(--text); border-color: rgba(255,255,255,0.15); }
        .table-card.selected .tc-btn-select { background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.25); color: #fca5a5; }

        .dep-badge { font-size: 0.6rem; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.18); color: #fca5a5; border-radius: 4px; padding: 0.08rem 0.3rem; margin-top: 0.2rem; display: inline-block; }

        /* ── Action Bar ── */
        .action-bar { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; position: sticky; bottom: 1.25rem; box-shadow: 0 4px 40px rgba(0,0,0,0.5); }
        .selected-count { font-size: 0.82rem; color: var(--text-muted); }
        .selected-count strong { color: var(--text); }

        /* ── Data Viewer Overlay ── */
        .viewer-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.88); backdrop-filter: blur(8px);
            z-index: 9000; display: none; flex-direction: column;
        }
        .viewer-overlay.show { display: flex; }
        .viewer-header {
            background: var(--surface); border-bottom: 1px solid var(--border);
            padding: 0.875rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-shrink: 0;
        }
        .viewer-title { display: flex; align-items: center; gap: 0.75rem; }
        .viewer-title h5 { margin: 0; font-size: 1rem; font-weight: 700; }
        .viewer-title .v-badge { font-size: 0.7rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; padding: 0.2rem 0.55rem; color: var(--text-muted); }
        .viewer-actions { display: flex; align-items: center; gap: 0.5rem; }

        /* Search + filter bar */
        .viewer-toolbar {
            background: var(--surface-2); border-bottom: 1px solid var(--border);
            padding: 0.625rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; flex-wrap: wrap;
        }
        .viewer-search {
            flex: 1; min-width: 200px; max-width: 360px;
            background: var(--surface-3); border: 1px solid var(--border); border-radius: 8px;
            color: var(--text); padding: 0.4rem 0.75rem; font-size: 0.82rem; outline: none;
        }
        .viewer-search:focus { border-color: rgba(99,102,241,0.4); }
        .viewer-search::placeholder { color: var(--text-muted); }
        .viewer-info { font-size: 0.75rem; color: var(--text-muted); margin-left: auto; }

        /* Column toggles */
        .col-toggle-wrap { position: relative; }
        .col-toggle-btn { background: var(--surface-3); border: 1px solid var(--border); border-radius: 8px; color: var(--text-muted); padding: 0.38rem 0.75rem; font-size: 0.78rem; cursor: pointer; transition: all 0.2s; }
        .col-toggle-btn:hover { color: var(--text); border-color: rgba(255,255,255,0.15); }
        .col-dropdown { position: absolute; top: calc(100% + 6px); right: 0; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.5rem; min-width: 200px; max-height: 280px; overflow-y: auto; z-index: 100; display: none; box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
        .col-dropdown.open { display: block; }
        .col-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.5rem; border-radius: 5px; cursor: pointer; font-size: 0.78rem; transition: background 0.15s; }
        .col-item:hover { background: rgba(255,255,255,0.04); }
        .col-item input[type=checkbox] { accent-color: #6366f1; width: 14px; height: 14px; flex-shrink: 0; }

        /* Data table */
        .viewer-body { flex: 1; overflow: auto; padding: 0; }
        .data-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; white-space: nowrap; }
        .data-table thead th {
            position: sticky; top: 0; background: var(--surface-2);
            border-bottom: 1px solid var(--border); padding: 0.55rem 0.875rem;
            font-weight: 600; text-align: left; color: var(--text-muted);
            cursor: pointer; user-select: none; transition: color 0.15s;
        }
        .data-table thead th:hover { color: var(--text); }
        .data-table thead th .sort-icon { margin-left: 4px; font-size: 0.65rem; opacity: 0.4; }
        .data-table thead th.sorted .sort-icon { opacity: 1; color: #6366f1; }
        .data-table tbody tr { border-bottom: 1px solid var(--border); transition: background 0.1s; }
        .data-table tbody tr:hover { background: rgba(255,255,255,0.025); }
        .data-table tbody td { padding: 0.45rem 0.875rem; color: var(--text); max-width: 260px; overflow: hidden; text-overflow: ellipsis; }
        .data-table tbody td.null-cell { color: var(--text-muted); font-style: italic; }
        .data-table tbody td.bool-true  { color: #6ee7b7; }
        .data-table tbody td.bool-false { color: #fca5a5; }
        .no-rows { text-align: center; padding: 3rem; color: var(--text-muted); font-size: 0.875rem; }

        /* Pagination */
        .viewer-footer { background: var(--surface); border-top: 1px solid var(--border); padding: 0.625rem 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
        .pag-info { font-size: 0.75rem; color: var(--text-muted); }
        .pag-controls { display: flex; align-items: center; gap: 0.4rem; }
        .pag-btn { background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; color: var(--text-muted); padding: 0.3rem 0.65rem; font-size: 0.75rem; cursor: pointer; transition: all 0.15s; }
        .pag-btn:hover:not(:disabled) { color: var(--text); border-color: rgba(255,255,255,0.2); }
        .pag-btn:disabled { opacity: 0.35; cursor: not-allowed; }
        .pag-btn.active { background: rgba(99,102,241,0.2); border-color: rgba(99,102,241,0.4); color: #a5b4fc; }
        .pag-size { background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; color: var(--text-muted); padding: 0.28rem 0.5rem; font-size: 0.75rem; cursor: pointer; }

        /* ── Confirm Purge Modal ── */
        .bo-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.82); backdrop-filter: blur(6px); z-index: 9500; display: none; align-items: center; justify-content: center; }
        .bo-modal-backdrop.show { display: flex; }
        .bo-modal { background: var(--surface); border: 1px solid rgba(239,68,68,0.3); border-radius: 20px; width: 100%; max-width: 520px; margin: 1rem; overflow: hidden; animation: modalIn 0.2s ease; }
        @keyframes modalIn { from { transform: translateY(16px) scale(0.97); opacity: 0; } to { transform: none; opacity: 1; } }
        .bo-modal-header { background: linear-gradient(135deg, #1a0a0a, #2d0f0f); border-bottom: 1px solid rgba(239,68,68,0.2); padding: 1.125rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; }
        .bo-modal-header h5 { margin: 0; font-size: 0.95rem; font-weight: 700; color: #fca5a5; }
        .bo-modal-body { padding: 1.375rem; }
        .bo-modal-footer { padding: 0.875rem 1.375rem; border-top: 1px solid var(--border); display: flex; gap: 0.625rem; justify-content: flex-end; }
        .delete-summary { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.75rem; margin-bottom: 1rem; max-height: 180px; overflow-y: auto; }
        .del-item { display: flex; align-items: center; justify-content: space-between; padding: 0.28rem 0; font-size: 0.8rem; border-bottom: 1px solid var(--border); }
        .del-item:last-child { border-bottom: none; }
        .del-item .name { color: var(--text); font-weight: 500; }
        .del-item .cnt { color: var(--red); font-weight: 700; }
        .confirm-input-wrap { margin-top: 0.875rem; }
        .confirm-input-wrap label { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.35rem; display: block; }
        .confirm-input-wrap label code { color: #fca5a5; background: rgba(239,68,68,0.1); padding: 0.1rem 0.35rem; border-radius: 4px; }
        .confirm-input { width: 100%; background: var(--surface-3); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); padding: 0.6rem 0.8rem; font-size: 0.875rem; outline: none; transition: border-color 0.2s; }
        .confirm-input:focus { border-color: rgba(239,68,68,0.4); }
        .confirm-input.valid { border-color: rgba(239,68,68,0.65); background: rgba(239,68,68,0.05); }

        /* ── Toast ── */
        .bo-toast-wrap { position: fixed; top: 1.25rem; right: 1.25rem; z-index: 9999; display: flex; flex-direction: column; gap: 0.4rem; }
        .bo-toast { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.65rem 1.1rem; font-size: 0.8rem; font-weight: 500; min-width: 240px; box-shadow: 0 4px 20px rgba(0,0,0,0.4); animation: toastIn 0.2s ease; display: flex; align-items: center; gap: 0.45rem; }
        @keyframes toastIn { from { transform: translateX(28px); opacity: 0; } to { transform: none; opacity: 1; } }
        .bo-toast.success { border-color: rgba(16,185,129,0.4); color: #6ee7b7; }
        .bo-toast.danger  { border-color: rgba(239,68,68,0.4);  color: #fca5a5; }
        .bo-toast.info    { border-color: rgba(99,102,241,0.4); color: #a5b4fc; }

        /* ── Denied / misc ── */
        .denied-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; text-align: center; gap: 1rem; }
        .main-wrap { max-width: 1200px; margin: 0 auto; padding: 1.75rem 1.5rem 6rem; }
        .spinner-sm { width: 13px; height: 13px; border: 2px solid rgba(255,255,255,0.25); border-top-color: #fff; border-radius: 50%; animation: spin 0.65s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Tab Nav ── */
        .tab-nav { display:flex; gap:0.25rem; margin-bottom:1.5rem; background:var(--surface-2); border:1px solid var(--border); border-radius:10px; padding:0.3rem; }
        .tab-btn { flex:1; border:none; border-radius:7px; padding:0.55rem 1rem; font-size:0.8rem; font-weight:600; cursor:pointer; transition:all 0.2s; color:var(--text-muted); background:transparent; }
        .tab-btn.active { background:var(--surface); color:var(--text); box-shadow:0 1px 8px rgba(0,0,0,0.3); }
        .tab-btn i { margin-right:0.4rem; }

        /* ── Schema Panel ── */
        .schema-wrap { display:none; }
        .schema-wrap.show { display:block; }
        .schema-layout { display:grid; grid-template-columns:260px 1fr; gap:1rem; align-items:start; min-height:500px; }
        .schema-sidebar { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; position:sticky; top:80px; }
        .schema-sidebar-header { padding:0.75rem 1rem; border-bottom:1px solid var(--border); font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); display:flex; align-items:center; justify-content:space-between; }
        .schema-tbl-item { padding:0.5rem 1rem; font-size:0.82rem; cursor:pointer; transition:background 0.15s; display:flex; align-items:center; gap:0.5rem; border-left:2px solid transparent; }
        .schema-tbl-item:hover { background:rgba(255,255,255,0.03); }
        .schema-tbl-item.active { background:rgba(99,102,241,0.08); border-left-color:#6366f1; color:#a5b4fc; }
        .schema-tbl-item .tbl-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
        .schema-tbl-item .fk-count { margin-left:auto; font-size:0.68rem; color:var(--text-muted); }

        .schema-main { display:flex; flex-direction:column; gap:1rem; }
        .schema-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; }
        .schema-card-header { padding:0.875rem 1.125rem; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:0.75rem; }
        .schema-card-header h6 { margin:0; font-size:0.95rem; font-weight:700; }
        .schema-card-header small { font-size:0.7rem; color:var(--text-muted); margin-left:auto; }
        .schema-col-table { width:100%; border-collapse:collapse; font-size:0.78rem; }
        .schema-col-table th { padding:0.4rem 1rem; font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--text-muted); border-bottom:1px solid var(--border); text-align:left; background:var(--surface-2); }
        .schema-col-table td { padding:0.42rem 1rem; border-bottom:1px solid rgba(255,255,255,0.035); vertical-align:middle; }
        .schema-col-table tr:last-child td { border-bottom:none; }
        .schema-col-table tr:hover td { background:rgba(255,255,255,0.02); }
        .col-name { font-family:monospace; font-size:0.82rem; color:var(--text); }
        .col-type { font-size:0.72rem; color:var(--text-muted); font-family:monospace; }
        .badge-pk  { font-size:0.6rem; background:rgba(251,191,36,0.15); border:1px solid rgba(251,191,36,0.3); color:#fbbf24; border-radius:4px; padding:0.1rem 0.4rem; margin-right:0.3rem; font-weight:700; }
        .badge-fk  { font-size:0.6rem; background:rgba(99,102,241,0.15); border:1px solid rgba(99,102,241,0.3); color:#a5b4fc; border-radius:4px; padding:0.1rem 0.4rem; font-weight:700; }
        .badge-nn  { font-size:0.6rem; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.2); color:#fca5a5; border-radius:4px; padding:0.1rem 0.35rem; font-weight:600; }
        .fk-ref  { font-size:0.72rem; color:#a5b4fc; display:flex; align-items:center; gap:0.3rem; }
        .fk-ref i { font-size:0.65rem; }
        .fk-ref .fk-target { cursor:pointer; text-decoration:underline; text-underline-offset:2px; }
        .fk-ref .fk-target:hover { color:#c7d2fe; }

        /* Referenced-by panel */
        .ref-by-section { padding:0.75rem 1rem; border-top:1px solid var(--border); background:var(--surface-2); }
        .ref-by-title { font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--text-muted); margin-bottom:0.5rem; }
        .ref-by-chips { display:flex; flex-wrap:wrap; gap:0.35rem; }
        .ref-chip { font-size:0.72rem; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.2); color:#6ee7b7; border-radius:6px; padding:0.2rem 0.6rem; cursor:pointer; transition:all 0.15s; display:flex; align-items:center; gap:0.3rem; }
        .ref-chip:hover { background:rgba(16,185,129,0.2); border-color:rgba(16,185,129,0.4); }

        /* FK relationship list */
        .fk-list-section { padding:0; }
        .fk-list-title { padding:0.625rem 1.125rem; font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--text-muted); border-bottom:1px solid var(--border); }
        .fk-row { display:grid; grid-template-columns:1fr 40px 1fr; align-items:center; padding:0.5rem 1.125rem; border-bottom:1px solid rgba(255,255,255,0.04); font-size:0.78rem; gap:0.5rem; }
        .fk-row:last-child { border-bottom:none; }
        .fk-row:hover { background:rgba(255,255,255,0.02); }
        .fk-from { color:var(--text); } .fk-to { color:#a5b4fc; }
        .fk-arrow { text-align:center; color:var(--text-muted); font-size:0.8rem; }
        .schema-search { width:100%; background:var(--surface-3); border:1px solid var(--border); border-radius:8px; color:var(--text); padding:0.45rem 0.75rem; font-size:0.8rem; outline:none; margin-bottom:1rem; }
        .schema-search:focus { border-color:rgba(99,102,241,0.4); }
        .schema-search::placeholder { color:var(--text-muted); }
    </style>
</head>
<body>

<!-- ── Header ── -->
<header class="bo-header">
    <div class="bo-brand">
        <div class="bo-brand-icon"><i class="fas fa-skull-crossbones"></i></div>
        <div>
            <h1>Data Control Center</h1>
            <small>&#9888; Back Office &mdash; Administrator Only</small>
        </div>
    </div>
    <div style="display:flex;align-items:center;gap:0.75rem">
        <span class="badge-admin" id="userBadge">Loading...</span>
        <button class="btn-bo btn-bo-outline" onclick="loadStats()" id="refreshBtn"><i class="fas fa-sync-alt"></i></button>
        <a href="/dashboard" class="btn-bo btn-bo-outline"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>
</header>

<!-- ── Main ── -->
<div class="main-wrap" id="mainWrap" style="display:none">
    <div class="warning-banner">
        <i class="fas fa-exclamation-triangle"></i>
        <p><strong>Danger Zone.</strong> Deletions are <strong>permanent and irreversible</strong>. Use <strong>View</strong> to inspect data and <strong>Export CSV</strong> to back up before purging.</p>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-nav">
        <button class="tab-btn active" id="tabTables" onclick="switchTab('tables')"><i class="fas fa-table"></i>Tables &amp; Data</button>
        <button class="tab-btn" id="tabSchema" onclick="switchTab('schema')"><i class="fas fa-project-diagram"></i>Schema</button>
        <button class="tab-btn" id="tabOrphans" onclick="switchTab('orphans')"><i class="fas fa-unlink"></i>Orphans</button>
        <button class="tab-btn" id="tabDupes" onclick="switchTab('dupes')"><i class="fas fa-users"></i>Duplicates</button>
        <button class="tab-btn" id="tabAudit" onclick="switchTab('audit')"><i class="fas fa-history"></i>Audit Log</button>
        <button class="tab-btn" id="tabSettings" onclick="switchTab('settings')"><i class="fas fa-cog"></i>Settings</button>
        <button class="tab-btn" id="tabBackups" onclick="switchTab('backups')"><i class="fas fa-save"></i>Backups</button>
        <button class="tab-btn" id="tabHealth" onclick="switchTab('health')"><i class="fas fa-heartbeat"></i>Health</button>
        <button class="tab-btn" id="tabLocks" onclick="switchTab('locks')"><i class="fas fa-lock"></i>Locks</button>
        <button class="tab-btn" id="tabUsers" onclick="switchTab('users')"><i class="fas fa-user-shield"></i>Users</button>
        <button class="tab-btn" id="tabErrlog" onclick="switchTab('errlog')"><i class="fas fa-bug"></i>Error Logs</button>
        <button class="tab-btn" id="tabAnalytics" onclick="switchTab('analytics')"><i class="fas fa-chart-line"></i>Analytics</button>
    </div>

    <!-- Stats Overview -->
    <div class="section-title"><span><i class="fas fa-chart-bar me-1"></i>Database Overview</span><span id="lastRefresh" style="font-size:0.67rem;font-weight:400;text-transform:none;letter-spacing:0;color:var(--text-muted)"></span></div>
    <div class="stats-row" id="statsRow"></div>

    <!-- Tables tab content -->
    <div id="tablesContent">
        <!-- Table Grid -->
        <div class="section-title mt-1">
            <span><i class="fas fa-table me-1"></i>Tables</span>
            <div style="display:flex;gap:0.4rem">
                <button class="btn-bo btn-bo-outline" onclick="selectAll(true)"  style="padding:0.22rem 0.55rem;font-size:0.7rem"><i class="fas fa-check-double me-1"></i>Select All</button>
                <button class="btn-bo btn-bo-outline" onclick="selectAll(false)" style="padding:0.22rem 0.55rem;font-size:0.7rem"><i class="fas fa-times me-1"></i>None</button>
            </div>
        </div>
        <div class="tables-grid" id="tablesGrid"></div>

        <!-- Action Bar -->
        <div class="action-bar">
            <div class="selected-count"><strong id="selCount">0</strong> table(s) selected &bull; <strong id="selRecordCount">0</strong> records to delete</div>
            <div style="display:flex;gap:0.6rem;align-items:center">
                <button class="btn-bo btn-bo-outline" onclick="selectAll(false)"><i class="fas fa-times me-1"></i>Clear</button>
                <button class="btn-bo btn-bo-danger" id="purgeBtn" disabled onclick="openConfirm()"><i class="fas fa-trash-alt me-1"></i>Purge Selected</button>
            </div>
        </div>
    </div>

    <!-- Schema tab content -->
    <div id="schemaContent" class="schema-wrap">
        <input type="text" class="schema-search" id="schemaSearch" placeholder="Search tables or columns..." oninput="filterSchema()">
        <div class="schema-layout">
            <!-- Left sidebar: table list -->
            <div class="schema-sidebar">
                <div class="schema-sidebar-header">
                    <span><i class="fas fa-list me-1"></i>Tables</span>
                    <span id="schemaTblCount" style="font-weight:400;font-size:0.68rem"></span>
                </div>
                <div id="schemaSideList" style="max-height:600px;overflow-y:auto"></div>
            </div>
            <!-- Right: columns + relationships -->
            <div class="schema-main" id="schemaMain">
                <div style="text-align:center;padding:4rem 2rem;color:var(--text-muted)">
                    <i class="fas fa-mouse-pointer" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:1rem"></i>
                    <p>Select a table from the list to view its columns and relationships.</p>
                </div>
            </div>
        </div>

        <!-- All FK Relationships table -->
        <div class="schema-card mt-3" id="allFKSection">
            <div class="schema-card-header">
                <div class="table-icon" style="background:rgba(99,102,241,0.15);color:#6366f1"><i class="fas fa-link"></i></div>
                <div>
                    <h6>All Foreign Key Relationships</h6>
                    <div style="font-size:0.7rem;color:var(--text-muted)">Every FK constraint in the database</div>
                </div>
                <small id="fkTotalCount"></small>
            </div>
            <div id="allFKList" style="max-height:400px;overflow-y:auto">
                <p style="text-align:center;padding:2rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</p>
            </div>
        </div>
    </div>

    <!-- ══ Orphan Records Panel ══ -->
    <div id="orphanContent" class="schema-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
            <div>
                <div style="font-size:1rem;font-weight:700">Orphan Record Detector</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">FK references pointing to non-existent parent records</div>
            </div>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                <button class="btn-bo btn-bo-primary" onclick="loadOrphans()"><i class="fas fa-sync-alt me-1"></i>Scan Now</button>
                <button class="btn-bo btn-bo-outline" id="orphanExportBtn" onclick="exportOrphansCSV()" style="display:none"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
            </div>
        </div>
        <div id="orphanStatus" style="margin-bottom:1rem"></div>
        <div id="orphanList">
            <p style="text-align:center;padding:4rem;color:var(--text-muted)"><i class="fas fa-search" style="display:block;font-size:2rem;opacity:.3;margin-bottom:1rem"></i>Click &ldquo;Scan Now&rdquo; to check for orphaned records.</p>
        </div>
    </div>

    <!-- ══ Duplicate Patients Panel ══ -->
    <div id="dupesContent" class="schema-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
            <div>
                <div style="font-size:1rem;font-weight:700">Duplicate Patient Finder</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">Patients sharing the same full name or phone number</div>
            </div>
            <div style="display:flex;gap:0.5rem">
                <button class="tab-btn active" id="dupeTabName" onclick="switchDupeTab('name')" style="flex:unset;padding:0.4rem 0.8rem;font-size:0.75rem">By Name</button>
                <button class="tab-btn" id="dupeTabPhone" onclick="switchDupeTab('phone')" style="flex:unset;padding:0.4rem 0.8rem;font-size:0.75rem">By Phone</button>
                <button class="btn-bo btn-bo-primary" onclick="loadDupes()"><i class="fas fa-sync-alt me-1"></i>Scan</button>
                <button class="btn-bo btn-bo-outline" id="dupesExportBtn" onclick="exportDupesCSV()" style="display:none"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
            </div>
        </div>
        <div id="dupesStatus" style="margin-bottom:1rem"></div>
        <div id="dupesList">
            <p style="text-align:center;padding:4rem;color:var(--text-muted)"><i class="fas fa-users" style="display:block;font-size:2rem;opacity:.3;margin-bottom:1rem"></i>Click &ldquo;Scan&rdquo; to find duplicate patients.</p>
        </div>
    </div>

    <!-- ══ Audit Log Panel ══ -->
    <div id="auditContent" class="schema-wrap">
        <!-- Filters -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1rem;margin-bottom:1rem">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:0.65rem;margin-bottom:0.65rem">
                <input type="text"   id="auditSearch"   class="schema-search" style="margin:0" placeholder="Search values..." oninput="auditDebounce()">
                <select id="auditAction" class="schema-search" style="margin:0" onchange="auditDebounce()">
                    <option value="">All Actions</option>
                </select>
                <input type="text"   id="auditEntity"   class="schema-search" style="margin:0" placeholder="Module (e.g. Patient)" oninput="auditDebounce()">
                <input type="date"   id="auditDateFrom" class="schema-search" style="margin:0" onchange="auditDebounce()">
                <input type="date"   id="auditDateTo"   class="schema-search" style="margin:0" onchange="auditDebounce()">
                <div style="display:flex;gap:0.4rem;align-items:center">
                    <button class="btn-bo btn-bo-primary" onclick="loadAuditLogs(1)" style="flex:1;padding:0.45rem"><i class="fas fa-search me-1"></i>Apply</button>
                    <button class="btn-bo btn-bo-outline" onclick="clearAuditFilters()" style="padding:0.45rem 0.7rem"><i class="fas fa-times"></i></button>
                    <button class="btn-bo btn-bo-outline" id="auditExportBtn" onclick="exportAuditLogsCSV()" style="padding:0.45rem 0.7rem;display:none" title="Export all matching logs as CSV"><i class="fas fa-file-csv"></i></button>
                </div>
            </div>
        </div>
        <div id="auditStatus" style="margin-bottom:0.5rem;font-size:0.78rem;color:var(--text-muted)"></div>
        <div id="auditList">
            <p style="text-align:center;padding:4rem;color:var(--text-muted)"><i class="fas fa-history" style="display:block;font-size:2rem;opacity:.3;margin-bottom:1rem"></i>Loading audit logs...</p>
        </div>
        <div id="auditPagination" style="display:flex;gap:0.4rem;justify-content:center;flex-wrap:wrap;margin-top:1rem"></div>
    </div>

    <!-- ══ System Settings Panel ══ -->
    <div id="settingsContent" class="schema-wrap">
        <div style="font-size:1rem;font-weight:700;margin-bottom:0.25rem">System Settings</div>
        <div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:1.5rem">Configure application and backup behaviour</div>
        <form id="settingsForm" onsubmit="saveSettings(event)">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;margin-bottom:1.5rem">
                <div class="schema-card" style="padding:1rem">
                    <label style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em">Application Name</label>
                    <input type="text" id="sAppName" class="schema-search" style="margin:0.4rem 0 0" placeholder="Daniely RX">
                </div>
                <div class="schema-card" style="padding:1rem">
                    <label style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em">Backup Folder Path</label>
                    <input type="text" id="sBackupPath" class="schema-search" style="margin:0.4rem 0 0" placeholder="e.g. C:\\Backups\\DanielyRX">
                    <div style="font-size:0.68rem;color:var(--text-muted);margin-top:0.3rem">Folder will be created if it doesn't exist</div>
                </div>
                <div class="schema-card" style="padding:1rem">
                    <label style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em">Backup Retention (Days)</label>
                    <input type="number" id="sRetentionDays" class="schema-search" style="margin:0.4rem 0 0" min="1" max="365" placeholder="30">
                    <div style="font-size:0.68rem;color:var(--text-muted);margin-top:0.3rem">Backups older than this are auto-deleted</div>
                </div>
                <div class="schema-card" style="padding:1rem">
                    <label style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em">Session Timeout (Minutes)</label>
                    <input type="number" id="sSessionTimeout" class="schema-search" style="margin:0.4rem 0 0" min="5" max="480" placeholder="60">
                </div>
                <div class="schema-card" style="padding:1rem">
                    <label style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em">Max Login Attempts</label>
                    <input type="number" id="sMaxLogin" class="schema-search" style="margin:0.4rem 0 0" min="1" max="20" placeholder="5">
                </div>
                <div class="schema-card" style="padding:1rem;display:flex;align-items:center;justify-content:space-between">
                    <div>
                        <label style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em">Maintenance Mode</label>
                        <div style="font-size:0.68rem;color:var(--text-muted);margin-top:0.25rem">Blocks non-admin logins</div>
                    </div>
                    <label style="position:relative;display:inline-block;width:44px;height:24px;cursor:pointer">
                        <input type="checkbox" id="sMaintenanceMode" style="opacity:0;width:0;height:0">
                        <span id="sMaintenanceToggle" style="position:absolute;inset:0;background:#334155;border-radius:12px;transition:.2s" onclick="this.style.background=document.getElementById('sMaintenanceMode').checked?'#334155':'#6366f1'"></span>
                        <span id="sMaintenanceKnob" style="position:absolute;left:4px;top:4px;width:16px;height:16px;background:#94a3b8;border-radius:50%;transition:.2s"></span>
                    </label>
                </div>
            </div>
            <div style="display:flex;gap:0.75rem;align-items:center">
                <button type="submit" class="btn-bo btn-bo-primary"><i class="fas fa-save me-1"></i>Save Settings</button>
                <span id="settingsSavedMsg" style="color:#6ee7b7;font-size:0.8rem;opacity:0;transition:opacity .4s"></span>
            </div>
        </form>
    </div>

    <!-- ══ Backup Manager Panel ══ -->
    <div id="backupsContent" class="schema-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
            <div>
                <div style="font-size:1rem;font-weight:700">Backup Manager</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">CSV export backups of all database tables</div>
            </div>
            <div style="display:flex;gap:0.5rem">
                <button class="btn-bo btn-bo-outline" onclick="loadBackups()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                <button class="btn-bo btn-bo-primary" id="createBackupBtn" onclick="createBackup()"><i class="fas fa-save me-1"></i>Create Backup Now</button>
            </div>
        </div>
        <div id="backupPath" style="font-size:0.72rem;color:var(--text-muted);margin-bottom:1rem;display:flex;align-items:center;gap:0.4rem"><i class="fas fa-folder-open"></i><span id="backupPathText">Loading...</span></div>
        <div id="backupList">
            <p style="text-align:center;padding:4rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin me-2"></i>Loading backups...</p>
        </div>
    </div>

    <!-- ══ System Health Panel ══ -->
    <div id="healthContent" class="schema-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
            <div><div style="font-size:1rem;font-weight:700">System Health</div><div style="font-size:0.75rem;color:var(--text-muted)">Server, database, and table statistics</div></div>
            <button class="btn-bo btn-bo-outline" onclick="loadHealth()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
        </div>
        <div id="healthCards" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.875rem;margin-bottom:1.25rem"></div>
        <div style="font-size:0.8rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:0.5rem">Table Sizes</div>
        <div id="healthTables"><p style="text-align:center;padding:3rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</p></div>
    </div>

    <!-- ══ Lock Manager Panel ══ -->
    <div id="locksContent" class="schema-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
            <div><div style="font-size:1rem;font-weight:700">Patient Lock Manager</div><div style="font-size:0.75rem;color:var(--text-muted)">View and force-release active or stale patient record locks</div></div>
            <div style="display:flex;gap:0.5rem">
                <button class="btn-bo btn-bo-outline" onclick="loadLocks()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                <button class="btn-bo btn-bo-danger" onclick="releaseExpiredLocks()" style="font-size:0.78rem"><i class="fas fa-broom me-1"></i>Clear Expired</button>
            </div>
        </div>
        <div id="locksStatus" style="margin-bottom:1rem"></div>
        <div id="locksList"><p style="text-align:center;padding:4rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin me-2"></i>Loading locks...</p></div>
    </div>

    <!-- ══ User Manager Panel ══ -->
    <div id="usersContent" class="schema-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
            <div><div style="font-size:1rem;font-weight:700">User Manager</div><div style="font-size:0.75rem;color:var(--text-muted)">View users, change roles, enable/disable accounts, reset passwords</div></div>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                <button class="btn-bo btn-bo-outline" onclick="loadUsers()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                <button class="btn-bo btn-bo-outline" id="usersExportBtn" onclick="exportUsersCSV()" style="display:none"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
            </div>
        </div>
        <div id="usersList"><p style="text-align:center;padding:4rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin me-2"></i>Loading users...</p></div>
    </div>

    <!-- ══ Error Logs Panel ══ -->
    <div id="errlogContent" class="schema-wrap">
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem">
            <div>
                <div style="font-size:1rem;font-weight:700">Error Log Manager</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">Browse, resolve, and purge application error logs</div>
            </div>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                <button class="btn-bo btn-bo-outline" onclick="loadErrorLogs(1)"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                <button class="btn-bo btn-bo-outline" id="errlogExportBtn" onclick="exportErrorLogsCSV()" style="display:none"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
                <button class="btn-bo" style="background:rgba(234,179,8,0.12);color:#fbbf24;border:1px solid rgba(234,179,8,0.3);font-size:0.78rem" onclick="resolveSelectedErrors()"><i class="fas fa-check-double me-1"></i>Mark Resolved</button>
                <button class="btn-bo btn-bo-danger" onclick="openPurgeModal()" style="font-size:0.78rem"><i class="fas fa-fire me-1"></i>Purge Logs</button>
            </div>
        </div>

        <!-- Stat Cards -->
        <div id="errlogStats" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:0.65rem;margin-bottom:1.25rem"></div>

        <!-- Filters -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:0.875rem;margin-bottom:1rem">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:0.5rem">
                <input type="text"   id="errSearch"   class="schema-search" style="margin:0" placeholder="Search message / URL..." oninput="errDebounce()">
                <select id="errSeverity" class="schema-search" style="margin:0" onchange="errDebounce()">
                    <option value="">All Severities</option>
                    <option value="error">Error</option>
                    <option value="warning">Warning</option>
                    <option value="info">Info</option>
                </select>
                <select id="errSource" class="schema-search" style="margin:0" onchange="errDebounce()">
                    <option value="">All Sources</option>
                    <option value="frontend">Frontend</option>
                    <option value="backend">Backend</option>
                </select>
                <select id="errResolved" class="schema-search" style="margin:0" onchange="errDebounce()">
