                    <div><div style="font-weight:600;font-size:0.82rem;color:#ef4444">Purge ALL error logs</div><div style="font-size:0.72rem;color:var(--text-muted)">Deletes every record in the ErrorLogs table</div></div>
                </label>
            </div>
            <!-- Dynamic sub-options -->
            <div id="purgeAgeOpts" style="display:none;margin-bottom:1rem">
                <label style="font-size:0.72rem;color:var(--text-muted)">Delete logs older than</label>
                <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.3rem">
                    <input type="number" id="purgeAgeDays" class="schema-search" style="margin:0;width:80px" min="1" max="3650" value="30">
                    <span style="font-size:0.8rem;color:var(--text-muted)">days</span>
                    <select id="purgeAgeSev" class="schema-search" style="margin:0;flex:1"><option value="">Any severity</option><option value="error">Error only</option><option value="warning">Warning only</option><option value="info">Info only</option></select>
                    <select id="purgeAgeSrc" class="schema-search" style="margin:0;flex:1"><option value="">Any source</option><option value="frontend">Frontend</option><option value="backend">Backend</option></select>
                </div>
                <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.72rem;margin-top:0.5rem;cursor:pointer"><input type="checkbox" id="purgeAgeResOnly"> Resolved only</label>
            </div>
            <div id="purgeFilterOpts" style="display:none;margin-bottom:1rem">
                <label style="font-size:0.72rem;color:var(--text-muted)">Filter by</label>
                <div style="display:flex;gap:0.5rem;margin-top:0.3rem;flex-wrap:wrap">
                    <select id="purgeFilterSev" class="schema-search" style="margin:0;flex:1"><option value="">Any severity</option><option value="error">Error</option><option value="warning">Warning</option><option value="info">Info</option></select>
                    <select id="purgeFilterSrc" class="schema-search" style="margin:0;flex:1"><option value="">Any source</option><option value="frontend">Frontend</option><option value="backend">Backend</option></select>
                </div>
