<!-- Purge Confirm Modal                                                      -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="bo-modal-backdrop" id="confirmBackdrop">
    <div class="bo-modal">
        <div class="bo-modal-header">
            <i class="fas fa-exclamation-triangle" style="color:#ef4444;font-size:1.1rem"></i>
            <h5>Confirm Permanent Deletion</h5>
        </div>
        <div class="bo-modal-body">
            <p style="font-size:0.8rem;color:#fca5a5;margin-bottom:0.875rem">You are about to <strong>permanently delete</strong> the following data. This action cannot be undone.</p>
            <div class="delete-summary" id="confirmSummary"></div>
            <div class="confirm-input-wrap">
                <label>Step 1 &mdash; Type <code>DELETE FOREVER</code> to confirm:</label>
                <input type="text" class="confirm-input" id="confirmPhrase" placeholder="DELETE FOREVER" autocomplete="off" oninput="checkPhrase()">
            </div>
            <!-- BO-05: Second confirmation layer -->
            <div class="confirm-input-wrap" style="margin-top:0.75rem">
                <label>Step 2 &mdash; Type your <code id="usernameHint" style="color:#a5b4fc">username</code> to authorize:</label>
                <input type="text" class="confirm-input" id="confirmUsername" placeholder="Your username" autocomplete="off" oninput="checkPhrase()">
            </div>
        </div>
        <div class="bo-modal-footer">
            <button class="btn-bo btn-bo-outline" onclick="closeConfirm()"><i class="fas fa-times me-1"></i>Cancel</button>
            <button class="btn-bo btn-bo-danger" id="confirmPurgeBtn" disabled onclick="executePurge()">
                <span id="purgeSpinner" class="spinner-sm" style="display:none"></span>
                <i class="fas fa-skull-crossbones me-1" id="purgeIcon"></i>Permanently Delete
            </button>
        </div>
    </div>
</div>

