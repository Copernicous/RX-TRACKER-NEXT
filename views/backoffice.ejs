                <i class="fas fa-trash-alt me-1"></i>Delete <span id="viewerDelCount">0</span> selected
            </button>
            <button class="btn-bo btn-bo-success" id="viewerExportBtn" onclick="exportCurrentTable()">
                <i class="fas fa-file-csv me-1"></i>Export CSV
            </button>
            <button class="btn-bo btn-bo-outline" onclick="closeViewer()">
                <i class="fas fa-times me-1"></i>Close
            </button>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="viewer-toolbar">
        <input type="text" class="viewer-search" id="viewerSearch" placeholder="Search in any column..." oninput="applyViewerFilter()">
        <div class="col-toggle-wrap">
            <button class="col-toggle-btn" id="colToggleBtn" onclick="toggleColDropdown()">
                <i class="fas fa-columns me-1"></i>Columns <i class="fas fa-chevron-down ms-1" style="font-size:0.65rem"></i>
            </button>
            <div class="col-dropdown" id="colDropdown"></div>
        </div>
        <div style="display:flex;align-items:center;gap:0.4rem;margin-left:auto">
            <span style="font-size:0.73rem;color:var(--text-muted)">Rows/page:</span>
            <select class="pag-size" id="pageSizeSelect" onchange="changePageSize()">
                <option value="25">25</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="250">250</option>
                <option value="0">All</option>
            </select>
        </div>
        <span class="viewer-info" id="viewerInfo"></span>
    </div>

    <!-- Selection Bar -->
    <div class="sel-bar" id="selBar">
        <span class="sel-bar-info" id="selBarText">0 rows selected</span>
        <button class="btn-bo btn-bo-danger" onclick="openImpactModal()" style="padding:0.3rem 0.7rem;font-size:0.75rem">
            <i class="fas fa-trash-alt me-1"></i>Delete Selected
        </button>
        <button class="btn-bo btn-bo-outline" onclick="clearRowSelection()" style="padding:0.3rem 0.7rem;font-size:0.75rem">Cancel</button>
    </div>

    <!-- Table Body -->
    <div class="viewer-body">
        <div id="viewerTableWrap" style="min-height:200px">
            <p class="no-rows"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</p>
        </div>
    </div>

    <!-- Pagination Footer -->
    <div class="viewer-footer">
        <span class="pag-info" id="pagInfo"></span>
        <div class="pag-controls" id="pagControls"></div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- Row Delete Impact Modal                                                  -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="bo-modal-backdrop" id="impactBackdrop">
    <div class="bo-modal" style="max-width:560px">
        <div class="bo-modal-header">
            <i class="fas fa-exclamation-triangle" style="color:#f59e0b;font-size:1.1rem"></i>
            <h5 style="color:#fde68a">Impact Analysis &mdash; Confirm Row Deletion</h5>
        </div>
        <div class="bo-modal-body">
            <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1rem">
                Deleting <strong id="impactRowCount" style="color:var(--text)">0</strong> row(s) from
                <strong id="impactTableName" style="color:#a5b4fc"></strong> will also affect:
            </p>
            <div id="impactList" style="background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:0.75rem;margin-bottom:1rem;min-height:60px">
                <p style="color:var(--text-muted);font-size:0.8rem;text-align:center"><i class="fas fa-spinner fa-spin me-2"></i>Analyzing impact...</p>
            </div>
            <div style="background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15);border-radius:8px;padding:0.75rem;margin-bottom:1rem;font-size:0.78rem;color:#fca5a5">
                <i class="fas fa-exclamation-circle me-1"></i>
                <span id="impactWarning">This action is <strong>permanent and irreversible</strong>.</span>
            </div>
            <div class="confirm-input-wrap">
                <label>Type <code>CONFIRM</code> to proceed:</label>
                <input type="text" class="confirm-input" id="impactPhrase" placeholder="CONFIRM" autocomplete="off" oninput="checkImpactPhrase()">
            </div>
        </div>
        <div class="bo-modal-footer">
            <button class="btn-bo btn-bo-outline" onclick="closeImpactModal()"><i class="fas fa-times me-1"></i>Cancel</button>
            <button class="btn-bo btn-bo-danger" id="impactDeleteBtn" disabled onclick="executeRowDelete()">
                <span id="impactSpinner" class="spinner-sm" style="display:none"></span>
                <i class="fas fa-trash-alt me-1" id="impactIcon"></i>Delete Rows
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- Purge Confirm Modal                                                      -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="bo-modal-backdrop" id="confirmBackdrop">
    <div class="bo-modal">
        <div class="bo-modal-header">
            <i class="fas fa-exclamation-triangle" style="color:#ef4444;font-size:1.1rem"></i>
            <h5>Confirm Permanent Deletion</h5>
        </div>
        <div class="bo-modal-body">
            <p style="font-size:0.8rem;color:#fca5a5;margin-bottom:0.875rem">You are about to <strong>permanently delete</strong> the following data. This action cannot be undone.</p>
            <div class="delete-summary" id="confirmSummary"></div>
            <div class="confirm-input-wrap">
                <label>Type <code>DELETE FOREVER</code> to confirm:</label>
                <input type="text" class="confirm-input" id="confirmPhrase" placeholder="DELETE FOREVER" autocomplete="off" oninput="checkPhrase()">
            </div>
        </div>
        <div class="bo-modal-footer">
            <button class="btn-bo btn-bo-outline" onclick="closeConfirm()"><i class="fas fa-times me-1"></i>Cancel</button>
            <button class="btn-bo btn-bo-danger" id="confirmPurgeBtn" disabled onclick="executePurge()">
                <span id="purgeSpinner" class="spinner-sm" style="display:none"></span>
                <i class="fas fa-skull-crossbones me-1" id="purgeIcon"></i>Permanently Delete
            </button>
        </div>
    </div>
</div>

<div class="bo-toast-wrap" id="toastWrap"></div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/backoffice.js"></script>
<script src="/js/backoffice-features.js"></script>
</body>
