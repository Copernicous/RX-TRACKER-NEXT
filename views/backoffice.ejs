                <label style="display:flex;align-items:flex-start;gap:0.5rem;cursor:pointer;padding:0.625rem;border-radius:8px;border:1px solid var(--border);transition:.15s" id="pmOpt2">
                    <input type="radio" name="purgeMode" value="filter" style="margin-top:0.2rem" onchange="onPurgeModeChange()">
                    <div><div style="font-weight:600;font-size:0.82rem">By severity / source</div><div style="font-size:0.72rem;color:var(--text-muted)">Delete all logs matching selected severity or source</div></div>
                </label>
                <label style="display:flex;align-items:flex-start;gap:0.5rem;cursor:pointer;padding:0.625rem;border-radius:8px;border:1px solid var(--border);transition:.15s" id="pmOpt3">
                    <input type="radio" name="purgeMode" value="resolved" style="margin-top:0.2rem" onchange="onPurgeModeChange()">
                    <div><div style="font-weight:600;font-size:0.82rem">Resolved only</div><div style="font-size:0.72rem;color:var(--text-muted)">Delete only logs marked as resolved</div></div>
                </label>
                <label style="display:flex;align-items:flex-start;gap:0.5rem;cursor:pointer;padding:0.625rem;border-radius:8px;border:1px solid var(--border);transition:.15s" id="pmOpt4">
