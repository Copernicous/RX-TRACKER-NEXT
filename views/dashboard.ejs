<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="rx-csrf-token" content="<%= csrfToken || '' %>">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <script>
    // FortiGate cache buster: if URL doesn't have current build version, redirect to versioned URL.
    // Each server restart generates a new build ID. This script runs in its own block so it
    // executes even if the main inline script below has a syntax error from a stale cached page.
    (function() {
        var bv = '<%- appBuild %>';
        var kv = '_v=' + bv;
        if (window.location.search.indexOf(kv) === -1) {
            var qs = window.location.search;
            var sep = qs ? '&' : '?';
            window.location.replace(window.location.pathname + qs + sep + kv);
        }
    })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .stat-card-clickable {
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .stat-card-clickable:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.13);
        }
        .stat-card-clickable:hover .card-icon {
            opacity: 0.85;
        }

        /* ── Date range preset buttons ─────────────────────────────────────
           Plain .btn .btn-sm has no visible background — dark on dark in
           dark mode. Give them an explicit outline pill style by default
           and a filled primary style when active.
        ── */
        .dash-preset {
            background: transparent;
            border: 1.5px solid var(--border, rgba(0,0,0,0.15));
            color: var(--text-muted, #718096);
            font-weight: 500;
            transition: all 0.18s;
        }
        .dash-preset:hover {
            border-color: #4a90e2;
            color: #4a90e2;
            background: rgba(74,144,226,0.08);
        }
        .dash-preset.active {
            background: #4a90e2;
            border-color: #4a90e2;
            color: #ffffff !important;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(74,144,226,0.35);
        }
        /* Dark mode explicit overrides */
        [data-theme="dark"] .dash-preset {
            border-color: rgba(255,255,255,0.18);
            color: #8b949e;
        }
        [data-theme="dark"] .dash-preset:hover {
            border-color: #4a90e2;
            color: #90c4f9;
            background: rgba(74,144,226,0.12);
        }
        [data-theme="dark"] .dash-preset.active {
            background: #4a90e2;
            border-color: #4a90e2;
            color: #ffffff !important;
        }
        .cc-history-toolbar {
            display: flex;
            align-items: center;
            gap: .5rem;
            flex-wrap: nowrap;
            overflow-x: auto;
            padding-bottom: 2px;
        }
        .cc-history-toolbar .btn-group {
            flex: 0 0 auto;
        }
        #content .cc-history-toolbar .cc-history-type {
            width: 92px !important;
            min-width: 92px !important;
            max-width: 92px !important;
            flex: 0 0 92px;
        }
        #content .cc-history-toolbar .cc-history-user {
            width: 210px !important;
            min-width: 210px !important;
            max-width: 210px !important;
            flex: 0 0 210px;
        }
        #content .cc-history-toolbar .cc-history-date {
            width: 142px !important;
            min-width: 142px !important;
            max-width: 142px !important;
            flex: 0 0 142px;
        }
        .cc-history-toolbar .btn {
            white-space: nowrap;
        }
        .cc-kpi-card {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px 14px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            height: 100%;
        }
        .cc-kpi-clickable {
            cursor: pointer;
            transition: border-color .15s, box-shadow .15s, transform .15s;
        }
        .cc-kpi-clickable:hover,
        .cc-kpi-clickable:focus {
            border-color: #4a90e2;
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
            transform: translateY(-1px);
            outline: none;
        }
        .cc-kpi-clickable:hover .cc-kpi-icon,
        .cc-kpi-clickable:focus .cc-kpi-icon {
            opacity: .85;
        }
        .cc-kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 38px;
            font-size: 1rem;
        }
        .cc-drill-sort {
            border: 0;
            background: transparent;
            color: inherit;
            font: inherit;
            font-weight: 800;
            padding: 0;
            text-align: inherit;
            white-space: nowrap;
        }
        .cc-drill-sort i {
            opacity: .45;
            margin-left: 4px;
        }
        .cc-drill-sort.active i {
            opacity: 1;
            color: #4a90e2;
        }
        .cc-drill-history-row td {
            background: rgba(74,144,226,.035);
            border-top: 0;
        }
        .cc-drill-history-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(180px, 1fr));
            gap: 10px;
        }
        .cc-drill-history-box {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px 10px;
            min-height: 52px;
        }
        .cc-drill-history-title {
            color: var(--text-muted);
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 4px;
        }
        .cc-drill-history-list {
            max-height: 130px;
            overflow: auto;
            font-size: .78rem;
            line-height: 1.35;
        }
        @media (max-width: 900px) {
            .cc-drill-history-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="wrapper">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>
    <!-- Page Content -->
    <div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-2">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm">
                <i class="fas fa-bars"></i>
            </button>
            <span class="ms-3 fw-bold fs-5">Dashboard</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <!-- ── Auto-refresh control ── -->
                <div class="d-flex align-items-center gap-1" id="autoRefreshWidget"
                     style="border:1.5px solid var(--border);border-radius:20px;padding:2px 10px 2px 8px;background:transparent">
                    <!-- Pulse dot -->
                    <span id="arPulseDot" style="width:7px;height:7px;border-radius:50%;background:#6c757d;display:inline-block;margin-right:4px;transition:background .3s"></span>
                    <!-- Countdown -->
                    <span id="arCountdown" style="font-size:.72rem;font-weight:600;color:var(--text-muted);min-width:30px;text-align:right;font-variant-numeric:tabular-nums">Off</span>
                    <!-- Divider -->
                    <span style="color:var(--border);margin:0 4px">|</span>
                    <!-- Interval selector -->
                    <select id="arIntervalSelect"
                            style="border:none;background:transparent;font-size:.72rem;color:var(--text-muted);cursor:pointer;padding:0;outline:none;font-weight:500">
                        <option value="0">Off</option>
                        <option value="15">15 s</option>
                        <option value="60">1 min</option>
                        <option value="300">5 min</option>
                        <option value="600">10 min</option>
                    </select>
                    <!-- Manual refresh -->
                    <button id="arManualBtn" title="Refresh now"
                            style="background:none;border:none;color:var(--text-muted);cursor:pointer;padding:0 0 0 4px;font-size:.78rem;line-height:1">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>

                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button class="btn btn-outline-info btn-sm" onclick="openAccountModal()" title="My Account / 2FA">
                    <i class="fas fa-shield-alt me-1"></i>My Account
                </button>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

<!-- My Account / 2FA Modal -->
<div class="modal fade" id="accountModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background:#1e2336;border:1px solid rgba(255,255,255,.1);color:#fff">
      <div class="modal-header border-0">
        <h5 class="modal-title"><i class="fas fa-shield-alt text-info me-2"></i>My Account Security</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body px-4 pb-4">
        <!-- 2FA Status Banner -->
        <div id="twoFAStatusBanner" class="rounded-3 p-3 mb-4 text-center" style="background:rgba(255,255,255,.05)">
          <div id="twoFAStatusIcon" style="font-size:2rem;margin-bottom:.3rem"></div>
          <div id="twoFAStatusText" class="fw-bold"></div>
          <div id="twoFAStatusSub" class="text-muted small mt-1"></div>
          <div id="twoFABackupRemaining" class="d-none mt-1"></div>
        </div>

        <!-- Backup codes display (shown once after enable) -->
        <div id="twoFABackupCodesSection" class="d-none mb-4">
          <div class="alert alert-warning py-2 mb-2 small">
            <i class="fas fa-exclamation-triangle me-1"></i>
            <strong>Save these backup codes now.</strong> They will not be shown again.
            Use one if you lose access to your authenticator app.
          </div>
          <div id="twoFABackupCodesGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px"></div>
          <button class="btn btn-outline-secondary btn-sm w-100" onclick="copyBackupCodes()">
            <i class="fas fa-copy me-1"></i>Copy All Codes
          </button>
        </div>

        <!-- Setup Flow (shown when 2FA is OFF) -->
        <div id="twoFASetupSection">
          <p class="text-muted small mb-3">
            <i class="fas fa-info-circle text-info me-1"></i>
            Two-factor authentication adds an extra layer of security. After enabling, you will need a 6-digit code from your authenticator app every time you log in.
          </p>
          <button class="btn btn-info w-100 mb-2" id="startSetupBtn" onclick="start2FASetup()">
            <i class="fas fa-qrcode me-1"></i>Set Up Two-Factor Authentication
          </button>
          <!-- QR Code section (hidden until Setup is clicked) -->
          <div id="twoFAQRSection" class="d-none text-center">
            <div class="alert alert-info py-2 small mb-3">
              <i class="fas fa-mobile-alt me-1"></i>
              Scan this QR code with <strong>Google Authenticator</strong>, <strong>Authy</strong>, or any TOTP app.
            </div>
            <img id="twoFAQRImg" src="" alt="QR Code" class="rounded mb-3" style="max-width:200px;border:4px solid #fff">
            <div class="mb-3">
              <label class="form-label small text-muted">Manual entry key</label>
              <div class="input-group input-group-sm">
                <input type="text" id="twoFASecretDisplay" class="form-control text-center font-monospace" readonly style="background:rgba(255,255,255,.1);color:#fff;font-size:.75rem;letter-spacing:.1rem">
                <button class="btn btn-outline-secondary btn-sm" onclick="copySecret()" title="Copy"><i class="fas fa-copy"></i></button>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label small">Enter the 6-digit code to confirm setup</label>
              <input type="text" id="twoFAEnableCode" class="form-control text-center fw-bold"
                     inputmode="numeric" maxlength="7" placeholder="000 000"
                     style="font-size:1.4rem;letter-spacing:.3rem;background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2)">
            </div>
            <div id="twoFAEnableError" class="alert alert-danger py-2 small d-none"></div>
            <button class="btn btn-success w-100" id="enableTwoFABtn" onclick="enable2FA()">
              <span id="enableSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
              <i class="fas fa-check-circle me-1"></i>Activate 2FA
            </button>
          </div>
        </div>

        <!-- Disable Flow + Backup Code Management (shown when 2FA is ON) -->
        <div id="twoFADisableSection" class="d-none">
          <p class="text-muted small mb-3">
            <i class="fas fa-exclamation-triangle text-warning me-1"></i>
            To disable 2FA, enter a code from your authenticator app to confirm it's really you.
          </p>
          <input type="text" id="twoFADisableCode" class="form-control text-center fw-bold mb-3"
                 inputmode="numeric" maxlength="7" placeholder="000 000"
                 style="font-size:1.4rem;letter-spacing:.3rem;background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2)">
          <div id="twoFADisableError" class="alert alert-danger py-2 small d-none"></div>
          <button class="btn btn-danger w-100 mb-3" id="disableTwoFABtn" onclick="disable2FA()">
            <span id="disableSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
            <i class="fas fa-times-circle me-1"></i>Disable Two-Factor Authentication
          </button>
          <hr style="border-color:rgba(255,255,255,.1)">
          <!-- Regenerate backup codes -->
          <div id="regenCodesSection">
            <p class="text-muted small mb-2"><i class="fas fa-key me-1"></i>Lost your backup codes? Generate a new set (invalidates old codes).</p>
            <div class="input-group input-group-sm mb-2">
              <input type="text" id="regenCode" class="form-control text-center font-monospace" placeholder="Enter authenticator code to confirm" inputmode="numeric" maxlength="7"
                style="background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2)">
              <button class="btn btn-outline-warning" onclick="regenerateBackupCodes()">
                <i class="fas fa-redo me-1"></i>Regenerate
              </button>
            </div>
            <div id="regenError" class="alert alert-danger py-1 small d-none"></div>
          </div>
        </div>

        <!-- Change Password section -->
        <hr style="border-color:rgba(255,255,255,.1)" class="mt-3">
        <div id="changePwSection">
          <p class="small fw-semibold mb-2"><i class="fas fa-key me-1 text-warning"></i>Change Password</p>
          <input type="password" id="cpCurrentPw" class="form-control mb-2 form-control-sm" placeholder="Current password"
            style="background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.2)">
          <input type="password" id="cpNewPw" class="form-control mb-2 form-control-sm" placeholder="New password (min 8 chars)"
            style="background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.2)">
          <div id="cpError" class="alert alert-danger py-1 small d-none mb-2"></div>
          <div id="cpSuccess" class="alert alert-success py-1 small d-none mb-2">Password changed. Other sessions have been signed out.</div>
          <button class="btn btn-outline-warning btn-sm w-100" onclick="changePassword()">
            <i class="fas fa-save me-1"></i>Change Password &amp; Sign Out Other Sessions
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

        <!-- Date Range Bar -->
        <div class="px-4 mb-4">
            <div class="glass-card p-2 px-3 d-flex align-items-center gap-2 flex-wrap">
                <i class="fas fa-calendar-alt text-primary me-1" style="font-size:.85rem"></i>
                <span class="small fw-bold text-muted me-1" style="white-space:nowrap">Date Range:</span>
                <div class="d-flex gap-1 flex-wrap">
                    <button class="btn btn-sm dash-preset active" data-preset="all" style="font-size:.75rem;padding:3px 10px;border-radius:20px">All Time</button>
                    <button class="btn btn-sm dash-preset" data-preset="today" style="font-size:.75rem;padding:3px 10px;border-radius:20px">Today</button>
                    <button class="btn btn-sm dash-preset" data-preset="week" style="font-size:.75rem;padding:3px 10px;border-radius:20px">This Week</button>
                    <button class="btn btn-sm dash-preset" data-preset="month" style="font-size:.75rem;padding:3px 10px;border-radius:20px">This Month</button>
                    <button class="btn btn-sm dash-preset" data-preset="30d" style="font-size:.75rem;padding:3px 10px;border-radius:20px">Last 30 Days</button>
                    <button class="btn btn-sm dash-preset" data-preset="year" style="font-size:.75rem;padding:3px 10px;border-radius:20px">This Year</button>
                </div>
                <div class="d-flex align-items-center gap-1 ms-2">
                    <span class="small text-muted">Custom:</span>
                    <input type="date" id="dashFrom" class="form-control form-control-sm" style="width:140px;font-size:.78rem">
                    <span class="small text-muted">&ndash;</span>
                    <input type="date" id="dashTo" class="form-control form-control-sm" style="width:140px;font-size:.78rem">
                </div>
                <span id="dashRangeLabel" class="ms-auto badge rounded-pill" style="background:rgba(74,144,226,.12);color:#4a90e2;font-size:.72rem;white-space:nowrap">Showing all time</span>
            </div>
        </div>

        <div class="container-fluid px-4">
            <!-- Stat Cards -->
            <div class="row g-3 mb-4 row-cols-5">
                <div class="col">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openDrilldown('active-patients')" title="Click to view list">
                        <div class="me-2 card-icon" style="font-size:2rem;color:#4a90e2"><i class="fas fa-user-check"></i></div>
                        <div>
                            <div class="text-muted small">Active Patients</div>
                            <div class="fs-2 fw-bold" id="activePatientsCount">&mdash;</div>
                            <small class="text-primary"><i class="fas fa-external-link-alt me-1"></i>View list</small>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openDrilldown('inactive-patients')" title="Click to view list">
                        <div class="me-2 card-icon" style="font-size:2rem;color:#e24a4a"><i class="fas fa-user-times"></i></div>
                        <div>
                            <div class="text-muted small">Inactive Patients</div>
                            <div class="fs-2 fw-bold" id="inactivePatientsCount">&mdash;</div>
                            <small class="text-danger"><i class="fas fa-external-link-alt me-1"></i>View list</small>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openDrilldown('total-rx')" title="Click to view list">
                        <div class="me-2 card-icon" style="font-size:2rem;color:#50e3c2"><i class="fas fa-prescription-bottle-alt"></i></div>
                        <div>
                            <div class="text-muted small">Total RX Records</div>
                            <div class="fs-2 fw-bold" id="activeRxCount">&mdash;</div>
                            <small class="text-success"><i class="fas fa-external-link-alt me-1"></i>View list</small>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openDrilldown('patients-no-rx')" title="Click to view list">
                        <div class="me-2 card-icon" style="font-size:2rem;color:#9b59b6"><i class="fas fa-user-slash"></i></div>
                        <div>
                            <div class="text-muted small">Total No-RX Records</div>
                            <div class="fs-2 fw-bold" id="patientsWithNoRxCount">&mdash;</div>
                            <small style="color:#9b59b6"><i class="fas fa-external-link-alt me-1"></i>View list</small>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openDrilldown('pending-rx')" title="Click to view list">
                        <div class="me-2 card-icon" style="font-size:2rem;color:#f5a623"><i class="fas fa-truck-loading"></i></div>
                        <div>
                            <div class="text-muted small">Pending Deliveries</div>
                            <div class="fs-2 fw-bold" id="pendingDeliveriesCount">&mdash;</div>
                            <small class="text-warning"><i class="fas fa-external-link-alt me-1"></i>View list</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 90-Day Eligibility Widget -->

            <div class="row g-3 mb-4" id="eligibilityRow">
                <div class="col-12">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                        <h6 class="mb-0"><i class="fas fa-calendar-check me-2" style="color:#198754"></i>90-Day Service Eligibility</h6>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill" style="background:rgba(25,135,84,.12);color:#198754;font-size:.7rem" id="eligLastUpdated"></span>
                            <button class="btn btn-outline-secondary btn-sm" onclick="loadEligibility()" title="Refresh"><i class="fas fa-sync-alt"></i></button>
                        </div>
                    </div>
                </div>
                <!-- Card 1: Eligible Now -->
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openEligDrilldown('eligible')" title="Click to view eligible patients">
                        <div class="me-3 card-icon" style="font-size:2rem;color:#198754"><i class="fas fa-check-circle"></i></div>
                        <div>
                            <div class="text-muted small">Eligible Now</div>
                            <div class="fs-2 fw-bold" id="eligNowCount">&mdash;</div>
                            <small class="text-muted d-block mt-1" id="eligNowNote">Active patients only, inactive excluded</small>
                            <small style="color:#198754"><i class="fas fa-external-link-alt me-1"></i>View patients</small>
                        </div>
                    </div>
                </div>
                <!-- Card 2: Expiring Soon -->
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openEligDrilldown('expiring')" title="Click to view patients expiring within 7 days">
                        <div class="me-3 card-icon" style="font-size:2rem;color:#dc3545"><i class="fas fa-hourglass-half"></i></div>
                        <div>
                            <div class="text-muted small">Call Pre-Eligibility (&le;<%= callCenterLeadDays %> Days)</div>
                            <div class="fs-2 fw-bold" id="eligExpiringCount">&mdash;</div>
                            <small class="text-muted d-block mt-1" id="eligExpiringNote">Active patients only, inactive excluded</small>
                            <small class="text-danger"><i class="fas fa-external-link-alt me-1"></i>View patients</small>
                        </div>
                    </div>
                </div>
                <!-- Card 3: In Active Window -->
                <div class="col-md-3">
                    <div class="glass-card p-3 d-flex align-items-center stat-card-clickable" onclick="openEligDrilldown('window')" title="Click to view patients in active window">
                        <div class="me-3 card-icon" style="font-size:2rem;color:#4a90e2"><i class="fas fa-lock"></i></div>
                        <div>
                            <div class="text-muted small">In Active Window</div>
                            <div class="fs-2 fw-bold" id="eligInWindowCount">&mdash;</div>
