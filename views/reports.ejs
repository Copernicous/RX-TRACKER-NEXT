<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Autocomplete dropdown */
        .ac-wrap { position: relative; }
        .ac-list {
            position: absolute; top: 100%; left: 0; right: 0; z-index: 1060;
            background: var(--card-bg, #fff);
            border: 1px solid var(--border-color, #dee2e6);
            border-radius: 6px; max-height: 200px; overflow-y: auto;
            box-shadow: 0 4px 16px rgba(0,0,0,.15); display: none;
        }
        .ac-list.open { display: block; }
        .ac-item {
            padding: 6px 12px; cursor: pointer; font-size: .85rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .ac-item:hover { background: rgba(74,144,226,.12); color: #4a90e2; }
        /* Pagination bar */
        .pag-bar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 0; margin-top: 12px; margin-bottom: 6px;
            border-top: 1px solid var(--border-color, #dee2e6);
            flex-wrap: wrap; gap: 8px;
        }
        .pag-bar .pag-left  { display: flex; align-items: center; gap: 8px; }
        .pag-bar .pag-right { display: flex; align-items: center; gap: 4px; }
        .cc-history-cell {
            min-width: 280px;
            max-width: 420px;
        }
        .cc-history-mini {
            max-height: 110px;
            overflow: auto;
            font-size: .78rem;
            line-height: 1.35;
            color: var(--text-muted);
        }
        .cc-report-metric {
            border: 1px solid var(--border-color, #dee2e6);
            border-radius: 8px;
            padding: 8px 10px;
            min-width: 110px;
        }
        .cc-supervisor-table th,
        .cc-supervisor-table td {
            white-space: nowrap;
            font-size: .82rem;
        }
        .cc-supervisor-table th:first-child,
        .cc-supervisor-table td:first-child {
            white-space: normal;
            min-width: 150px;
        }
    </style>
</head>
<body>
<div class="wrapper">

    <!-- Sidebar -->
    <%- include('partials/sidebar') %>
    <!-- Page Content -->
    <div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold fs-5">Reports</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">
            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="reportTabs">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#patientReport"><i class="fas fa-users me-1"></i>Patient Report</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#rxActionReport"><i class="fas fa-tasks me-1"></i>RX Action Report</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#callCenterReport"><i class="fas fa-headset me-1"></i>Call Center Report</a>
                </li>
                <li class="nav-item ms-auto d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-primary" id="emailReportBtn" title="Email this report">
                        <i class="fas fa-envelope me-1"></i>Email Report
                    </button>
                    <a class="btn btn-sm btn-outline-secondary" href="/audit-log"><i class="fas fa-history me-1"></i>Audit Log</a>
                </li>
            </ul>

            <div class="tab-content">

                <!-- ═══════════════ PATIENT REPORT TAB ═══════════════ -->
                <div class="tab-pane fade show active" id="patientReport">
                    <div class="glass-card p-4">
                        <!-- Filter header -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold small text-muted text-uppercase" style="letter-spacing:.05em">
                                <i class="fas fa-filter me-1"></i>Patient Filters
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span id="prBadge" class="badge rounded-pill bg-primary" style="display:none;font-size:.7rem">0 filters</span>
                                <button class="btn btn-link btn-sm text-muted p-0" onclick="togglePanel('prAdv','prChevron','prAdvOpen')" style="font-size:.78rem;text-decoration:none">
                                    <i class="fas fa-sliders-h me-1"></i>Advanced <i class="fas fa-chevron-down ms-1" id="prChevron"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Basic filters row -->
                        <div class="row g-2 mb-2 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Patient ID</label>
                                <input type="text" class="form-control form-control-sm" id="prfPatientCode" placeholder="e.g. PAT-001" autocomplete="off">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">First Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="prfFirstName" placeholder="First name..." autocomplete="off">
                                    <div class="ac-list" id="ac-prfFirstName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Last Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="prfLastName" placeholder="Last name..." autocomplete="off">
                                    <div class="ac-list" id="ac-prfLastName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Status</label>
                                <select class="form-select form-select-sm" id="patientStatusFilter">
                                    <option value="">All</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex gap-2 align-items-end">
                                <button class="btn btn-primary btn-sm btn-search" onclick="prPage=1;renderPatientReport()" title="Search"><i class="fas fa-search"></i></button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="clearPatientFilters()" title="Clear"><i class="fas fa-times"></i></button>
                            </div>
                            <div class="col-md-2 d-flex align-items-end gap-2">
                                <button class="btn btn-outline-success btn-sm flex-grow-1" id="exportPatientCsv"><i class="fas fa-file-csv me-1"></i>CSV</button>
                                <button class="btn btn-outline-primary btn-sm" id="exportPatientXls" title="Export Excel"><i class="fas fa-file-excel me-1"></i>Excel</button>
                                <button class="btn btn-outline-danger btn-sm" id="exportPatientPdf" title="Export PDF (print)"><i class="fas fa-file-pdf me-1"></i>PDF</button>
                                <button class="btn btn-outline-secondary btn-sm" title="Print" id="printPatientBtn"><i class="fas fa-print"></i></button>
                            </div>
                        </div>

                        <!-- Advanced filters -->
                        <div id="prAdv" style="display:none;border-top:1px solid var(--border-color,#dee2e6);padding-top:10px;margin-top:2px">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Phone</label>
                                    <input type="text" class="form-control form-control-sm" id="prfPhone" placeholder="Phone..." autocomplete="off">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Date of Birth</label>
                                    <input type="date" class="form-control form-control-sm" id="prfDob">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Patient Type</label>
                                    <select class="form-select form-select-sm" id="prfPatientType">
                                        <option value="">All Patient Types</option>
                                        <option value="company">Company Patients</option>
                                        <option value="non_company">Non-Company Patients</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Eligibility</label>
                                    <select class="form-select form-select-sm" id="prfEligibility">
                                        <option value="">All Eligibility</option>
                                        <option value="needsAction">Needs Workflow Action</option>
                                        <option value="eligible">Eligible Now</option>
                                        <option value="expiring">Call Pre-Eligibility</option>
                                        <option value="window">In Active Window</option>
                                        <option value="none">No Service Date</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Missing Information</label>
                                    <select class="form-select form-select-sm" id="prfMissingInfo">
                                        <option value="">All Completeness</option>
                                        <option value="any">Missing Any Assignment</option>
                                        <option value="all">Missing All Assignments</option>
                                        <option value="clinic">Missing Clinic</option>
                                        <option value="pharmacy">Missing Pharmacy</option>
                                        <option value="patientTransport">Missing Patient Transport</option>
                                        <option value="pharmacyTransport">Missing Pharmacy Transport</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">RX Records</label>
                                    <select class="form-select form-select-sm" id="prfRxStatus">
                                        <option value="">With or Without RX</option>
                                        <option value="has_rx">Has RX Records</option>
                                        <option value="no_rx">No RX Records</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row g-2 align-items-end mt-1">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Clinic / Location</label>
                                    <select class="form-select form-select-sm" id="prfClinicId"><option value="">All Clinics</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Default Pharmacy</label>
                                    <select class="form-select form-select-sm" id="prfPharmacyId"><option value="">All Pharmacies</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Patient Transport</label>
                                    <select class="form-select form-select-sm" id="prfPatientTransportId"><option value="">All Patient Transports</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Pharmacy Transport</label>
                                    <select class="form-select form-select-sm" id="prfPharmacyTransportId"><option value="">All Pharmacy Transports</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service From</label>
                                    <input type="date" class="form-control form-control-sm" id="patientDateFrom">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service To</label>
                                    <input type="date" class="form-control form-control-sm" id="patientDateTo">
                                </div>
                            </div>
                        </div>

                        <!-- ── Pagination bar TOP ── -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border rounded p-2 mt-3 mb-2">
                            <div>
                                <div class="fw-bold small"><i class="fas fa-table me-1 text-primary"></i>Patient + RX Transfer Files</div>
                                <div class="small text-muted">
                                    The table below stays compact for reference. Complete History CSV uses the filters above and writes every patient/RX, workflow step, medication, change, note, service-date record, document reference, and call attempt as a linked vertical row.
                                    Summary Excel always includes separate Status, Date, and Completed By columns for every configured workflow step, even when a step has no completed records.
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-success btn-sm" id="exportPatientRxDetailCsv">
                                    <i class="fas fa-file-csv me-1"></i>Complete History CSV
                                </button>
                                <button class="btn btn-outline-primary btn-sm" id="exportPatientRxDetailXls">
                                    <i class="fas fa-file-excel me-1"></i>Summary Excel
                                </button>
                            </div>
                        </div>

                        <div class="pag-bar" id="prPagBar">
                            <div class="pag-left">
                                <label class="small text-muted mb-0">Show</label>
                                <select class="form-select form-select-sm" style="width:auto" id="prPageSize" onchange="prChangeSize(this.value)">
                                    <option value="10" selected>10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="small text-muted" id="patientReportCount"></span>
                            </div>
                            <div class="pag-right">
                                <nav><ul class="pagination pagination-sm mb-0" id="prPagNav"></ul></nav>
                            </div>
                        </div>

                        <!-- Patient table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="patientReportTable">
                                <thead>
                                    <tr>
                                        <th style="cursor:pointer" onclick="sortPatientReport('patientCode')">Patient ID <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_patientCode"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('firstName')">First Name <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_firstName"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('lastName')">Last Name <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_lastName"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('dob')">DOB <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_dob"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('phone')">Phone <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_phone"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('address')">Address <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_address"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('serviceDate')">Service Date <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_serviceDate"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('isActive')">Status <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_isActive"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('isNonCompanyPatient')">Patient Type <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_isNonCompanyPatient"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('Clinic.name')">Clinic <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_Clinic.name"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('Pharmacy.name')">Default Pharmacy <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_Pharmacy.name"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('PatientTransportCompany.companyName')">Patient Transport <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_PatientTransportCompany.companyName"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('PharmacyTransportCompany.companyName')">Pharmacy Transport <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_PharmacyTransportCompany.companyName"></i></th>
                                    </tr>
                                </thead>
                                <tbody id="patientReportBody">
                                    <tr><td colspan="13" class="text-center text-muted py-4">Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ═══════════════ RX ACTION REPORT TAB ═══════════════ -->
                <div class="tab-pane fade" id="rxActionReport">
                    <div class="glass-card p-4">
                        <!-- Filter header -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold small text-muted text-uppercase" style="letter-spacing:.05em">
                                <i class="fas fa-filter me-1"></i>RX Filters
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span id="rrBadge" class="badge rounded-pill bg-primary" style="display:none;font-size:.7rem">0 filters</span>
                                <button class="btn btn-link btn-sm text-muted p-0" onclick="togglePanel('rrAdv','rrChevron','rrAdvOpen')" style="font-size:.78rem;text-decoration:none">
                                    <i class="fas fa-sliders-h me-1"></i>Advanced <i class="fas fa-chevron-down ms-1" id="rrChevron"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Basic RX filters -->
                        <div class="row g-2 mb-2 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">RX #</label>
                                <input type="text" class="form-control form-control-sm" id="rrfRxId" placeholder="RX number..." autocomplete="off">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Patient First Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="rrfFirstName" placeholder="First name..." autocomplete="off">
                                    <div class="ac-list" id="ac-rrfFirstName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Patient Last Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="rrfLastName" placeholder="Last name..." autocomplete="off">
                                    <div class="ac-list" id="ac-rrfLastName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Workflow Status</label>
                                <select class="form-select form-select-sm" id="rrfProgress">
                                    <option value="">All Workflow Statuses</option>
                                    <option value="pending">Pending</option>
                                    <option value="not-started">Not Started</option>
                                    <option value="in-progress">In Progress</option>
                                    <option value="expired">Expired</option>
                                    <option value="completed">Completed</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex gap-2 align-items-end">
                                <button class="btn btn-primary btn-sm btn-search" onclick="rrPage=1;renderRxActionReport()" title="Search"><i class="fas fa-search"></i></button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="clearRxFilters()" title="Clear"><i class="fas fa-times"></i></button>
                            </div>
                            <div class="col-md-2 d-flex align-items-end gap-2">
                                <button class="btn btn-outline-success btn-sm flex-grow-1" id="exportRxCsv"><i class="fas fa-file-csv me-1"></i>CSV</button>
                                <button class="btn btn-outline-primary btn-sm" id="exportRxXls" title="Export Excel"><i class="fas fa-file-excel me-1"></i>Excel</button>
                                <button class="btn btn-outline-danger btn-sm" id="exportRxPdf" title="Export PDF (print)"><i class="fas fa-file-pdf me-1"></i>PDF</button>
                                <button class="btn btn-outline-secondary btn-sm" title="Print" id="printRxBtn"><i class="fas fa-print"></i></button>
                            </div>
                        </div>

                        <!-- Advanced RX filters -->
                        <div id="rrAdv" style="display:none;border-top:1px solid var(--border-color,#dee2e6);padding-top:10px;margin-top:2px">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Patient ID</label>
                                    <input type="text" class="form-control form-control-sm" id="rrfPatientCode" placeholder="e.g. PAT-001" autocomplete="off">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Pharmacy</label>
                                    <select class="form-select form-select-sm" id="rrfPharmacyId"><option value="">All Pharmacies</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Clinic / Location</label>
                                    <select class="form-select form-select-sm" id="rrfClinicId"><option value="">All Clinics</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Patient Type</label>
                                    <select class="form-select form-select-sm" id="rrfPatientType">
                                        <option value="">All Patient Types</option>
                                        <option value="company">Company Patients</option>
                                        <option value="non_company">Non-Company Patients</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Next Pending Stage</label>
                                    <select class="form-select form-select-sm" id="rrfWorkflowStage"><option value="">All Pending Stages</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Completed Stage</label>
                                    <select class="form-select form-select-sm" id="rrfCompletedStage"><option value="">Any Completed Stage</option></select>
                                </div>
                            </div>
                            <div class="row g-2 align-items-end mt-1">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service From</label>
                                    <input type="date" class="form-control form-control-sm" id="rxDateFrom">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service To</label>
                                    <input type="date" class="form-control form-control-sm" id="rxDateTo">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Arrival From</label>
                                    <input type="date" class="form-control form-control-sm" id="rrfArrivalFrom">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Arrival To</label>
                                    <input type="date" class="form-control form-control-sm" id="rrfArrivalTo">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Patient Transport</label>
                                    <select class="form-select form-select-sm" id="rrfPatientTransportId"><option value="">All Patient Transports</option></select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Pharmacy Transport</label>
                                    <select class="form-select form-select-sm" id="rrfPharmacyTransportId"><option value="">All Pharmacy Transports</option></select>
                                </div>
                            </div>
                            <div class="row g-2 align-items-end mt-1">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Warehouse Status</label>
                                    <select class="form-select form-select-sm" id="rrfWarehouseStatus">
                                        <option value="">All Warehouse Statuses</option>
                                        <option value="returned">Returned to Warehouse</option>
                                        <option value="not-returned">Not Returned</option>
