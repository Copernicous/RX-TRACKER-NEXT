                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="ccAttemptReportTable" style="min-width:1500px">
                                <thead>
                                    <tr>
                                        <th>Patient</th>
                                        <th>Agent / Extension</th>
                                        <th>Dialed Number</th>
                                        <th>Outcome</th>
                                        <th>SIP Response</th>
                                        <th>Dialed</th>
                                        <th>Ringing</th>
                                        <th>Answered</th>
                                        <th>Ended</th>
                                        <th>Ring</th>
                                        <th>Conversation</th>
                                    </tr>
                                </thead>
                                <tbody id="ccAttemptReportBody">
                                    <tr><td colspan="11" class="text-center text-muted py-4">Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        </div>
                        </div>
                    </div>
                </div>

            </div><!-- /tab-content -->
        </div><!-- /container-fluid -->
    </div><!-- /content -->
</div><!-- /wrapper -->

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<!-- ── Email Report Modal ─────────────────────────────────────────── -->
<div class="modal fade" id="emailReportModal" tabindex="-1" aria-labelledby="emailReportModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="emailReportModalLabel"><i class="fas fa-envelope me-2 text-primary"></i>Send Report by Email</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="emailReportStatus" class="d-none mb-3"></div>
        <div class="mb-3">
          <label class="form-label fw-bold">Report Type <span class="text-danger">*</span></label>
          <select class="form-select" id="emailRptType">
            <option value="summary">Daily Summary (stats overview)</option>
            <option value="patients">Patient List</option>
            <option value="rx-receipts">RX Records</option>
            <option value="rx-actions">Workflow Actions</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Recipient Email <span class="text-danger">*</span></label>
          <input type="email" class="form-control" id="emailRptTo" placeholder="recipient@example.com">
          <div class="form-text">Separate multiple addresses with a comma.</div>
        </div>
        <div class="mb-3">
          <label class="form-label fw-bold">Subject (optional)</label>
          <input type="text" class="form-control" id="emailRptSubject" placeholder="Leave blank for auto subject">
        </div>
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label fw-bold small">Date From (optional)</label>
            <input type="date" class="form-control form-control-sm" id="emailRptFrom">
          </div>
          <div class="col-6">
            <label class="form-label fw-bold small">Date To (optional)</label>
            <input type="date" class="form-control form-control-sm" id="emailRptTo2">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="sendEmailReportBtn">
          <span id="emailRptSpinner" class="spinner-border spinner-border-sm d-none me-1"></span>
          <i class="fas fa-paper-plane me-1" id="emailRptIcon"></i>Send Report
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>
<script src="/js/reports.js?v=<%= encodeURIComponent(String(locals.appBuild || 'dev')) %>"></script>
</body>
</html>
