<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Autocomplete dropdown */
        .ac-wrap { position: relative; }
        .ac-list {
            position: absolute; top: 100%; left: 0; right: 0; z-index: 1060;
            background: var(--card-bg, #fff);
            border: 1px solid var(--border-color, #dee2e6);
            border-radius: 6px; max-height: 200px; overflow-y: auto;
            box-shadow: 0 4px 16px rgba(0,0,0,.15); display: none;
        }
        .ac-list.open { display: block; }
        .ac-item {
            padding: 6px 12px; cursor: pointer; font-size: .85rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .ac-item:hover { background: rgba(74,144,226,.12); color: #4a90e2; }
        /* Pagination bar */
        .pag-bar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 0; margin-top: 12px; margin-bottom: 6px;
            border-top: 1px solid var(--border-color, #dee2e6);
            flex-wrap: wrap; gap: 8px;
        }
        .pag-bar .pag-left  { display: flex; align-items: center; gap: 8px; }
        .pag-bar .pag-right { display: flex; align-items: center; gap: 4px; }
    </style>
</head>
<body>
<div class="wrapper">

    <!-- Sidebar -->
    <%- include('partials/sidebar') %>
    <!-- Page Content -->
    <div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold fs-5">Reports</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">
            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="reportTabs">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#patientReport"><i class="fas fa-users me-1"></i>Patient Report</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#rxActionReport"><i class="fas fa-tasks me-1"></i>RX Action Report</a>
                </li>
                <li class="nav-item ms-auto d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-primary" id="emailReportBtn" title="Email this report">
                        <i class="fas fa-envelope me-1"></i>Email Report
                    </button>
                    <a class="btn btn-sm btn-outline-secondary" href="/audit-log"><i class="fas fa-history me-1"></i>Audit Log</a>
                </li>
            </ul>

            <div class="tab-content">

                <!-- ═══════════════ PATIENT REPORT TAB ═══════════════ -->
                <div class="tab-pane fade show active" id="patientReport">
                    <div class="glass-card p-4">
                        <!-- Filter header -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold small text-muted text-uppercase" style="letter-spacing:.05em">
                                <i class="fas fa-filter me-1"></i>Patient Filters
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span id="prBadge" class="badge rounded-pill bg-primary" style="display:none;font-size:.7rem">0 filters</span>
                                <button class="btn btn-link btn-sm text-muted p-0" onclick="togglePanel('prAdv','prChevron','prAdvOpen')" style="font-size:.78rem;text-decoration:none">
                                    <i class="fas fa-sliders-h me-1"></i>Advanced <i class="fas fa-chevron-down ms-1" id="prChevron"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Basic filters row -->
                        <div class="row g-2 mb-2 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Patient ID</label>
                                <input type="text" class="form-control form-control-sm" id="prfPatientCode" placeholder="e.g. PAT-001" autocomplete="off">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">First Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="prfFirstName" placeholder="First name..." autocomplete="off">
                                    <div class="ac-list" id="ac-prfFirstName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Last Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="prfLastName" placeholder="Last name..." autocomplete="off">
                                    <div class="ac-list" id="ac-prfLastName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Status</label>
                                <select class="form-select form-select-sm" id="patientStatusFilter">
                                    <option value="">All</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex gap-2 align-items-end">
                                <button class="btn btn-primary btn-sm flex-grow-1" onclick="prPage=1;renderPatientReport()"><i class="fas fa-search me-1"></i>Search</button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="clearPatientFilters()" title="Clear"><i class="fas fa-times"></i></button>
                            </div>
                            <div class="col-md-2 d-flex align-items-end gap-2">
                                <button class="btn btn-outline-success btn-sm flex-grow-1" id="exportPatientCsv"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
                                <button class="btn btn-outline-secondary btn-sm" title="Print" onclick="printReport('Patient Report','patientReportTable')"><i class="fas fa-print"></i></button>
                            </div>
                        </div>

                        <!-- Advanced filters -->
                        <div id="prAdv" style="display:none;border-top:1px solid var(--border-color,#dee2e6);padding-top:10px;margin-top:2px">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Phone</label>
                                    <input type="text" class="form-control form-control-sm" id="prfPhone" placeholder="Phone..." autocomplete="off">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Transport</label>
                                    <div class="ac-wrap">
                                        <input type="text" class="form-control form-control-sm" id="prfTransport" placeholder="Transport..." autocomplete="off">
                                        <div class="ac-list" id="ac-prfTransport"></div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Clinic</label>
                                    <div class="ac-wrap">
                                        <input type="text" class="form-control form-control-sm" id="prfClinic" placeholder="Clinic name..." autocomplete="off">
                                        <div class="ac-list" id="ac-prfClinic"></div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service From</label>
                                    <input type="date" class="form-control form-control-sm" id="patientDateFrom">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service To</label>
                                    <input type="date" class="form-control form-control-sm" id="patientDateTo">
                                </div>
                            </div>
                        </div>

                        <!-- ── Pagination bar TOP ── -->
                        <div class="pag-bar" id="prPagBar">
                            <div class="pag-left">
                                <label class="small text-muted mb-0">Show</label>
                                <select class="form-select form-select-sm" style="width:auto" id="prPageSize" onchange="prChangeSize(this.value)">
                                    <option value="10" selected>10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="small text-muted" id="patientReportCount"></span>
                            </div>
                            <div class="pag-right">
                                <nav><ul class="pagination pagination-sm mb-0" id="prPagNav"></ul></nav>
                            </div>
                        </div>

                        <!-- Patient table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="patientReportTable">
                                <thead>
                                    <tr>
                                        <th style="cursor:pointer" onclick="sortPatientReport('patientCode')">Patient ID <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_patientCode"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('firstName')">First Name <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_firstName"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('lastName')">Last Name <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_lastName"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('dob')">DOB <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_dob"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('phone')">Phone <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_phone"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('address')">Address <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_address"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('serviceDate')">Service Date <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_serviceDate"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('isActive')">Status <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_isActive"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('Clinic.name')">Clinic <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_Clinic.name"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('PatientTransportCompany.companyName')">Patient Transport <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_PatientTransportCompany.companyName"></i></th>
                                        <th style="cursor:pointer" onclick="sortPatientReport('PharmacyTransportCompany.companyName')">Pharmacy Transport <i class="fas fa-sort text-muted" style="opacity:.3" id="prIcon_PharmacyTransportCompany.companyName"></i></th>
                                    </tr>
                                </thead>
                                <tbody id="patientReportBody">
                                    <tr><td colspan="11" class="text-center text-muted py-4">Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ═══════════════ RX ACTION REPORT TAB ═══════════════ -->
                <div class="tab-pane fade" id="rxActionReport">
                    <div class="glass-card p-4">
                        <!-- Filter header -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold small text-muted text-uppercase" style="letter-spacing:.05em">
                                <i class="fas fa-filter me-1"></i>RX Filters
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span id="rrBadge" class="badge rounded-pill bg-primary" style="display:none;font-size:.7rem">0 filters</span>
                                <button class="btn btn-link btn-sm text-muted p-0" onclick="togglePanel('rrAdv','rrChevron','rrAdvOpen')" style="font-size:.78rem;text-decoration:none">
                                    <i class="fas fa-sliders-h me-1"></i>Advanced <i class="fas fa-chevron-down ms-1" id="rrChevron"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Basic RX filters -->
                        <div class="row g-2 mb-2 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">RX #</label>
                                <input type="text" class="form-control form-control-sm" id="rrfRxId" placeholder="RX number..." autocomplete="off">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Patient First Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="rrfFirstName" placeholder="First name..." autocomplete="off">
                                    <div class="ac-list" id="ac-rrfFirstName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Patient Last Name</label>
                                <div class="ac-wrap">
                                    <input type="text" class="form-control form-control-sm" id="rrfLastName" placeholder="Last name..." autocomplete="off">
                                    <div class="ac-list" id="ac-rrfLastName"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold mb-1">Progress</label>
                                <select class="form-select form-select-sm" id="rrfProgress">
                                    <option value="">All</option>
                                    <option value="complete">Complete</option>
                                    <option value="pending">Pending</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex gap-2 align-items-end">
                                <button class="btn btn-primary btn-sm flex-grow-1" onclick="rrPage=1;renderRxActionReport()"><i class="fas fa-search me-1"></i>Search</button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="clearRxFilters()" title="Clear"><i class="fas fa-times"></i></button>
                            </div>
                            <div class="col-md-2 d-flex align-items-end gap-2">
                                <button class="btn btn-outline-success btn-sm flex-grow-1" id="exportRxCsv"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
                                <button class="btn btn-outline-secondary btn-sm" title="Print" onclick="printReport('RX Records Report','rxReportTable')"><i class="fas fa-print"></i></button>
                            </div>
                        </div>

                        <!-- Advanced RX filters -->
                        <div id="rrAdv" style="display:none;border-top:1px solid var(--border-color,#dee2e6);padding-top:10px;margin-top:2px">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Patient ID</label>
                                    <input type="text" class="form-control form-control-sm" id="rrfPatientCode" placeholder="e.g. PAT-001" autocomplete="off">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1">Pharmacy</label>
                                    <div class="ac-wrap">
                                        <input type="text" class="form-control form-control-sm" id="rrfPharmacy" placeholder="Pharmacy name..." autocomplete="off">
                                        <div class="ac-list" id="ac-rrfPharmacy"></div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service From</label>
                                    <input type="date" class="form-control form-control-sm" id="rxDateFrom">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold mb-1"><i class="fas fa-calendar me-1"></i>Service To</label>
                                    <input type="date" class="form-control form-control-sm" id="rxDateTo">
                                </div>
                            </div>
                        </div>

                        <!-- ── Pagination bar TOP ── -->
                        <div class="pag-bar" id="rrPagBar">
                            <div class="pag-left">
                                <label class="small text-muted mb-0">Show</label>
                                <select class="form-select form-select-sm" style="width:auto" id="rrPageSize" onchange="rrChangeSize(this.value)">
                                    <option value="10" selected>10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="small text-muted" id="rxReportCount"></span>
                            </div>
                            <div class="pag-right">
                                <nav><ul class="pagination pagination-sm mb-0" id="rrPagNav"></ul></nav>
                            </div>
                        </div>

                        <!-- RX table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="rxReportTable">
                                <thead>
                                    <tr>
                                        <th style="cursor:pointer" onclick="sortRxReport('id')">RX # <i class="fas fa-sort text-muted" style="opacity:.3" id="rrIcon_id"></i></th>
                                        <th style="cursor:pointer" onclick="sortRxReport('Patient.firstName')">Patient <i class="fas fa-sort text-muted" style="opacity:.3" id="rrIcon_Patient.firstName"></i></th>
                                        <th style="cursor:pointer" onclick="sortRxReport('Patient.patientCode')">Patient ID <i class="fas fa-sort text-muted" style="opacity:.3" id="rrIcon_Patient.patientCode"></i></th>
                                        <th style="cursor:pointer" onclick="sortRxReport('Pharmacy.name')">Pharmacy <i class="fas fa-sort text-muted" style="opacity:.3" id="rrIcon_Pharmacy.name"></i></th>
                                        <th style="cursor:pointer" onclick="sortRxReport('serviceDate')">Service Date <i class="fas fa-sort text-muted" style="opacity:.3" id="rrIcon_serviceDate"></i></th>
                                        <th>Completed Steps</th>
                                        <th>Next Pending</th>
                                        <th>Progress</th>
                                    </tr>
                                </thead>
                                <tbody id="rxActionBody">
                                    <tr><td colspan="8" class="text-center text-muted py-4">Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div><!-- /tab-content -->
        </div><!-- /container-fluid -->
    </div><!-- /content -->
</div><!-- /wrapper -->

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>
<script src="/js/reports.js"></script>
</body>
</html>
