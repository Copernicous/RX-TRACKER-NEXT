<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', async () => {
        initApp();
        const user = JSON.parse(localStorage.getItem('user') || '{}');
        if (user.role !== 'Administrator') {
            document.getElementById('accessDeniedPanel').classList.remove('d-none');
        } else {
            document.getElementById('backupPanel').classList.remove('d-none');
            await loadStatus();
            await loadSiteStatus();
            await loadBackupConfig();
        }
    });

    async function loadStatus() {
        const res = await fetchWithAuth(window.rxUrl('/api/backups/status'));
        if (!res || !res.ok) { showToast('Failed to load backup status', 'danger'); return; }
        const data = await res.json();

        // Status card
        document.getElementById('statusContent').innerHTML =
            '<div class="d-flex flex-column gap-2">' +
                '<div class="d-flex justify-content-between"><span class="text-muted small">Schedule</span>' +
                    '<code class="small">' + (data.schedule === 'off' ? '<span class="text-danger">Disabled</span>' : data.schedule) + '</code>' +
                '</div>' +
                '<div class="d-flex justify-content-between"><span class="text-muted small">Backup Directory</span>' +
                    '<small class="text-truncate ms-2" style="max-width:180px" title="' + data.backupDir + '">' + data.backupDir.split(/[\\/]/).pop() + '</small>' +
                '</div>' +
                '<div class="d-flex justify-content-between"><span class="text-muted small">Max Retained</span>' +
                    '<strong>' + data.maxBackups + ' backups</strong>' +
                '</div>' +
                '<div class="d-flex justify-content-between"><span class="text-muted small">Total Records</span>' +
                    '<strong>' + data.recentBackups.length + '</strong>' +
                '</div>' +
            '</div>';

        // Set cron input
        document.getElementById('cronInput').value = data.schedule || '';

        // History table
        renderHistory(data.recentBackups, data.backupDir);
    }

    function renderHistory(backups, backupDir) {
        const el = document.getElementById('historyContent');
        if (!backups.length) {
            el.innerHTML = '<p class="text-center text-muted py-4">No backups recorded yet.</p>';
            return;
        }
        var rows = backups.map(function(b) {
            var icon   = b.status === 'success' ? 'check-circle' : 'times-circle';
            var cls    = b.status === 'success' ? 'status-success' : 'status-failed';
            var size   = b.size ? (b.size / 1024).toFixed(1) + ' KB' : '—';
            var dt     = b.timestamp ? new Date(b.timestamp).toLocaleString() : '—';
            // Filename + path cell
            var fullPath = (b.filepath) ? b.filepath
                         : (b.filename && backupDir) ? backupDir.replace(/[\\/]$/, '') + '\\' + b.filename
                         : null;
            var fileCell = b.filename
                ? '<span class="font-monospace" style="font-size:.78rem;word-break:break-all;" title="' + (fullPath || b.filename) + '">' +
                  b.filename + '</span>' +
                  (fullPath ? '<br><small class="text-muted" style="font-size:.72rem;word-break:break-all;">' + fullPath + '</small>' : '')
                : '<span class="text-muted">—</span>';
            var dlBtn  = (b.status === 'success' && b.filename)
                ? '<a class="btn btn-sm btn-outline-primary me-1" href="/api/backups/download/' + b.filename + '" title="Download"><i class="fas fa-download"></i></a>'
                : '';
            var fn = b.filename ? b.filename.replace(/'/g,'') : '';
            var delBtn = '<button class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteBackupEntry(\'' + fn + '\', ' + (b.id || 0) + ')">' +
                         '<i class="fas fa-trash-alt"></i></button>';
            return '<tr class="backup-row">' +
                '<td><i class="fas fa-' + icon + ' ' + cls + ' me-2"></i><strong class="' + cls + '">' + b.status + '</strong></td>' +
                '<td><small>' + dt + '</small></td>' +
                '<td><small class="text-muted">' + (b.triggeredBy || '—') + '</small></td>' +
                '<td>' + fileCell + '</td>' +
                '<td><small>' + size + '</small></td>' +
                '<td>' + (b.error ? '<span class="badge bg-danger" title="' + b.error + '">error</span>' : '') + '</td>' +
                '<td class="text-nowrap">' + dlBtn + delBtn + '</td>' +
                '</tr>';
        }).join('');
        el.innerHTML =
            '<div class="table-responsive">' +
            '<table class="table table-sm align-middle">' +
            '<thead><tr><th>Status</th><th>Timestamp</th><th>Triggered By</th><th>File / Path</th><th>Size</th><th>Error</th><th>Actions</th></tr></thead>' +
            '<tbody>' + rows + '</tbody>' +
            '</table></div>';
    }

    async function deleteBackupEntry(filename, id) {
        var label = filename || 'this failed entry';
        if (!confirm('Permanently delete ' + label + '?\n\n' + (filename ? 'The .dump file and its history entry will both be removed.' : 'This failed history entry will be removed.'))) return;
        var r;
        if (filename) {
            r = await fetchWithAuth(window.rxUrl('/api/backups/' + encodeURIComponent(filename)), { method: 'DELETE' });
        } else if (id) {
            r = await fetchWithAuth(window.rxUrl('/api/backups/history/' + id), { method: 'DELETE' });
        } else {
            await loadStatus(); return;
        }
        if (r && (r.status === 204 || r.ok)) {
            showToast('Backup entry deleted.', 'success');
        } else {
            showToast('Failed to delete backup entry.', 'danger');
        }
        await loadStatus();
    }

    async function runBackup() {
        const btn     = document.getElementById('runBackupBtn');
        const spinner = document.getElementById('runSpinner');
        const icon    = document.getElementById('runIcon');
        btn.disabled  = true;
        spinner.classList.remove('d-none');
        icon.classList.add('d-none');

        showToast('Running backup\u2026 this may take a moment.', 'info');
        const res = await fetchWithAuth(window.rxUrl('/api/backups/run'), { method: 'POST' });
        btn.disabled = false;
        spinner.classList.add('d-none');
        icon.classList.remove('d-none');

        if (!res || !res.ok) { showToast('Backup request failed', 'danger'); return; }
        const result = await res.json();

        if (result.status === 'success') {
            showToast('Backup completed successfully! (' + (result.size/1024).toFixed(1) + ' KB)', 'success');
        } else {
            showToast('Backup failed: ' + (result.error || 'unknown error'), 'danger');
        }
        await loadStatus();
    }

    function setSchedule(expr) {
        document.getElementById('cronInput').value = expr;
    }

    async function saveSchedule() {
        const schedule = document.getElementById('cronInput').value.trim();
        const res = await fetchWithAuth(window.rxUrl('/api/backups/schedule'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ schedule })
        });
        if (!res) { showToast('Request failed (no response)', 'danger'); return; }
        if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            showToast('Schedule not saved: ' + (body.error || 'unknown error'), 'danger');
            await loadStatus(); // reload to show current (unchanged) schedule
            return;
        }
        const data = await res.json();
        showToast('Schedule saved: ' + (data.schedule === 'off' ? 'Disabled' : data.schedule), 'success');
        await loadStatus();
    }

    // ═══════════════════════════════════════════════════════════════
    // FULL SITE BACKUP JS
    // ═══════════════════════════════════════════════════════════════
    async function loadSiteStatus() {
        const res = await fetchWithAuth(window.rxUrl('/api/backups/site/status'));
        if (!res || !res.ok) return;
        const data = await res.json();

        // Update dir label
        const dirEl = document.getElementById('siteBackupDirLabel');
        if (dirEl) dirEl.textContent = data.backupDir || 'C:\\RX-SiteBackups\\';

        // Status summary
        const sc = document.getElementById('siteStatusContent');
        if (sc) {
            sc.innerHTML =
                '<div class="d-flex justify-content-between"><span class="text-muted small">Schedule</span>' +
                '<code class="small">' + (data.schedule === 'off' ? '<span class="text-danger">Disabled</span>' : data.schedule) + '</code></div>' +
                '<div class="d-flex justify-content-between"><span class="text-muted small">Save Location</span>' +
                '<small class="text-truncate ms-2" style="max-width:160px" title="' + (data.backupDir||'') + '">' + (data.backupDir||'').split(/[\\/]/).pop() + '</small></div>' +
                '<div class="d-flex justify-content-between"><span class="text-muted small">ZIPs Kept</span>' +
                '<strong>' + data.maxBackups + ' max</strong></div>' +
                '<div class="d-flex justify-content-between"><span class="text-muted small">Backups Made</span>' +
                '<strong>' + (data.recentBackups ? data.recentBackups.length : 0) + '</strong></div>';
        }

        // Set cron input
        const ci = document.getElementById('siteCronInput');
        if (ci) ci.value = data.schedule || '0 3 * * 0';

        // History
        renderSiteHistory(data.recentBackups || []);
    }

    function renderSiteHistory(backups) {
        const el = document.getElementById('siteHistoryContent');
        if (!el) return;
        if (!backups.length) {
            el.innerHTML = '<p class="text-center text-muted py-3 small">No site backups yet. Click "Create Full Site Backup Now" to generate the first one.</p>';
            return;
        }
        const rows = backups.map(function(b) {
            const icon  = b.status === 'success' ? 'check-circle' : 'times-circle';
            const cls   = b.status === 'success' ? 'status-success' : 'status-failed';
            const size  = b.size ? (b.size > 1048576 ? (b.size/1048576).toFixed(1) + ' MB' : (b.size/1024).toFixed(1) + ' KB') : '\u2014';
            const dt    = b.timestamp ? new Date(b.timestamp).toLocaleString() : '\u2014';
            const dl    = (b.status === 'success' && b.filename)
                ? '<a class="btn btn-sm btn-outline-primary me-1" href="/api/backups/site/download/' + b.filename + '" title="Download ZIP"><i class="fas fa-download me-1"></i>ZIP</a>'
                : '';
            const fn = b.filename ? b.filename.replace(/'/g,'') : '';
            const delBtn = '<button class="btn btn-sm btn-outline-danger" title="Delete ZIP and history entry" onclick="deleteSiteBackupEntry(\'' + fn + '\', ' + (b.id || 0) + ')">' +
                           '<i class="fas fa-trash-alt"></i></button>';
            return '<tr class="backup-row">' +
                '<td><i class="fas fa-' + icon + ' ' + cls + ' me-2"></i><strong class="' + cls + '">' + b.status + '</strong></td>' +
                '<td><small>' + dt + '</small></td>' +
                '<td><small class="text-muted">' + (b.triggeredBy || '\u2014') + '</small></td>' +
                '<td><small><strong>' + size + '</strong></small></td>' +
                '<td>' + (b.error ? '<span class="badge bg-danger" title="' + b.error + '">error</span>' : '') + '</td>' +
                '<td class="text-nowrap">' + dl + delBtn + '</td>' +
                '</tr>';
        }).join('');
        el.innerHTML =
            '<div class="table-responsive">' +
            '<table class="table table-sm align-middle">' +
            '<thead><tr><th>Status</th><th>Timestamp</th><th>Triggered By</th><th>Size</th><th>Error</th><th>Actions</th></tr></thead>' +
            '<tbody>' + rows + '</tbody>' +
            '</table></div>';
    }

    async function deleteSiteBackupEntry(filename, id) {
        var label = filename || 'this failed entry';
        if (!confirm('Permanently delete ' + label + '?\n\n' + (filename ? 'The ZIP file and its history entry will both be removed.' : 'This failed history entry will be removed.'))) return;
        var r;
        if (filename) {
            r = await fetchWithAuth(window.rxUrl('/api/backups/site/' + encodeURIComponent(filename)), { method: 'DELETE' });
        } else if (id) {
            r = await fetchWithAuth(window.rxUrl('/api/backups/site/history/' + id), { method: 'DELETE' });
        } else {
            await loadSiteStatus(); return;
        }
        if (r && (r.status === 204 || r.ok)) {
            showToast('Backup entry deleted.', 'success');
        } else {
            showToast('Failed to delete backup entry.', 'danger');
        }
        await loadSiteStatus();
    }


    async function runSiteBackup() {
        const btn     = document.getElementById('runSiteBackupBtn');
        const spinner = document.getElementById('siteSpinner');
        const icon    = document.getElementById('siteIcon');
        btn.disabled  = true;
        spinner.classList.remove('d-none');
        icon.classList.add('d-none');
        showToast('Creating full site backup\u2026 this may take 30\u201360 seconds.', 'info');

        const res = await fetchWithAuth(window.rxUrl('/api/backups/site/run'), { method: 'POST' });
        btn.disabled = false;
        spinner.classList.add('d-none');
        icon.classList.remove('d-none');

        if (!res || !res.ok) { showToast('Site backup request failed', 'danger'); return; }
        const result = await res.json();
        if (result.status === 'success') {
            const sz = result.size > 1048576 ? (result.size/1048576).toFixed(1) + ' MB' : (result.size/1024).toFixed(1) + ' KB';
            showToast('\u2705 Site backup created! (' + sz + ') — saved to C:\\RX-SiteBackups\\', 'success');
        } else {
            showToast('Site backup failed: ' + (result.error || 'unknown error'), 'danger');
        }
        await loadSiteStatus();
    }

    function setSiteSchedule(expr) {
        const ci = document.getElementById('siteCronInput');
        if (ci) ci.value = expr;
    }

    async function saveSiteSchedule() {
        const schedule = (document.getElementById('siteCronInput').value || '').trim();
        const res = await fetchWithAuth(window.rxUrl('/api/backups/site/schedule'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ schedule })
        });
        if (!res) { showToast('Request failed (no response)', 'danger'); return; }
        if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            showToast('Site schedule not saved: ' + (body.error || 'unknown error'), 'danger');
            await loadSiteStatus();
            return;
        }
        const data = await res.json();
        showToast('Site backup schedule: ' + (data.schedule === 'off' ? 'Disabled' : data.schedule), 'success');
        await loadSiteStatus();
    }

    // ── Restore Guide Toggle ──────────────────────────────────────────
    function toggleRestoreGuide() {
        const body  = document.getElementById('restoreGuideBody');
        const chev  = document.getElementById('restoreGuideChev');
        const btn   = document.getElementById('restoreGuideToggleBtn');
        const open  = body.style.display === 'none' || body.style.display === '';
        body.style.display = open ? 'block' : 'none';
        chev.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
        btn.innerHTML = '<i class="fas fa-chevron-' + (open ? 'up' : 'down') + ' me-1" id="restoreGuideChev" style="transform:' + (open ? 'rotate(180deg)' : 'none') + '"></i>' + (open ? 'Hide Guide' : 'Show Guide');
    }

    function showRestoreTab(tabId) {
        var tabs = ['fromBackup', 'freshInstall'];
        tabs.forEach(function(t) {
            var panel = document.getElementById('restorePanel-' + t);
            var link  = document.getElementById('tab-' + t);
            if (panel) panel.style.display = (t === tabId) ? 'block' : 'none';
            if (link) {
                link.classList.toggle('active', t === tabId);
            }
        });
    }

    async function loadBackupConfig() {
        var res = await fetchWithAuth(window.rxUrl('/api/backups/config'));
        if (!res || !res.ok) return;
        var cfg = await res.json();
        var dbEl    = document.getElementById('dbBackupDirLabel');
        var dbInp   = document.getElementById('dbBackupDirInput');
        var siteEl  = document.getElementById('siteBackupDirLabelInfo');
        var siteInp = document.getElementById('siteBackupDirInput');
        var oldLbl  = document.getElementById('siteBackupDirLabel');
        if (dbEl)    dbEl.textContent    = cfg.dbBackupDir   || '—';
        if (dbInp)   dbInp.value         = cfg.dbBackupDir   || '';
        if (siteEl)  siteEl.textContent  = cfg.siteBackupDir || '—';
        if (siteInp) siteInp.value       = cfg.siteBackupDir || '';
        if (oldLbl)  oldLbl.textContent  = cfg.siteBackupDir || '—';
    }

    async function saveDbBackupDir() {
        var inp = document.getElementById('dbBackupDirInput');
        if (!inp || !inp.value.trim()) { showToast('Please enter a folder path.', 'warning'); return; }
        var newDir = inp.value.trim();
        var res = await fetchWithAuth(window.rxUrl('/api/backups/config'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dbBackupDir: newDir })
        });
        if (!res || !res.ok) {
            var err = {}; try { err = await res.json(); } catch {}
            showToast('Failed: ' + (err.error || 'unknown error'), 'danger'); return;
        }
        showToast('✅ DB backup folder updated to: ' + newDir, 'success');
        await loadBackupConfig();
        await loadStatus();
    }

    async function saveSiteBackupDir() {
        var inp = document.getElementById('siteBackupDirInput');
        if (!inp || !inp.value.trim()) { showToast('Please enter a folder path.', 'warning'); return; }
        var newDir = inp.value.trim();
        var res = await fetchWithAuth(window.rxUrl('/api/backups/config'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ siteBackupDir: newDir })
        });
        if (!res || !res.ok) {
            var err = {}; try { err = await res.json(); } catch {}
            showToast('Failed: ' + (err.error || 'unknown error'), 'danger'); return;
        }
        showToast('\u2705 Site backup folder updated to: ' + newDir, 'success');
        await loadBackupConfig();
        await loadSiteStatus();
    }

    // ── Restore UI logic ─────────────────────────────────────────────────────
    document.getElementById('restoreDumpFile').addEventListener('change', checkRestoreReady);
    document.getElementById('restoreConfirmInput').addEventListener('input', checkRestoreReady);

    function checkRestoreReady() {
        var file    = document.getElementById('restoreDumpFile').files[0];
        var confirm = document.getElementById('restoreConfirmInput').value.trim();
        var btn     = document.getElementById('restoreStartBtn');
        btn.disabled = !(file && confirm === 'RESTORE');
    }

    function startRestore() {
        var file = document.getElementById('restoreDumpFile').files[0];
        if (!file) { showToast('Please select a .dump file', 'warning'); return; }
        if (document.getElementById('restoreConfirmInput').value.trim() !== 'RESTORE') {
            showToast('Type RESTORE in the confirmation box to proceed', 'warning'); return;
        }
        if (!confirm('⚠️ This will replace ALL data on this server with the uploaded backup.\n\nA safety backup will be taken first, but this is irreversible.\n\nContinue?')) return;

        var btn        = document.getElementById('restoreStartBtn');
        var progress   = document.getElementById('restoreProgressWrap');
        var bar        = document.getElementById('restoreProgressBar');
        var pctLabel   = document.getElementById('restoreProgressPct');
        var statusLbl  = document.getElementById('restoreProgressLabel');
        var logBox     = document.getElementById('restoreLogBox');
        var badge      = document.getElementById('restoreResultBadge');

        btn.disabled   = true;
        progress.style.display = 'block';
        badge.style.display    = 'none';
        logBox.textContent     = 'Uploading ' + file.name + ' (' + (file.size / 1024 / 1024).toFixed(1) + ' MB)…\n';
        bar.style.width        = '0%';
        pctLabel.textContent   = '0%';
        statusLbl.textContent  = 'Uploading…';

        var token = (document.cookie.match(/rxToken=([^;]+)/) || [])[1] || '';
        var fd    = new FormData();
        fd.append('dumpFile', file);

        var xhr = new XMLHttpRequest();
        xhr.open('POST', window.rxUrl('/api/backups/restore'));
        xhr.setRequestHeader('Authorization', 'Bearer ' + token);

        xhr.upload.onprogress = function(e) {
            if (e.lengthComputable) {
                var pct = Math.round(e.loaded / e.total * 80); // upload = 0–80%
                bar.style.width      = pct + '%';
                pctLabel.textContent = pct + '%';
            }
        };

        xhr.onload = function() {
            bar.style.width      = '100%';
            pctLabel.textContent = '100%';
            statusLbl.textContent = 'Done';
            btn.disabled = false;

            var result = {};
            try { result = JSON.parse(xhr.responseText); } catch {}

            if (xhr.status === 200 && result.status === 'success') {
                badge.innerHTML = '<span class="badge bg-success fs-6"><i class="fas fa-check-circle me-1"></i>Restore Completed Successfully</span>';
                badge.style.display = 'block';
                logBox.textContent = '✅ RESTORE SUCCESSFUL\n\n' + (result.log || '(no output)');
                showToast('✅ Database restored successfully!', 'success');
                loadStatus();
            } else {
                var errMsg = result.error || 'Unknown error (HTTP ' + xhr.status + ')';
                badge.innerHTML = '<span class="badge bg-danger fs-6"><i class="fas fa-times-circle me-1"></i>Restore Failed</span>';
                badge.style.display = 'block';
                logBox.textContent = '❌ RESTORE FAILED\n\n' + errMsg + '\n\n' + (result.log || '');
                showToast('Restore failed: ' + errMsg, 'danger');
                bar.classList.remove('bg-danger');
                bar.classList.add('bg-danger');
            }
        };

        xhr.onerror = function() {
            btn.disabled = false;
            logBox.textContent = '❌ Network error — could not reach server.';
            showToast('Network error during restore', 'danger');
        };

        statusLbl.textContent = 'Uploading & running pg_restore…';
        xhr.send(fd);
    }

</script>
</body>
</html>
