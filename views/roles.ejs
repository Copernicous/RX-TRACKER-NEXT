<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roles Management - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>
    <!-- Page Content -->
    <div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold fs-5"><i class="fas fa-shield-alt me-2 text-warning"></i>Roles Management</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">

            <!-- Roles List Card -->
            <div class="glass-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="mb-1">All Roles</h5>
                        <p class="text-muted small mb-0">Manage roles and their permissions. Assign users to roles via <a href="/users">User Management</a>.</p>
                    </div>
                    <button class="btn btn-success btn-sm" onclick="openRoleModal(null)">
                        <i class="fas fa-plus me-1"></i>Create New Role
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="rolesTable">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th>Description</th>
                                <th class="text-center">Users</th>
                                <th class="text-center">Type</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="rolesTableBody">
                            <tr><td colspan="5" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Permissions Reference Card -->
            <div class="glass-card p-4">
                <h5 class="mb-3"><i class="fas fa-table me-2 text-info"></i>Role Permissions Overview</h5>
                <p class="text-muted small mb-3">Quick reference showing what each role can do by default. Edit any role above to customise.</p>
                <div id="permMatrixContainer">
                    <p class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading matrix...</p>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Role Edit/Create Modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="roleModalTitle"><i class="fas fa-shield-alt me-2 text-warning"></i>Create Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Role Info -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="roleNameInput" placeholder="e.g. Pharmacist, Billing Clerk">
                        <div class="form-text text-danger d-none" id="roleNameError"></div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Description</label>
                        <input type="text" class="form-control" id="roleDescInput" placeholder="Brief description of this role's responsibilities">
                    </div>
                </div>

                <!-- Copy from role -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Start from a template</label>
                    <div class="d-flex gap-2 flex-wrap" id="roleTemplateButtons"></div>
                    <div class="form-text">Click a role to copy its permissions as your starting point, then adjust below.</div>
                </div>

                <hr>

                <!-- Permission Matrix Editor -->
                <label class="form-label fw-bold"><i class="fas fa-key me-2"></i>Permissions</label>
                <p class="text-muted small">Configure exactly what this role can see and do in each section of the system.</p>
                <p class="text-muted small mb-2">
                    <strong>RX Records note:</strong> adding a new RX record and completing RX workflow steps are controlled by
                    <strong>Add RX / Complete</strong>. The separate <strong>Add New</strong> column is not used for RX Records.
                </p>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle" id="permEditorTable" style="font-size:.85rem">
                        <thead class="table-dark">
                            <tr>
                                <th style="min-width:180px">Section</th>
                                <th class="text-center" style="width:70px" title="Can see this section in the menu">Visible</th>
                                <th class="text-center" style="width:80px" title="Can CREATE new records (POST). RX Records uses Add RX / Complete instead.">Add New</th>
                                <th class="text-center" style="width:70px" title="Can EDIT existing records (PUT)">Edit</th>
                                <th class="text-center" style="width:70px" title="Can delete records">Delete</th>
                                <th class="text-center" style="width:70px" title="Can export data to CSV">Export</th>
                                <th class="text-center" style="width:70px" title="Can print or save PDF from app print buttons">Print</th>
                                <th class="text-center" style="width:70px" title="Can select and copy visible screen data">Copy</th>
                                <th class="text-center" style="width:105px" title="RX Records only: can add RX records and complete workflow steps">Add RX / Complete</th>
                                <th class="text-center" style="width:70px" title="Can undo the last workflow step (RX Records only)">Undo</th>
                                <th class="text-center" style="width:90px" title="Can return RX to warehouse (RX Records only)">Warehouse</th>
                                <th class="text-center" style="width:90px" title="Can override 90-day expired locks">Override</th>
                                <th class="text-center" style="width:90px" title="RX Records only: can view driver assignment history">Driver History</th>
                                <th class="text-center" style="width:90px" title="RX Records only: can change the current driver">Assign Driver</th>
                                <th class="text-center" style="width:90px" title="RX Records only: can correct one completed stage driver">Correct Driver</th>
                                <th class="text-center" style="width:90px" title="RX Records only: can synchronize all completed stages to the current driver">Sync Drivers</th>
                            </tr>
                        </thead>
                        <tbody id="permEditorBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveRoleBtn" onclick="saveRole()">
                    <span id="saveRoleSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    <i class="fas fa-save me-1"></i>Save Role
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteRoleModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Delete Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="deleteRoleBody">Are you sure?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="confirmDeleteRoleBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<script src="/js/base.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>

<script src="/js/roles.js"></script>

</body>
</html>
