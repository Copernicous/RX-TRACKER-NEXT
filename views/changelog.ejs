<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Changelog - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <!-- marked.js for markdown rendering -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        .changelog-body h2 {
            font-size: 1.15rem; font-weight: 700;
            border-bottom: 2px solid var(--primary, #4a90e2);
            padding-bottom: 6px; margin-top: 2rem; margin-bottom: 1rem;
            color: var(--text, #1e293b);
        }
        .changelog-body h3 {
            font-size: .95rem; font-weight: 700;
            margin-top: 1.2rem; margin-bottom: .5rem;
            color: var(--text-muted, #64748b);
        }
        .changelog-body ul {
            padding-left: 1.4rem; margin-bottom: .75rem;
        }
        .changelog-body li {
            margin-bottom: .35rem; font-size: .88rem; line-height: 1.6;
        }
        .changelog-body code {
            font-size: .82rem;
            background: rgba(99,102,241,.09);
            padding: 1px 5px; border-radius: 4px;
            color: #4f46e5;
        }
        [data-theme="dark"] .changelog-body code {
            background: rgba(99,102,241,.18);
            color: #a5b4fc;
        }
        .changelog-body strong { font-weight: 700; }
        .changelog-body hr { margin: 2rem 0; opacity: .15; }
        .version-pill {
            display: inline-block;
            background: linear-gradient(135deg,#4a90e2,#357abd);
            color: #fff; border-radius: 20px;
            padding: 2px 12px; font-size: .72rem; font-weight: 700;
            letter-spacing: .04em; margin-right: 8px; vertical-align: middle;
        }
        .section-icon { margin-right: 6px; }
        /* map emoji-style headings to colors */
        .changelog-body h3:has-text { color: inherit; }
    </style>
</head>
<body>
<div class="wrapper">
    <%- include('partials/sidebar') %>
    <div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold fs-5"><i class="fas fa-scroll me-2 text-primary"></i>Changelog</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">
            <div class="row justify-content-center">
                <div class="col-lg-9">

                    <!-- Header card -->
                    <div class="glass-card p-4 mb-4" style="border-left:4px solid var(--primary,#4a90e2);">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:48px;height:48px;border-radius:14px;
                                background:linear-gradient(135deg,#4a90e2,#357abd);
                                display:flex;align-items:center;justify-content:center;
                                font-size:1.4rem;color:#fff;flex-shrink:0;">
                                <i class="fas fa-code-branch"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Application Changelog</h5>
                                <p class="text-muted small mb-0">
                                    Version history, new features, bug fixes and improvements.
                                    Current version: <strong id="currentVersion">—</strong>
                                </p>
                            </div>
                            <div class="ms-auto text-end">
                                <div class="text-muted small">Server uptime</div>
                                <div class="fw-bold" id="uptimeDisplay">—</div>
                            </div>
                        </div>
                    </div>

                    <!-- Changelog content -->
                    <div class="glass-card p-4 p-lg-5">
                        <div class="changelog-body" id="changelogContent">
                            <div class="text-center text-muted py-5">
                                <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                                <div>Loading changelog…</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', async () => {
        initApp();

        // Load version info
        try {
            const vr = await fetch(window.rxUrl('/api/version'));
            const vd = await vr.json();
            document.getElementById('currentVersion').textContent = 'v' + vd.version;

            // Format uptime
            const s = vd.uptime;
            const h = Math.floor(s / 3600);
            const m = Math.floor((s % 3600) / 60);
            document.getElementById('uptimeDisplay').textContent =
                h > 0 ? h + 'h ' + m + 'm' : m + 'm';
        } catch {}

        // Render markdown
        const raw = `<%- markdown.replace(/`/g, '\\`').replace(/\$/g, '\\$') %>`;
        if (raw.trim()) {
            document.getElementById('changelogContent').innerHTML = marked.parse(raw);
        } else {
            document.getElementById('changelogContent').innerHTML =
                '<p class="text-muted text-center py-4">No CHANGELOG.md found in app folder.</p>';
        }
    });
</script>
</body>
</html>
