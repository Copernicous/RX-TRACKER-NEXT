    function sortRx(col) {
        if (rSortCol === col) {
            rSortDir = rSortDir === 'asc' ? 'desc' : 'asc';
        } else {
            rSortCol = col;
            rSortDir = 'asc';
        }
        rxPage = 1;
        if (rxServerPaging) loadRxRecords();
        else renderRx();
    }

    function updateRxSortIcons() {
        ['id', 'Patient.firstName', 'serviceDate', 'nextSvcDate', 'cycleStatus', 'Pharmacy.name', 'workflowStatus'].forEach(function(c) {
            const icon = document.getElementById('srIcon_' + c);
            if (icon) {
                icon.className = c === rSortCol 
                    ? (rSortDir === 'asc' ? 'fas fa-sort-up ms-1' : 'fas fa-sort-down ms-1') 
                    : 'fas fa-sort text-muted ms-1';
                icon.style.opacity = c === rSortCol ? '1' : '0.3';
            }
        });
    }

    function goRxPage(p) {
        var pages = rxServerPaging ? rxTotalPages : Math.ceil(filteredRx.length/rxPageSize);
        if(p<1||p>pages)return;
        rxPage=p;
        if (rxServerPaging) loadRxRecords();
        else renderRx();
    }

    function openRxModal() {
