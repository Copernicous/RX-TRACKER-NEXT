                var canComplete  = !!rxPerms.canAdd;
                var canUndo      = !!rxPerms.canUndo;
                var canWarehouse = !!rxPerms.canWarehouse;
                var canEditDate  = !!rxPerms.canEdit;
                var canOverrideExpired = !!rxPerms.canOverrideExpired || !!rxServiceDateOverrideEnabled;
                var lastCompletedActionId = null;
                for (var lci = 0; lci < allWorkflowActions.length; lci++) {
