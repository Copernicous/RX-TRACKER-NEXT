    function openWorkflow(rxId) {
        currentRxId = rxId;
        document.getElementById('workflowBody').innerHTML = '<p class="text-muted text-center py-3">Loading...</p>';
        workflowModalInstance.show();
        return fetchWithAuth(window.rxUrl('/api/rx-records/') + rxId)  // BUG-10 FIX: must return the Promise
        .then(function(res) {
            if (!res) return;
            return res.json().then(function(rx) {
                var completedIds = [];
                var completedMap = {};
                (rx.RXWorkflowTrackings || []).forEach(function(t) {
                    completedIds.push(t.workflowActionId);
                    completedMap[t.workflowActionId] = t;
                });

                var userRole = '';
                var rxPerms = { canAdd: false, canEdit: false, canDelete: false, canUndo: false, canWarehouse: false };
                try {
                    var u = JSON.parse(localStorage.getItem('user'));
                    if (u && u.role) userRole = u.role;
                    if (userRole === 'Administrator') {
                        rxPerms = { canAdd: true, canEdit: true, canDelete: true, canUndo: true, canWarehouse: true };
                    } else {
                        var gp = getPagePerms();
                        rxPerms = {
                            canAdd:       !!gp.canAdd,
                            canEdit:      !!gp.canEdit,
                            canDelete:    !!gp.canDelete,
                            canUndo:      !!gp.canUndo,
                            canWarehouse: gp.canWarehouse !== undefined ? !!gp.canWarehouse : !!gp.canEdit
                        };
                    }
                } catch(e) {}

                var canComplete  = !!rxPerms.canAdd;
                var canUndo      = !!rxPerms.canUndo;
                var canWarehouse = !!rxPerms.canWarehouse;
                var canEditDate  = !!rxPerms.canEdit;
                var lastCompletedActionId = completedIds.length > 0 ? rx.RXWorkflowTrackings[rx.RXWorkflowTrackings.length - 1].workflowActionId : null;

                window._workflowRxId = rxId;

                var footer      = document.getElementById('workflowFooter');
                var warehouseBtn = document.getElementById('returnToWarehouseBtn');
                var alreadyReturned = !!rx.returnedToWarehouse;
                if (canWarehouse && footer) {
                    footer.style.display = '';
                    if (alreadyReturned) {
                        warehouseBtn.innerHTML = '<i class="fas fa-warehouse me-1"></i>Already Returned \u2014 Re-send to Warehouse';
                        warehouseBtn.className = 'btn btn-sm btn-outline-warning fw-semibold';
                    } else {
                        warehouseBtn.innerHTML = '<i class="fas fa-warehouse me-1"></i>Return to Warehouse';
                        warehouseBtn.className = 'btn btn-sm btn-warning fw-semibold';
                    }
                } else if (footer) {
                    footer.style.display = 'none';
                }

                var warehouseBanner = '';
                if (alreadyReturned) {
                    var retDate = rx.warehouseReturnDate ? new Date(rx.warehouseReturnDate).toLocaleString() : '';
                    var retNote = rx.warehouseReturnNote ? ' \u2014 ' + rx.warehouseReturnNote : '';
                    warehouseBanner = '<div class="alert alert-warning py-2 mb-3"><i class="fas fa-warehouse me-2"></i><strong>Returned to Warehouse</strong> on ' + retDate + retNote + '</div>';
                }

                var svcDateR    = rx.serviceDate ? new Date(rx.serviceDate) : null;
                var expiryDateR = svcDateR ? new Date(svcDateR.getTime() + 90 * 864e5) : null;
                var todayD      = new Date(); todayD.setHours(0,0,0,0);
                var isExpired   = expiryDateR ? (todayD > expiryDateR) : false;
                var svcStr      = svcDateR ? svcDateR.toLocaleDateString() : '';
                var expStr      = expiryDateR ? expiryDateR.toLocaleDateString() : '';
                var resetBtnHtml = (isExpired && canEditDate)
                    ? '<button class="btn btn-sm btn-danger fw-semibold" id="resetCycleBtn"><i class="fas fa-redo me-1"></i>Start New Cycle</button>'
                    : '';
                var expiryBanner = isExpired
                    ? '<div class="alert alert-danger py-2 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2"><div><i class="fas fa-exclamation-triangle me-2"></i><strong>90-Day Window Expired</strong> <span class="ms-2 small">Service date: ' + svcStr + ' \u2014 Expired: ' + expStr + '</span></div>' + resetBtnHtml + '</div>'
                    : '';

                // ── 90-DAY ACTIVE LOCK BANNER ────────────────────────────────────────────
                // When the window is still running, show a clear visual indicator that the
                // service date is locked and cannot be changed until the window expires.
                var daysLeftInWindow = expiryDateR ? Math.ceil((expiryDateR - todayD) / 864e5) : 0;
                var activeLockBanner = (!isExpired && svcDateR)
                    ? '<div class="alert py-2 mb-3 d-flex align-items-center gap-3" style="background:rgba(74,144,226,.12);border:1.5px solid rgba(74,144,226,.35);border-radius:8px">' +
                        '<i class="fas fa-lock" style="color:#4a90e2;font-size:1.1rem;flex-shrink:0"></i>' +
                        '<div>' +
                            '<strong style="color:#4a90e2">90-Day Window Active — Service Date Locked</strong>' +
                            '<div class="small text-muted mt-1">' +
                                'Service started: <strong>' + svcStr + '</strong> &nbsp;&bull;&nbsp; ' +
                                'Window expires: <strong>' + expStr + '</strong> &nbsp;&bull;&nbsp; ' +
                                '<strong>' + daysLeftInWindow + ' day' + (daysLeftInWindow !== 1 ? 's' : '') + ' remaining</strong><br>' +
                                'The service date cannot be changed while this window is active. After expiry, use <em>Start New Cycle</em> to begin the next 90-day period.' +
                            '</div>' +
                        '</div>' +
                      '</div>'
                    : '';
                // ── END LOCK BANNER ──────────────────────────────────────────────────────

                var listHtml = '';
                for (var idx = 0; idx < allWorkflowActions.length; idx++) {
                    var action = allWorkflowActions[idx];
                    var done = completedIds.indexOf(action.id) !== -1;
                    var tracking = completedMap[action.id] || null;
                    var prevDone = idx === 0 || completedIds.indexOf(allWorkflowActions[idx-1].id) !== -1;
                    var stepCanComplete = !done && prevDone && canComplete;
                    var prevTracking = idx > 0 ? completedMap[allWorkflowActions[idx-1].id] : null;
                    var nextTracking = idx < allWorkflowActions.length-1 ? completedMap[allWorkflowActions[idx+1].id] : null;
                    var prevStepDate = prevTracking && prevTracking.completionDate ? new Date(prevTracking.completionDate).toISOString().slice(0,10) : (idx === 0 && svcDateR ? svcDateR.toISOString().slice(0,10) : '');
                    var nextStepDate = nextTracking && nextTracking.completionDate ? new Date(nextTracking.completionDate).toISOString().slice(0,10) : '';
                    var completedDateStr = done && tracking && tracking.completionDate ? new Date(tracking.completionDate).toISOString().slice(0,10) : '';
                    listHtml += '<div class="list-group-item d-flex align-items-center gap-3 ' + (done ? 'list-group-item-success' : '') + '">' +
                        '<span class="badge ' + (done ? 'bg-success' : 'bg-secondary') + ' rounded-pill">' + action.sequenceNumber + '</span>' +
                        '<div class="flex-grow-1">' +
                            '<div class="fw-bold">' + action.name + '</div>' +
                            '<small class="text-muted">' + (action.description || '') + '</small>' +
                            (done && tracking ? '<br><span class="wf-date-wrap d-inline-flex align-items-center gap-1"><small class="text-success wf-date-label"><i class="fas fa-check me-1"></i>Completed: ' + new Date(tracking.completionDate).toLocaleDateString() + '</small></span>' : '') +
                        '</div>' +
                        '<div class="d-flex gap-2 wf-cell"' +
                            ' data-rxid="' + rxId + '" data-aid="' + action.id + '"' +
                            ' data-tid="' + (done && tracking ? tracking.id : '') + '"' +
                            ' data-curdate="' + completedDateStr + '"' +
                            ' data-done="' + (done ? '1' : '0') + '"' +
                            ' data-canundo="' + (canUndo && action.id === lastCompletedActionId && !alreadyReturned ? '1' : '0') + '"' +
                            ' data-cancomp="' + (stepCanComplete && !isExpired ? '1' : '0') + '"' +
                            ' data-candate="' + (done && tracking && canEditDate ? '1' : '0') + '"' +
                            ' data-prevdate="' + prevStepDate + '"' +
                            ' data-nextdate="' + nextStepDate + '"' +
                            ' data-svcdate="' + (svcDateR ? svcDateR.toISOString().slice(0,10) : '') + '">' +
                        '</div>' +
                    '</div>';
                }

                var html = expiryBanner + activeLockBanner + warehouseBanner + '<div class="list-group">' + listHtml + '</div>';
                document.getElementById('workflowBody').innerHTML = html;

                /* Wire Reset Cycle button */
                var resetBtn = document.getElementById('resetCycleBtn');
                if (resetBtn) {
                    resetBtn.addEventListener('click', function() { promptResetCycle(rxId); });
                }

                /* Wire action buttons inside each wf-cell */
                document.getElementById('workflowBody').querySelectorAll('.wf-cell').forEach(function(cell) {
                    var _rid = parseInt(cell.dataset.rxid);
                    var _aid = parseInt(cell.dataset.aid);
                    var _tid = cell.dataset.tid    || '';
                    var _cur = cell.dataset.curdate || '';
                    var _done= cell.dataset.done   === '1';
                    var _cu  = cell.dataset.canundo === '1';
                    var _cc  = cell.dataset.cancomp === '1';
                    var _cd  = cell.dataset.candate === '1';
                    if (_done) {
                        if (_cu) {
                            var bu = document.createElement('button');
                            bu.className = 'btn btn-sm btn-outline-danger';
                            bu.textContent = 'Undo';
                            bu.dataset.rxid = _rid;
                            bu.addEventListener('click', function() { undoStep(parseInt(this.dataset.rxid)); });
                            cell.appendChild(bu);
                        }
                        if (_cd && _tid) {
                            var bed = document.createElement('button');
                            bed.className = 'btn btn-sm btn-outline-secondary';
                            bed.title = 'Edit completion date';
                            bed.innerHTML = '<i class="fas fa-calendar-alt"></i>';
                            bed.dataset.tid     = _tid;
                            bed.dataset.rxid    = _rid;
                            bed.dataset.curdate = _cur;
                            bed.dataset.prevdate = cell.dataset.prevdate || '';
                            bed.dataset.nextdate = cell.dataset.nextdate || '';
                            bed.dataset.svcdate  = cell.dataset.svcdate  || '';
                            bed.addEventListener('click', function() {
                                editStepDate(this.dataset.tid, parseInt(this.dataset.rxid),
                                    this.dataset.curdate, this.dataset.prevdate,
                                    this.dataset.nextdate, this.dataset.svcdate, this);
                            });
                            cell.appendChild(bed);
                        }
                        cell.insertAdjacentHTML('beforeend', '<i class="fas fa-check-circle text-success fs-5"></i>');
                    } else if (_cc) {
                        var bc = document.createElement('button');
                        bc.className = 'btn btn-sm btn-primary';
                        bc.textContent = 'Complete';
                        bc.dataset.rxid = _rid;
                        bc.dataset.aid  = _aid;
                        bc.addEventListener('click', function() {
                            completeStep(parseInt(this.dataset.rxid), parseInt(this.dataset.aid));
                        });
                        cell.appendChild(bc);
                    } else {
                        cell.insertAdjacentHTML('beforeend', '<i class="fas fa-lock text-muted"></i>');
                    }
                });
            }); // end res.json().then(function(rx)
        }).catch(function() {
            document.getElementById('workflowBody').innerHTML = '<p class="text-danger text-center py-3">Error loading workflow.</p>';
        });
    } // end openWorkflow

    function completeStep(rxId, actionId) {
        fetchWithAuth(window.rxUrl('/api/rx-records/workflow'), { method: 'POST', body: JSON.stringify({ rxId: rxId, actionId: actionId }) })

        .then(function(res) {
            if (!res) return;
            if (res.ok) {
                showToast('Step completed!', 'success');
                return openWorkflow(rxId).then(function() { return loadRxRecords(); });
            } else {
                return res.json().then(function(err) { showToast(err.error || 'Failed', 'danger'); });
            }
        }).catch(function() { showToast('Network error.', 'danger'); });
    }

    function undoStep(rxId) {
        if (!confirm('Are you sure you want to undo the last workflow step?')) return;
        fetchWithAuth(window.rxUrl('/api/rx-records/undo-workflow'), { method: 'POST', body: JSON.stringify({ rxId: rxId }) })
        .then(function(res) {
            if (!res) return;
            if (res.ok) {
                showToast('Workflow step undone.', 'success');
                return openWorkflow(rxId).then(function() { return loadRxRecords(); });
            } else {
                return res.json().then(function(err) { showToast(err.error || 'Undo failed', 'danger'); });
            }
        }).catch(function() { showToast('Network error.', 'danger'); });
    }

