          <table style="width:100%;border-collapse:collapse;margin-bottom:20px;font-size:.875rem">
            <tr>
              <td style="width:50%;padding:5px 0"><strong>Patient:</strong> ${(patient.firstName||'') + ' ' + (patient.lastName||'')}</td>
              <td style="width:50%;padding:5px 0"><strong>Patient Code:</strong> ${patient.patientCode||'—'}</td>
            </tr><tr>
              <td style="padding:5px 0"><strong>Pharmacy:</strong> ${pharmacy.name||'—'}</td>
              <td style="padding:5px 0"><strong>Service Date:</strong> ${rx.serviceDate||'—'}</td>
            </tr><tr>
              <td style="padding:5px 0"><strong>Service Date:</strong> ${rx.serviceDate||'—'}</td>
              <td style="padding:5px 0"><strong>Progress:</strong> ${doneCount}/${totalSteps} steps (${pct}%)</td>
            </tr>
          </table>
          ${rx.notes ? `<div style="background:#f8f9fa;border-left:3px solid #4a90e2;padding:10px 14px;border-radius:4px;margin-bottom:20px;font-size:.85rem"><strong>Notes:</strong><br>${rx.notes.replace(/\n/g,'<br>')}</div>` : ''}
          <h6 style="border-bottom:1px solid #dee2e6;padding-bottom:6px;margin-bottom:10px">Workflow Steps</h6>
          <table style="width:100%;border-collapse:collapse;font-size:.85rem">
            <thead><tr style="background:#1a2234;color:#fff">
              <th style="padding:7px 10px">Step</th>
              <th style="padding:7px 10px;text-align:center">Completed</th>
            </tr></thead>
            <tbody>${stepsClassicHtml}</tbody>
          </table>
        </div>`;

        body.innerHTML = cardHTML + classicHTML;
        body.style.background = '#f0f2f5';
    }

    function doPrintRx() {
        if (!_rxPrintData) return;
        const contentId = _rxPrintLayout === 'card' ? 'rxPrintContentCard' : 'rxPrintContentClassic';
        const content   = document.getElementById(contentId);
        if (!content) return;
        const rx  = _rxPrintData.rx;
        const win = window.open('', '_blank', 'width=900,height=750');
        const css = _rxPrintLayout === 'card'
            ? `@import url('/assets/inter.css');
               *{box-sizing:border-box;margin:0;padding:0}
               body{font-family:'Inter',Arial,sans-serif;background:#f0f2f5;padding:32px}
               #rxPrintContentCard{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,.1)}
               @media print{@page{margin:15mm;size:A4}body{background:#fff;padding:0}#rxPrintContentCard{box-shadow:none;border-radius:0}
               div[style*="background:linear-gradient"]{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}}`
            : `@import url('/assets/inter.css');
               body{font-family:Inter,Arial,sans-serif;color:#1a2234;padding:32px;max-width:860px;margin:0 auto}
               table{width:100%;border-collapse:collapse}
               thead tr{background:#1a2234!important;color:#fff!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
               th,td{padding:7px 10px;text-align:left;border-bottom:1px solid #dee2e6}
               @media print{@page{margin:20mm}body{padding:0}}`;
        win.document.write(`<!DOCTYPE html><html><head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
            <title>RX Record #${rx.id}</title>
            <style>${css}</style></head>
            <body>${content.outerHTML}
            <script>window.onload=function(){window.print();}<\/script>
</body></html>`);
        win.document.close();
        win.focus();
    }

    // Remove row button delegation
    document.addEventListener('click', function(e) {
        var el = e.target.closest('[data-remove-row]');
        if (el) { var row = document.getElementById(el.dataset.removeRow); if (row) row.remove(); }
    });

</script>
</body>
</html>
