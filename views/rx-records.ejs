                        reopenWarehouseBtn.style.display = '';
                        warehouseNoteInput.style.display = 'none';
                        warehouseFooterHint.textContent = 'Clears only the warehouse-return flag; the audit and Step 1 remain.';
                    } else if (canWarehouse && !alreadyReturned) {
