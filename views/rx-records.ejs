          <table style="width:100%;border-collapse:collapse;margin-bottom:20px;font-size:.875rem">
            <tr>
              <td style="width:50%;padding:5px 0"><strong>Patient:</strong> ${(patient.firstName||'') + ' ' + (patient.lastName||'')}</td>
              <td style="width:50%;padding:5px 0"><strong>Patient Code:</strong> ${patient.patientCode||'—'}</td>
            </tr><tr>
              <td style="padding:5px 0"><strong>Pharmacy:</strong> ${pharmacy.name||'—'}</td>
              <td style="padding:5px 0"><strong>Arrival Date:</strong> ${rx.arrivalDate||'—'}</td>
            </tr><tr>
              <td style="padding:5px 0"><strong>Service Date:</strong> ${rx.serviceDate||'—'}</td>
              <td style="padding:5px 0"><strong>Progress:</strong> ${doneCount}/${totalSteps} steps (${pct}%)</td>
            </tr>
          </table>
          ${rx.notes ? `<div style="background:#f8f9fa;border-left:3px solid #4a90e2;padding:10px 14px;border-radius:4px;margin-bottom:20px;font-size:.85rem"><strong>Notes:</strong><br>${rx.notes.replace(/\n/g,'<br>')}</div>` : ''}
          <h6 style="border-bottom:1px solid #dee2e6;padding-bottom:6px;margin-bottom:10px">Workflow Steps</h6>
          <table style="width:100%;border-collapse:collapse;font-size:.85rem">
            <thead><tr style="background:#1a2234;color:#fff">
              <th style="padding:7px 10px">Step</th>
              <th style="padding:7px 10px;text-align:center">Completed</th>
            </tr></thead>
            <tbody>${stepsClassicHtml}</tbody>
          </table>
        </div>`;

        body.innerHTML = cardHTML + classicHTML;
        body.style.background = '#f0f2f5';
    }

    function doPrintRx() {
        if (!_rxPrintData) return;
        const contentId = _rxPrintLayout === 'card' ? 'rxPrintContentCard' : 'rxPrintContentClassic';
        const content   = document.getElementById(contentId);
        if (!content) return;
        const rx  = _rxPrintData.rx;
        const win = window.open('', '_blank', 'width=900,height=750');
        const css = _rxPrintLayout === 'card'
