    // Show a soft warning when the typed medication isn't in the catalog (still saveable)
    function checkMedCatalog(input) {
        var val = input.value.trim().toLowerCase();
        var row = input.closest ? input.closest('.med-row') : null;
        if (!row) {
            var p = input.parentNode;
            while (p && !p.classList.contains('med-row')) p = p.parentNode;
            row = p;
        }
        var warn = row ? row.querySelector('.med-warn') : null;
        if (!warn) return;
        var inCatalog = val === '';
        if (!inCatalog) {
            for (var _ci = 0; _ci < allMedCatalog.length; _ci++) {
                if (allMedCatalog[_ci].name.toLowerCase() === val) { inCatalog = true; break; }
            }
        }
        warn.style.display = inCatalog ? 'none' : '';
    }

    function saveRx() {
        var btn = document.getElementById('saveRxBtn');
        var spinner = document.getElementById('saveRxSpinner');
        btn.disabled = true; spinner.classList.remove('d-none');
        var medications = [];
        for (var i = 1; i <= medCount; i++) {
            var nameEl = document.querySelector('[name="medName_' + i + '"]');
            if (nameEl && nameEl.value.trim()) {
                var qtyEl   = document.querySelector('[name="medQty_'   + i + '"]');
                var notesEl = document.querySelector('[name="medNotes_' + i + '"]');
                medications.push({
                    name:     nameEl.value.trim(),
                    quantity: parseInt(qtyEl   ? qtyEl.value   : '1') || 1,
                    notes:    notesEl ? notesEl.value.trim() : ''
                });
            }
        }
        var body = {
            patientId:                  document.getElementById('rxPatientId').value || null,
            pharmacyId:                 document.getElementById('rxPharmacyId').value || null,
            arrivalDate:                document.getElementById('rxArrivalDate').value,
            serviceDate:                document.getElementById('rxServiceDate').value,
            patientTransportCompanyId:  document.getElementById('rxPatientTransport').value || null,
            pharmacyTransportCompanyId: document.getElementById('rxPharmacyTransport').value || null,
            medications:                medications
        };

        if (!body.patientId) {
            showToast('Please select a patient from the search results.', 'warning');
            btn.disabled = false; spinner.classList.add('d-none');
            document.getElementById('patientSearchInput').focus();
            return;
        }
        if (!body.pharmacyId) {
            showToast('No Default Pharmacy found. Please set a Default Pharmacy on the patient record first.', 'warning');
            btn.disabled = false; spinner.classList.add('d-none');
            return;
        }

        fetchWithAuth(window.rxUrl('/api/rx-records'), { method: 'POST', body: JSON.stringify(body) })
        .then(function(res) {
            if (!res) { btn.disabled = false; spinner.classList.add('d-none'); return; }
            if (res.ok) {
                bootstrap.Modal.getInstance(document.getElementById('rxModal')).hide();
                showToast('RX Record created!', 'success');
                return loadRxRecords();
            } else {
                return res.json().then(function(err) {
                    showToast(err.error || err.message || 'Save failed.', 'danger');
                });
            }
        }).catch(function(e) {
            var errMsg = (e && e.message) ? e.message : 'Network error saving RX record.';
            showToast('Error: ' + errMsg, 'danger');
            // Log to DB for developer review (Audit Log → Error Log tab)
            if (typeof window.logClientError === 'function') {
                window.logClientError(
                    'RX Save failed: ' + errMsg,
                    (e && e.stack ? e.stack : '') + '\nBody sent: ' + JSON.stringify(body),
                    'error'
                );
            }
        }).then(function() {
            btn.disabled = false; spinner.classList.add('d-none');
        });
    }

    // ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ View RX Record Details ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬
    function viewRxDetail(id) {
        var bodyEl = document.getElementById('rxDetailBody');
        bodyEl.innerHTML = '<p class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading record...</p>';

        var printBtn = document.getElementById('rxDetailPrintBtn');
        if (printBtn) printBtn.onclick = function() { printRxRecord(id); };

        new bootstrap.Modal(document.getElementById('rxDetailModal')).show();

        fetchWithAuth(window.rxUrl('/api/rx-records/') + id)
        .then(function(res) {
            if (!res || !res.ok) { bodyEl.innerHTML = '<p class="text-danger text-center py-4">Failed to load record.</p>'; return; }
            return res.json().then(function(rx) {
                var patient    = rx.Patient  || {};
                var pharmacy   = rx.Pharmacy || {};
                var meds       = rx.Medications || [];
                var trackings  = rx.RXWorkflowTrackings || [];
                var totalSteps = allWorkflowActions.length;
                var doneCount  = trackings.length;
                var pct        = totalSteps > 0 ? Math.round((doneCount / totalSteps) * 100) : 0;

                var statusColor = pct >= 100 ? '#198754' : pct > 0 ? '#fd7e14' : '#6c757d';
                var statusLabel = pct >= 100 ? 'Completed' : pct > 0 ? 'In Progress' : 'Not Started';

                var ptComp  = rx.PatientTransportCompany  ? (rx.PatientTransportCompany.contactPerson  || rx.PatientTransportCompany.companyName  || '\u2014') : '\u2014';
                var phtComp = rx.PharmacyTransportCompany ? (rx.PharmacyTransportCompany.companyName || rx.PharmacyTransportCompany.contactPerson || '\u2014') : '\u2014';

                var infoRows = [
                    ['Patient',            (patient.firstName || '') + ' ' + (patient.lastName || '')],
                    ['Patient ID',         patient.patientCode || '\u2014'],
                    ['Default Pharmacy',   pharmacy.name || '\u2014'],
                    ['Service Date',       rx.serviceDate || '\u2014'],
                    ['Next Service Date',  (function(){ if (!rx.serviceDate) return '\u2014'; var e = new Date(new Date(rx.serviceDate).getTime() + 90*864e5); return e.toLocaleDateString(); })()],
                    ['Cycle Status',       (function(){
                        if (!rx.serviceDate) return '\u2014';
                        var e = new Date(new Date(rx.serviceDate).getTime() + 90*864e5);
                        var d = Math.round((e - new Date()) / 864e5);
                        if (d < 0) return '\u26a0\ufe0f Eligible for renewal (' + Math.abs(d) + 'd ago)';
                        if (d <= 14) return '\u23f1\ufe0f Expiring soon (' + d + 'd left) \u2014 \uD83D\uDD12 Date Locked';
                        return '\uD83D\uDD12 Active Window (' + d + ' days remaining) \u2014 Date Locked';
                    })()],
                    ['Patient Transport',  ptComp],
                    ['Pharmacy Transport', phtComp],
                    ['Created',            rx.createdAt ? new Date(rx.createdAt).toLocaleString() : '\u2014']
                ];

                var infoHtml = '';
                for (var ii = 0; ii < infoRows.length; ii++) {
                    infoHtml += '<div class="col-md-6 mb-2">' +
                        '<div class="small text-muted text-uppercase fw-bold" style="font-size:.68rem;letter-spacing:.06em">' + infoRows[ii][0] + '</div>' +
                        '<div class="fw-semibold">' + infoRows[ii][1] + '</div>' +
                        '</div>';
                }

                var medHtml;
                if (meds.length === 0) {
                    medHtml = '<p class="text-muted small mb-0"><i class="fas fa-info-circle me-1"></i>No actions recorded.</p>';
                } else {
                    var medRows = '';
                    for (var mi = 0; mi < meds.length; mi++) {
                        var m = meds[mi];
                        medRows += '<tr><td class="fw-semibold">' + (m.name || '\u2014') + '</td>' +
                            '<td class="text-center">' + (m.quantity || 1) + '</td>' +
                            '<td class="text-muted small">' + (m.notes || '') + '</td></tr>';
                    }
                    medHtml = '<table class="table table-sm table-bordered mb-0">' +
                        '<thead class="table-dark"><tr><th>Action</th><th style="width:60px">#</th><th>Notes</th></tr></thead>' +
                        '<tbody>' + medRows + '</tbody></table>';
                }

                var wfHtml;
                if (allWorkflowActions.length === 0) {
                    wfHtml = '<p class="text-muted small">No workflow steps defined.</p>';
                } else {
                    wfHtml = '';
                    for (var wi = 0; wi < allWorkflowActions.length; wi++) {
                        var wa = allWorkflowActions[wi];
                        var tracking = null;
                        for (var ti = 0; ti < trackings.length; ti++) {
                            if (trackings[ti].workflowActionId === wa.id) { tracking = trackings[ti]; break; }
                        }
                        var done    = !!tracking;
                        var dateStr = done && tracking.completionDate ? new Date(tracking.completionDate).toLocaleDateString() : null;
                        var lagHtml = '';
                        if (done && tracking.completionDate) {
                            var prevDate = null;
                            if (wi === 0 && rx.serviceDate) {
                                var sd = new Date(rx.serviceDate); sd.setHours(0,0,0,0); prevDate = sd;
                            } else if (wi > 0) {
                                var prevTk = null;
                                for (var pti = 0; pti < trackings.length; pti++) {
                                    if (trackings[pti].workflowActionId === allWorkflowActions[wi-1].id) { prevTk = trackings[pti]; break; }
                                }
                                if (prevTk && prevTk.completionDate) { prevDate = new Date(prevTk.completionDate); prevDate.setHours(0,0,0,0); }
                            }
                            if (prevDate) {
                                var cur  = new Date(tracking.completionDate); cur.setHours(0,0,0,0);
                                var diff = Math.round((cur - prevDate) / 864e5);
                                var prevRef = wi === 0 ? 'svc. date' : 'prev. step';
                                var lagTxt  = diff === 0 ? 'same as ' + prevRef : '+' + diff + 'd from ' + prevRef;
                                lagHtml = '<span class="text-muted ms-1" style="font-size:.68rem">(' + lagTxt + ')</span>';
                            }
                        }
                        wfHtml += '<div class="d-flex align-items-center gap-2 py-1" style="border-bottom:1px solid #f0f0f0">' +
                            '<i class="fas ' + (done ? 'fa-check-circle text-success' : 'fa-circle text-secondary') + '" style="font-size:.95rem;width:18px;flex-shrink:0"></i>' +
                            '<span class="' + (done ? 'text-success fw-semibold' : 'text-muted') + '" style="font-size:.87rem">' + wa.name + '</span>' +
                            (done ? '<span class="ms-auto d-flex align-items-center gap-1 flex-wrap justify-content-end">' +
                                '<span class="badge bg-success" style="font-size:.65rem">' + (dateStr || '') + '</span>' +
                                lagHtml + '</span>' : '') +
                            '</div>';
                    }
                }

                bodyEl.innerHTML =
                    '<div class="d-flex justify-content-between align-items-start mb-3 p-3 rounded" style="background:linear-gradient(135deg,#1a2234,#2c3e6b);color:#fff">' +
                        '<div>' +
                            '<div class="fw-bold fs-5">RX Record <span style="font-family:monospace">#' + rx.id + '</span></div>' +
                            '<div class="small opacity-75">' + (patient.firstName || '') + ' ' + (patient.lastName || '') + ' &nbsp;&middot;&nbsp; ' + (pharmacy.name || 'No pharmacy') + '</div>' +
                        '</div>' +
                        '<span class="badge rounded-pill px-3 py-2" style="background:' + statusColor + ';font-size:.82rem">' + statusLabel + ' &nbsp; ' + pct + '%</span>' +
                    '</div>' +
