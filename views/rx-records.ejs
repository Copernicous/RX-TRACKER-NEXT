                    var retNote = rx.warehouseReturnNote ? ' \u2014 ' + rx.warehouseReturnNote : '';
                    warehouseBanner = '<div class="alert alert-warning py-2 mb-3"><i class="fas fa-warehouse me-2"></i><strong>Package Returned to Pharmacy</strong> on ' + retDate + retNote + '</div>';
                }

