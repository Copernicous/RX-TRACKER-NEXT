    function applyRxFilter() {
        var pat   = document.getElementById('rxFilterPatient').value.toLowerCase().trim();
        var rxId  = document.getElementById('rxFilterId').value.trim();
        var ph    = document.getElementById('rxFilterPharmacy').value.toLowerCase().trim();
        var from  = document.getElementById('rxFilterDateFrom').value;
        var to    = document.getElementById('rxFilterDateTo').value;
        var _pcEl = document.getElementById('rxFilterPatientCode');
        var pc    = (_pcEl ? _pcEl.value : '').toLowerCase().trim();
        var _sfEl = document.getElementById('rxFilterSvcFrom');
        var sfrom = _sfEl ? _sfEl.value : '';
        var _stEl = document.getElementById('rxFilterSvcTo');
        var sto   = _stEl ? _stEl.value : '';
        var preId = window._rxPrefilterPatientId;

        filteredRx = allRx.filter(function(r) {
            if (pat) {
                var fullName = r.Patient ? (r.Patient.firstName + ' ' + r.Patient.lastName).toLowerCase() : '';
                var code     = r.Patient ? (r.Patient.patientCode || '').toLowerCase() : '';
                if (fullName.indexOf(pat) === -1 && code.indexOf(pat) === -1) return false;
            }
            if (pc) {
                var code2 = r.Patient ? (r.Patient.patientCode || '').toLowerCase() : '';
                if (code2.indexOf(pc) === -1) return false;
            }
            if (preId && !pat && !pc) {
                if (!r.Patient || String(r.Patient.id) !== String(preId)) return false;
            }
            if (rxId && String(r.id) !== rxId) return false;
            if (ph) {
                var phName = r.Pharmacy ? r.Pharmacy.name.toLowerCase() : '';
                if (phName.indexOf(ph) === -1) return false;
            }
            if (from  && r.serviceDate && r.serviceDate < from)  return false;
            if (to    && r.serviceDate && r.serviceDate > to)     return false;
            if (sfrom && r.serviceDate && r.serviceDate < sfrom) return false;
            if (sto   && r.serviceDate && r.serviceDate > sto)   return false;
            return true;
        });
        renderRxSorted();
    }

