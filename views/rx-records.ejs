                var warehouseFooterHint = document.getElementById('warehouseFooterHint');
                var returnedToPharmacy = rx.deliveryOutcome === 'returned_to_pharmacy';
                var legacyWarehouseReturn = !!rx.returnedToWarehouse && !returnedToPharmacy;
                var alreadyReturned = legacyWarehouseReturn || returnedToPharmacy;
                if (footer) {
                    footer.style.display = canWarehouse && (!alreadyReturned || legacyWarehouseReturn) ? '' : 'none';
                    if (legacyWarehouseReturn) {
