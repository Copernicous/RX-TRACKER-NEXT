        resetRxForm();
        // Reset patient search picker
        var searchInput = document.getElementById('patientSearchInput');
        var hiddenInput = document.getElementById('rxPatientId');
        var dropdown   = document.getElementById('patientDropdown');
        var info       = document.getElementById('patientSelectedInfo');
        if (searchInput) { searchInput.value = ''; searchInput.classList.remove('is-selected'); }
        if (hiddenInput) hiddenInput.value = '';
        if (dropdown)    dropdown.classList.remove('open');
        if (info)        info.textContent = '';
        addMedicationRow();
        if (_rxPrefillPatientId || _rxPrefillPatientName) {
            if (!applyRxPrefillPatient()) {
                loadRxPatientPickerData().then(function() {
