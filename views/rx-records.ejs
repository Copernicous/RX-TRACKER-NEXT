    function setRxParam(params, name, value) {
        if (value !== null && value !== undefined && String(value).trim() !== '') {
            params.set(name, String(value).trim());
        }
    }

    function buildRxQueryParams(options) {
        options = options || {};
        var params = new URLSearchParams();
        params.set('paginated', 'true');
        if (options.exportAll) {
            params.set('exportAll', 'true');
            params.set('page', '1');
            params.set('pageSize', '500');
        } else {
            params.set('page', String(rxPage));
            params.set('pageSize', String(rxPageSize));
        }
        params.set('sort', rSortCol || 'id');
        params.set('dir', rSortDir || 'desc');

        setRxParam(params, 'patient', document.getElementById('rxFilterPatient')?.value || '');
        setRxParam(params, 'id', document.getElementById('rxFilterId')?.value || '');
        setRxParam(params, 'pharmacyIds', document.getElementById('rxFilterPharmacy')?.value || '');
        setRxParam(params, 'clinicIds', document.getElementById('rxFilterClinic')?.value || '');
        setRxParam(params, 'patientCode', document.getElementById('rxFilterPatientCode')?.value || '');
        setRxParam(params, 'dateFrom', document.getElementById('rxFilterDateFrom')?.value || '');
        setRxParam(params, 'dateTo', document.getElementById('rxFilterDateTo')?.value || '');
        setRxParam(params, 'serviceFrom', document.getElementById('rxFilterSvcFrom')?.value || '');
        setRxParam(params, 'serviceTo', document.getElementById('rxFilterSvcTo')?.value || '');
        setRxParam(params, 'patientTransportId', document.getElementById('rxFilterPatientTransport')?.value || '');
        setRxParam(params, 'pharmacyTransportId', document.getElementById('rxFilterPharmacyTransport')?.value || '');
        setRxParam(params, 'warehouseStatus', document.getElementById('rxFilterWarehouseStatus')?.value || '');
        setRxParam(params, 'workflowStatus', document.getElementById('rxFilterWorkflowStatus')?.value || '');
        setRxParam(params, 'patientType', document.getElementById('rxFilterPatientType')?.value || '');
        setRxParam(params, 'currentWorkflowStage', document.getElementById('rxFilterCurrentWorkflowStage')?.value || '');
        setRxParam(params, 'currentStageDateFrom', document.getElementById('rxFilterCurrentStageDateFrom')?.value || '');
        setRxParam(params, 'currentStageDateTo', document.getElementById('rxFilterCurrentStageDateTo')?.value || '');
        setRxParam(params, 'patientId', window._rxPrefilterPatientId || '');

        var sdEl = document.getElementById('rxShowDeleted');
        if (sdEl && sdEl.checked) params.set('includeDeleted', 'true');
        return params;
    }

    function scheduleRxLoad() {
        if (rxFilterTimer) clearTimeout(rxFilterTimer);
        rxFilterTimer = setTimeout(function() {
            rxFilterTimer = null;
            loadRxRecords();
        }, 250);
    }

    function loadRxRecords() {
        var params = buildRxQueryParams();
        var url = window.rxUrl('/api/rx-records') + '?' + params.toString();
        var tbody = document.getElementById('rxBody');
        if (tbody) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading RX records...</td></tr>';
        }
        return fetchWithAuth(url).then(function(res) {
            if (!res) return;
            return res.json().then(function(data) {
                if (data && Array.isArray(data.rows)) {
                    rxServerPaging = true;
                    allRx = data.rows;
                    filteredRx = data.rows;
                    rxTotalCount = Number(data.total || 0);
                    rxTotalPages = Number(data.totalPages || 1);
                    rxPage = Number(data.page || rxPage || 1);
                    rxPageSize = Number(data.pageSize || rxPageSize || 10);
                    renderRxSorted();
                } else {
                    rxServerPaging = false;
                    allRx = Array.isArray(data) ? data : [];
                    filteredRx = allRx.slice();
                    applyRxFilter();
                }
            });
        }).catch(function(e) { console.error('[RX] loadRxRecords error:', e); });
    }

    function getRxCompletedStepIds(rx) {
        var source = rx && Array.isArray(rx.completedSteps)
            ? rx.completedSteps
            : ((rx && rx.RXWorkflowTrackings) || []).map(function(tracking) {
                return tracking.workflowActionId;
            });
        var activeIds = {};
        var seen = {};
        var completedIds = [];

        for (var ai = 0; ai < allWorkflowActions.length; ai++) {
            activeIds[String(Number(allWorkflowActions[ai].id))] = true;
        }
        for (var si = 0; si < source.length; si++) {
            var actionId = Number(source[si]);
            var actionKey = String(actionId);
            if (!isNaN(actionId) && activeIds[actionKey] && !seen[actionKey]) {
                seen[actionKey] = true;
                completedIds.push(actionId);
            }
        }
        return completedIds;
    }

    function getRxCompletedStepCount(rx) {
        return getRxCompletedStepIds(rx).length;
    }

    function getRxWorkflowStatusKey(rx) {
        var completedSteps = getRxCompletedStepCount(rx);
        var totalSteps = allWorkflowActions.length;
        var svc = rx && rx.serviceDate ? new Date(rx.serviceDate) : null;
        if (svc && !isNaN(svc.getTime())) {
            svc.setHours(0, 0, 0, 0);
            var expiry = new Date(svc.getTime() + window.SERVICE_WINDOW_DAYS * 864e5);
            expiry.setHours(0, 0, 0, 0);
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            if (today > expiry && completedSteps < totalSteps) return 'expired';
        }
        if (totalSteps > 0 && completedSteps >= totalSteps) return 'completed';
        if (completedSteps > 0) return 'in-progress';
        return 'not-started';
    }

    function getRxCurrentWorkflowStageKey(rx) {
        var trackings = rx && rx.RXWorkflowTrackings ? rx.RXWorkflowTrackings : [];
        var currentSequence = 0;
        for (var ti = 0; ti < trackings.length; ti++) {
            for (var ai = 0; ai < allWorkflowActions.length; ai++) {
                if (Number(allWorkflowActions[ai].id) === Number(trackings[ti].workflowActionId)) {
                    currentSequence = Math.max(
                        currentSequence,
                        Number(allWorkflowActions[ai].sequenceNumber) || (ai + 1)
                    );
                    break;
                }
            }
        }
        return currentSequence > 0 ? String(currentSequence) : '';
    }

    function getRxCurrentStageDateValue(rx) {
        if (rx && rx.currentStageDate) return rx.currentStageDate;
        var trackings = rx && Array.isArray(rx.RXWorkflowTrackings) ? rx.RXWorkflowTrackings : [];
        var sequenceByActionId = {};
        var currentSequence = 0;
        for (var ai = 0; ai < allWorkflowActions.length; ai++) {
            var action = allWorkflowActions[ai];
            var sequence = Number(action.sequenceNumber) || (ai + 1);
            sequenceByActionId[String(Number(action.id))] = sequence;
        }
        for (var ti = 0; ti < trackings.length; ti++) {
            var trackingSequence = sequenceByActionId[String(Number(trackings[ti].workflowActionId))];
            if (trackingSequence) currentSequence = Math.max(currentSequence, trackingSequence);
        }
        if (!currentSequence) return '';
        var latestDate = null;
        var latestTrackingId = -1;
        for (var di = 0; di < trackings.length; di++) {
            var tracking = trackings[di];
            if (sequenceByActionId[String(Number(tracking.workflowActionId))] !== currentSequence) continue;
            if (!tracking.completionDate) continue;
            var completionDate = new Date(tracking.completionDate);
            if (isNaN(completionDate.getTime())) continue;
            var trackingId = Number(tracking.id) || 0;
            if (!latestDate || completionDate > latestDate
                || (completionDate.getTime() === latestDate.getTime() && trackingId > latestTrackingId)) {
                latestDate = completionDate;
                latestTrackingId = trackingId;
            }
        }
        return latestDate ? latestDate.toISOString() : '';
    }

    function getRxAppDateParts(value) {
        if (!value) return null;
        var date = new Date(value);
        if (isNaN(date.getTime())) return null;
        var options = {
            timeZone: window.APP_TIME_ZONE || 'America/New_York',
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit', second: '2-digit',
            hour12: false
        };
        var parts;
        try {
            parts = new Intl.DateTimeFormat('en-US', options).formatToParts(date);
        } catch (error) {
            options.timeZone = 'America/New_York';
            parts = new Intl.DateTimeFormat('en-US', options).formatToParts(date);
        }
        var result = {};
        for (var pi = 0; pi < parts.length; pi++) {
            if (parts[pi].type !== 'literal') result[parts[pi].type] = parts[pi].value;
        }
        if (result.hour === '24') result.hour = '00';
        return result;
    }

    function getRxLocalDateKey(value) {
        var parts = getRxAppDateParts(value);
        return parts ? (parts.year + '-' + parts.month + '-' + parts.day) : '';
    }

    function formatRxAppDateTime(value) {
        var parts = getRxAppDateParts(value);
        return parts
            ? (parts.year + '-' + parts.month + '-' + parts.day + ' '
                + parts.hour + ':' + parts.minute + ':' + parts.second)
            : '';
    }

    function getRxWorkflowSortValue(rx) {
        var completedSteps = getRxCompletedStepCount(rx);
        var totalSteps = allWorkflowActions.length || 0;
        if (totalSteps > 0 && completedSteps >= totalSteps) return totalSteps + 100;
        var svc = rx && rx.serviceDate ? new Date(rx.serviceDate) : null;
        if (svc && !isNaN(svc.getTime())) {
            svc.setHours(0, 0, 0, 0);
            var exp = new Date(svc.getTime() + window.SERVICE_WINDOW_DAYS * 864e5);
            exp.setHours(0, 0, 0, 0);
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            if (today > exp) return 1000 + completedSteps;
        }
        return completedSteps;
    }

