                var expStr      = expiryDateR ? expiryDateR.toLocaleDateString() : '';
                var isWorkflowClosed = allWorkflowActions.length > 0;
                for (var wci = 0; wci < allWorkflowActions.length; wci++) {
                    if (!completedMap[allWorkflowActions[wci].id]) {
                        isWorkflowClosed = false;
                        break;
                    }
                }
                var canCloseExpired = !!(canComplete || canEditDate || canOverrideExpired);
