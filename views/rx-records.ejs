        });
        /* arrivalDate will be set = serviceDate when patient is selected */
    }

    async function loadRxRecords() {
        const showDeleted = document.getElementById('rxShowDeleted') && document.getElementById('rxShowDeleted').checked;
        const url = '/api/rx-records' + (showDeleted ? '?includeDeleted=true' : '');
        const res = await fetchWithAuth(url);
        if (!res) return;
        const data = await res.json();
        allRx = Array.isArray(data) ? data : [];
        filteredRx = allRx.slice();
        applyRxFilter();
    }

    function applyRxFilter() {
        const pat   = document.getElementById('rxFilterPatient').value.toLowerCase().trim();
        const rxId  = document.getElementById('rxFilterId').value.trim();
        const ph    = document.getElementById('rxFilterPharmacy').value.toLowerCase().trim();
        const from  = document.getElementById('rxFilterDateFrom').value;
        const to    = document.getElementById('rxFilterDateTo').value;
        const pc    = (document.getElementById('rxFilterPatientCode')?.value || '').toLowerCase().trim();
        const sfrom = document.getElementById('rxFilterSvcFrom')?.value || '';
        const sto   = document.getElementById('rxFilterSvcTo')?.value || '';
        const preId = window._rxPrefilterPatientId;

        filteredRx = allRx.filter(r => {
            // Patient name filter
            if (pat) {
                const fullName = r.Patient ? (r.Patient.firstName + ' ' + r.Patient.lastName).toLowerCase() : '';
                const code     = r.Patient ? (r.Patient.patientCode || '').toLowerCase() : '';
                if (!fullName.includes(pat) && !code.includes(pat)) return false;
            }
            // Patient Code exact/partial filter (Advanced)
            if (pc) {
                const code = r.Patient ? (r.Patient.patientCode || '').toLowerCase() : '';
                if (!code.includes(pc)) return false;
            }
            // Pre-filter by patient ID (from URL ?patient=)
            if (preId && !pat && !pc) {
                if (!r.Patient || String(r.Patient.id) !== String(preId)) return false;
            }
            // RX number filter
            if (rxId && String(r.id) !== rxId) return false;
            // Pharmacy name filter
            if (ph) {
                const phName = r.Pharmacy ? r.Pharmacy.name.toLowerCase() : '';
                if (!phName.includes(ph)) return false;
            }
            // Service date range (from advanced filter 'Service Date From/To')
            if (from && r.serviceDate && r.serviceDate < from) return false;
            if (to   && r.serviceDate && r.serviceDate > to)   return false;
            // Service date range
            if (sfrom && r.serviceDate && r.serviceDate < sfrom) return false;
            if (sto   && r.serviceDate && r.serviceDate > sto)   return false;
            return true;
        });
        renderRxSorted();
    }

    function renderRx() {
        applyRxFilter();
    }

    function renderRxSorted() {
        filteredRx.sort((a, b) => {
            let valA = a[rSortCol];
            let valB = b[rSortCol];
            
            if (rSortCol === 'Patient.firstName') {
                valA = a.Patient ? (a.Patient.firstName + ' ' + a.Patient.lastName) : '';
                valB = b.Patient ? (b.Patient.firstName + ' ' + b.Patient.lastName) : '';
            } else if (rSortCol === 'Pharmacy.name') {
                valA = a.Pharmacy ? a.Pharmacy.name : '';
                valB = b.Pharmacy ? b.Pharmacy.name : '';
            }
            
            if (typeof valA === 'string' && typeof valB === 'string') {
                return rSortDir === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
            } else {
                if (valA < valB) return rSortDir === 'asc' ? -1 : 1;
                if (valA > valB) return rSortDir === 'asc' ? 1 : -1;
                return 0;
            }
        });

        updateRxSortIcons();

        var start = (rxPage - 1) * rxPageSize;
        var page  = filteredRx.slice(start, start + rxPageSize);
        var tbody = document.getElementById('rxBody');
        if (page.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No RX records found.</td></tr>';
        } else {
            /* Build rows purely via DOM API (no template literals) — FortiGate-safe */
            tbody.innerHTML = '';
            for (var ri = 0; ri < page.length; ri++) {
                var rx           = page[ri];
                var isDeleted    = !!rx.isDeleted;
                var patInactive  = rx.Patient && rx.Patient.isActive === false;
                var patDeleted   = rx.Patient && rx.Patient.isDeleted === true;
                var patientName  = rx.Patient ? rx.Patient.firstName + ' ' + rx.Patient.lastName : 'ID:' + rx.patientId;
                var pharmacyName = rx.Pharmacy ? rx.Pharmacy.name : 'ID:' + rx.pharmacyId;
                var completedSteps = rx.RXWorkflowTrackings ? rx.RXWorkflowTrackings.length : 0;
                var totalSteps   = allWorkflowActions.length;
                var pct          = totalSteps > 0 ? Math.round((completedSteps / totalSteps) * 100) : 0;
                var rxP          = getPagePerms();
                var isSel        = _rxBulkSel.has(rx.id);

                var tr = document.createElement('tr');
                if (isDeleted)   tr.className = 'table-secondary text-muted';
                else if (patInactive) tr.className = 'table-warning';

                /* ── Checkbox cell (F10-02) ── */
                var tdCb = document.createElement('td');
                var cb = document.createElement('input');
                cb.type = 'checkbox';
                cb.className = 'rx-row-cb';
                cb.dataset.rxid = rx.id;
                cb.checked = isSel;
                cb.style.cursor = 'pointer';
                cb.addEventListener('change', function() {
                    var id = parseInt(this.dataset.rxid);
                    if (this.checked) { _rxBulkSel.add(id); } else { _rxBulkSel.delete(id); }
                    _rxUpdateBulkBar();
                });
                tdCb.appendChild(cb);
                tr.appendChild(tdCb);

                /* ── RX # cell ── */
                var tdId = document.createElement('td');
                var strong = document.createElement('strong');
                strong.textContent = '#' + rx.id;
                tdId.appendChild(strong);
                if (isDeleted) { var hidBadge = document.createElement('span'); hidBadge.className = 'badge bg-secondary ms-1'; hidBadge.textContent = 'Hidden'; tdId.appendChild(hidBadge); }
                if (rx.returnedToWarehouse) { var whB = document.createElement('span'); whB.className = 'badge bg-warning text-dark ms-1'; whB.title = 'Returned to Warehouse'; whB.innerHTML = '<i class="fas fa-warehouse"></i>'; tdId.appendChild(whB); }
                tr.appendChild(tdId);

                /* ── Patient cell ── */
                var tdPat = document.createElement('td');
                tdPat.textContent = patientName;
                if (patDeleted) { var pb = document.createElement('span'); pb.className = 'badge bg-danger ms-1'; pb.title = 'Patient deleted'; pb.innerHTML = '<i class="fas fa-user-slash"></i>'; tdPat.appendChild(pb); }
                else if (patInactive) { var pb2 = document.createElement('span'); pb2.className = 'badge bg-warning text-dark ms-1'; pb2.title = 'Patient inactive'; pb2.innerHTML = '<i class="fas fa-user-times"></i>'; tdPat.appendChild(pb2); }
                tr.appendChild(tdPat);

                /* ── Date cell ── (Service Date only) */
                var tdSvc = document.createElement('td'); tdSvc.textContent = rx.serviceDate || '—'; tr.appendChild(tdSvc);

                /* ── Pharmacy cell ── */
                var tdPh = document.createElement('td'); tdPh.textContent = pharmacyName; tr.appendChild(tdPh);

                /* ── Workflow status cell ── */
                var tdWf = document.createElement('td');
                var wfDiv = document.createElement('div');
                wfDiv.className = 'd-flex align-items-center gap-2';
                var prog = document.createElement('div');
                prog.className = 'progress flex-grow-1';
                prog.style.height = '8px';
                var bar = document.createElement('div');
                bar.className = 'progress-bar bg-success';
                bar.style.width = pct + '%';
                prog.appendChild(bar);
                var sm = document.createElement('small');
                sm.textContent = completedSteps + '/' + totalSteps;
                wfDiv.appendChild(prog);
                wfDiv.appendChild(sm);
                tdWf.appendChild(wfDiv);
                tr.appendChild(tdWf);

                /* ── Actions cell ── */
                var tdAct = document.createElement('td');
                tdAct.className = 'rx-act';
                tdAct.dataset.rxid     = rx.id;
                tdAct.dataset.del      = isDeleted ? '1' : '0';
                tdAct.dataset.candelete = rxP.canDelete ? '1' : '0';
                tdAct.dataset.canedit  = rxP.canEdit ? '1' : '0';
                tdAct.dataset.canadd   = rxP.canAdd ? '1' : '0';
                tdAct.dataset.canundo  = rxP.canUndo ? '1' : '0';
                tdAct.dataset.canwh    = rxP.canWarehouse ? '1' : '0';
                tr.appendChild(tdAct);

                tbody.appendChild(tr);
            }

            /* Wire action buttons for each rx-act td */
            tbody.querySelectorAll('td.rx-act').forEach(function(td) {
                var rxid   = parseInt(td.dataset.rxid);
                var isDel  = td.dataset.del === '1';
                var canDel = td.dataset.candelete === '1';
                var canEd  = td.dataset.canedit === '1';
                var canAdd = td.dataset.canadd === '1';
                var canUnd = td.dataset.canundo === '1';
                var canWh  = td.dataset.canwh === '1';
                var b;
                b = document.createElement('button'); b.className = 'btn btn-sm btn-outline-dark me-1'; b.title = 'View Details'; b.innerHTML = '<i class="fas fa-eye"></i>'; b.dataset.id = rxid; b.addEventListener('click', function() { viewRxDetail(parseInt(this.dataset.id)); }); td.appendChild(b);
                if (isDel) {
                    if (canDel) { b = document.createElement('button'); b.className = 'btn btn-sm btn-outline-success'; b.title = 'Restore'; b.innerHTML = '<i class="fas fa-undo me-1"></i>Restore'; b.dataset.id = rxid; b.addEventListener('click', function() { restoreRx(parseInt(this.dataset.id)); }); td.appendChild(b); }
                    else { var s = document.createElement('span'); s.className = 'text-muted small'; s.textContent = 'Hidden'; td.appendChild(s); }
                } else {
                    b = document.createElement('button'); b.className = (canEd||canAdd||canUnd||canWh) ? 'btn btn-sm btn-outline-info me-1' : 'btn btn-sm btn-outline-secondary me-1'; b.title = 'Workflow'; b.innerHTML = '<i class="fas fa-tasks"></i>'; b.dataset.id = rxid; b.addEventListener('click', function() { openWorkflow(parseInt(this.dataset.id)); }); td.appendChild(b);
                    b = document.createElement('button'); b.className = 'btn btn-sm btn-outline-secondary me-1'; b.title = 'View History'; b.innerHTML = '<i class="fas fa-history"></i>'; b.dataset.id = rxid; b.addEventListener('click', function() { openRxHistory(parseInt(this.dataset.id)); }); td.appendChild(b);
                    b = document.createElement('button'); b.className = 'btn btn-sm btn-outline-primary me-1'; b.title = 'Print / Export'; b.innerHTML = '<i class="fas fa-print"></i>'; b.dataset.id = rxid; b.addEventListener('click', function() { printRxRecord(parseInt(this.dataset.id)); }); td.appendChild(b);
                    if (canDel) { b = document.createElement('button'); b.className = 'btn btn-sm btn-outline-danger'; b.title = 'Hide Record'; b.innerHTML = '<i class="fas fa-eye-slash"></i>'; b.dataset.id = rxid; b.addEventListener('click', function() { deleteRx(parseInt(this.dataset.id)); }); td.appendChild(b); }
                }
            });

            /* Sync select-all checkbox state */
            var allCbs = tbody.querySelectorAll('.rx-row-cb');
            var saEl = document.getElementById('rxSelectAll');
            if (saEl) saEl.indeterminate = false;
        }
        _rxUpdateBulkBar();
        document.getElementById('rxPageInfo').textContent = 'Showing ' + (filteredRx.length === 0 ? 0 : Math.min(start+1, filteredRx.length)) + '–' + Math.min(start+rxPageSize, filteredRx.length) + ' of ' + filteredRx.length;
        var rxPages = Math.ceil(filteredRx.length / rxPageSize) || 1;
        // Smart ellipsis paginator
        var rxIsFirst = rxPage === 1; var rxIsLast = rxPage >= rxPages;
        var rxPh = '<li class="page-item' + (rxIsFirst ? ' disabled' : '') + '"><a class="page-link" href="#" data-pg="' + (rxPage-1) + '">&laquo;</a></li>';
        var rxDelta = 2;
        var rxLo = Math.max(2, rxPage - rxDelta);
        var rxHi = Math.min(rxPages - 1, rxPage + rxDelta);
        rxPh += '<li class="page-item' + (rxPage===1 ? ' active' : '') + '"><a class="page-link" href="#" data-pg="1">1</a></li>';
        if (rxLo > 2) rxPh += '<li class="page-item disabled"><span class="page-link">&hellip;</span></li>';
        for (var rxi=rxLo; rxi<=rxHi; rxi++) rxPh += '<li class="page-item' + (rxi===rxPage ? ' active' : '') + '"><a class="page-link" href="#" data-pg="' + rxi + '">' + rxi + '</a></li>';
        if (rxHi < rxPages - 1) rxPh += '<li class="page-item disabled"><span class="page-link">&hellip;</span></li>';
        if (rxPages > 1) rxPh += '<li class="page-item' + (rxPage===rxPages ? ' active' : '') + '"><a class="page-link" href="#" data-pg="' + rxPages + '">' + rxPages + '</a></li>';
        rxPh += '<li class="page-item' + (rxIsLast ? ' disabled' : '') + '"><a class="page-link" href="#" data-pg="' + (rxPage+1) + '">&raquo;</a></li>';
        var rxPagEl = document.getElementById('rxPagination');
        rxPagEl.innerHTML = rxPh;
        rxPagEl.addEventListener('click', function(e) { e.preventDefault(); var a = e.target.closest('a[data-pg]'); if (!a) return; goRxPage(parseInt(a.dataset.pg)); });
    }

    function sortRx(col) {
        if (rSortCol === col) {
            rSortDir = rSortDir === 'asc' ? 'desc' : 'asc';
        } else {
            rSortCol = col;
            rSortDir = 'asc';
        }
        rxPage = 1;
        renderRx();
    }

    function updateRxSortIcons() {
        ['id', 'Patient.firstName', 'serviceDate', 'Pharmacy.name'].forEach(function(c) {
            const icon = document.getElementById('srIcon_' + c);
            if (icon) {
                icon.className = c === rSortCol 
                    ? (rSortDir === 'asc' ? 'fas fa-sort-up ms-1' : 'fas fa-sort-down ms-1') 
                    : 'fas fa-sort text-muted ms-1';
                icon.style.opacity = c === rSortCol ? '1' : '0.3';
            }
        });
    }

    function goRxPage(p) { const pages = Math.ceil(filteredRx.length/rxPageSize); if(p<1||p>pages)return; rxPage=p; renderRx(); }

    function openRxModal() {
        medCount = 0;
        document.getElementById('medicationsContainer').innerHTML = '';
        // Reset display panel and hidden inputs
        resetRxForm();
        // Reset patient search picker
        const searchInput = document.getElementById('patientSearchInput');
        const hiddenInput = document.getElementById('rxPatientId');
        const dropdown   = document.getElementById('patientDropdown');
        const info       = document.getElementById('patientSelectedInfo');
        if (searchInput) { searchInput.value = ''; searchInput.classList.remove('is-selected'); }
        if (hiddenInput) hiddenInput.value = '';
        if (dropdown)    dropdown.classList.remove('open');
        if (info)        info.textContent = '';
        addMedicationRow();
        new bootstrap.Modal(document.getElementById('rxModal')).show();
    }

    // ---- Patient search picker ----
    function initPatientSearch() {
        const searchInput = document.getElementById('patientSearchInput');
        const hiddenInput = document.getElementById('rxPatientId');
        const dropdown    = document.getElementById('patientDropdown');
        const info        = document.getElementById('patientSelectedInfo');
        if (!searchInput || !dropdown) return;

        let hiIdx = -1;

        function renderDropdown(query) {
            const q = query.trim().toLowerCase();
            const matches = q.length === 0 ? allPatientsList.slice(0, 50) : allPatientsList.filter(p => {
                const name  = (p.firstName + ' ' + p.lastName).toLowerCase();
                const code  = (p.patientCode || '').toLowerCase();
                const idStr = String(p.id);
                return name.includes(q) || code.includes(q) || idStr.includes(q);
            });

            if (matches.length === 0) {
                dropdown.innerHTML = '<div class="patient-dropdown-empty">No patients found.</div>';
            } else {
                // Build via DOM API — FortiGate corrupts template literals in inline scripts
                dropdown.innerHTML = '';
                matches.forEach(function(p, i) {
                    var display   = p.firstName + ' ' + p.lastName;
                    var sub       = [];
                    if (p.patientCode) sub.push('ID: ' + p.patientCode);
                    sub.push('Rec#' + p.id);
                    var subText   = sub.join(' \u00b7 ');
                    var svcDate   = p.serviceDate || '';
                    var ptId      = p.patientTransportCompanyId  || '';
                    var phtId     = p.pharmacyTransportCompanyId || '';
                    var pharmId   = p.pharmacyId || '';
                    var pharmName = (p.Pharmacy && p.Pharmacy.name) ? p.Pharmacy.name : '';
                    if (svcDate)   subText += ' \u00b7 Svc: ' + svcDate;
                    if (pharmName) subText += ' \u00b7 ' + pharmName;

                    var item = document.createElement('div');
                    item.className = 'patient-dropdown-item';
                    item.dataset.id          = p.id;
                    item.dataset.name        = display;
                    item.dataset.idx         = i;
                    item.dataset.serviceDate = svcDate;
                    item.dataset.ptId        = ptId;
                    item.dataset.phtId       = phtId;
                    item.dataset.pharmacyId  = pharmId;

                    var nameDiv = document.createElement('div');
                    nameDiv.className   = 'pat-name';
                    nameDiv.textContent = display;

                    var idDiv = document.createElement('div');
                    idDiv.className   = 'pat-id';
                    idDiv.textContent = subText;

                    item.appendChild(nameDiv);
                    item.appendChild(idDiv);

                    item.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        selectPatient(
                            this.dataset.id,   this.dataset.name,
                            this.dataset.serviceDate, this.dataset.ptId,
                            this.dataset.phtId, this.dataset.pharmacyId
                        );
                    });
                    dropdown.appendChild(item);
                });
            }
            hiIdx = -1;
            dropdown.classList.add('open');
        }

        function selectPatient(id, name, serviceDate, ptId, phtId, pharmId) {
            hiddenInput.value = id;
            searchInput.value = name;
            searchInput.classList.add('is-selected');
            dropdown.classList.remove('open');

            // Resolve display labels from cached lists
            var pharObj = allPharmaciesList.filter(function(p) { return String(p.id) === String(pharmId); })[0];
            var ptObj   = allPtList.filter(function(p)  { return String(p.id) === String(ptId); })[0];
            var phtObj  = allPhtList.filter(function(p)  { return String(p.id) === String(phtId); })[0];

            // Fill hidden values — arrivalDate = patient serviceDate (business rule)
            function setHidden(elId, val) { var el = document.getElementById(elId); if (el) el.value = val || ''; }
            setHidden('rxPharmacyId',       pharmId || '');
            setHidden('rxArrivalDate',       serviceDate || '');
            setHidden('rxServiceDate',       serviceDate || '');
            setHidden('rxPatientTransport',  ptId || '');
            setHidden('rxPharmacyTransport', phtId || '');

            // Fill display inputs
            function setDisp(elId, val) { var el = document.getElementById(elId); if (el) el.value = val || String.fromCharCode(8212); }
            setDisp('rxPharmacyDisplay',         pharObj ? pharObj.name : (pharmId ? 'Pharmacy #' + pharmId : String.fromCharCode(8212)));
            setDisp('rxServiceDisplay',           serviceDate || String.fromCharCode(8212));
            setDisp('rxPatientTransportDisplay',  ptObj  ? (ptObj.contactPerson  || ptObj.companyName)  : (ptId  ? '#' + ptId  : String.fromCharCode(8212)));
            setDisp('rxPharmacyTransportDisplay', phtObj ? (phtObj.companyName || phtObj.contactPerson) : (phtId ? '#' + phtId : String.fromCharCode(8212)));

            // Show info panel
            var panel = document.getElementById('rxPatientInfoPanel');
            if (panel) panel.style.display = '';

            info.innerHTML = '&#10003; <strong>' + name + '</strong> selected &mdash; info loaded below';
        }
        searchInput.addEventListener('focus', () => { renderDropdown(searchInput.value); });
        searchInput.addEventListener('input', () => {
            hiddenInput.value = '';
            searchInput.classList.remove('is-selected');
            info.textContent = '';
            renderDropdown(searchInput.value);
        });

        // Keyboard navigation
        searchInput.addEventListener('keydown', (e) => {
            const items = dropdown.querySelectorAll('.patient-dropdown-item');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                hiIdx = Math.min(hiIdx + 1, items.length - 1);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                hiIdx = Math.max(hiIdx - 1, 0);
            } else if (e.key === 'Enter' && hiIdx >= 0) {
                e.preventDefault();
                const item = items[hiIdx];
                if (item) selectPatient(item.dataset.id, item.dataset.name,
                    item.dataset.serviceDate, item.dataset.ptId, item.dataset.phtId, item.dataset.pharmacyId);
                return;
            } else if (e.key === 'Escape') {
                dropdown.classList.remove('open');
                return;
            }
            items.forEach((it, i) => it.classList.toggle('highlighted', i === hiIdx));
            if (items[hiIdx]) items[hiIdx].scrollIntoView({ block: 'nearest' });
        });


        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!document.getElementById('patientSearchWrapper').contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    }

    function addMedicationRow() {
        medCount++;
        const rowId = 'med_' + medCount;
        const n = medCount;
        const div = document.createElement('div');
        div.className = 'row g-2 align-items-end mb-2 med-row';
        div.id = rowId;
        div.innerHTML = `
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-clipboard-list"></i></span>
                    <input type="text" class="form-control" placeholder="Select or type action..." name="medName_${n}"
                           list="medCatalogList" autocomplete="off"
                           oninput="checkMedCatalog(this)">
                </div>
                <small class="text-warning med-warn" style="display:none;font-size:.7rem">
                    <i class="fas fa-exclamation-triangle me-1"></i>Not in actions list
                </small>
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control form-control-sm" placeholder="#" name="medQty_${n}" min="1" value="1">
            </div>
