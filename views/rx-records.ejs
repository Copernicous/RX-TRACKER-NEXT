    // Loads all dropdown data needed for the New RX modal and workflow selectors.
    // Returns a Promise so DOMContentLoaded can chain .then(loadRxRecords).
    function loadRxDropdowns() {
        var pRes, phRes, ptRes, rxRes, waRes, catRes;
        return fetchWithAuth(window.rxUrl('/api/patients'), { silent: true }).then(function(r) {
            pRes = r;
