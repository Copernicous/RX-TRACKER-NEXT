<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RX Records - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .patient-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0; right: 0;
            z-index: 1055;
            max-height: 220px;
            overflow-y: auto;
            background: var(--surface, #fff);
            border: 1px solid var(--border, #dee2e6);
            border-radius: 0.375rem;
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
            color: var(--text, #1a202c);
        }
        .patient-dropdown.open { display: block; }
        .patient-dropdown-item {
            padding: 8px 14px;
            cursor: pointer;
            border-bottom: 1px solid var(--border, #f0f0f0);
            transition: background 0.15s;
            color: var(--text, #1a202c);
        }
        .patient-dropdown-item:last-child { border-bottom: none; }
        .patient-dropdown-item:hover,
        .patient-dropdown-item.highlighted { background: rgba(99,102,241,0.12); }
        .patient-dropdown-item .pat-name  { font-weight: 600; font-size: 0.9rem; color: var(--text, #1a202c); }
        .patient-dropdown-item .pat-id    { font-size: 0.78rem; color: var(--text-muted, #6c757d); }
        .patient-dropdown-empty { padding: 10px 14px; color: var(--text-muted, #6c757d); font-size: 0.85rem; }
        #patientSearchInput.is-selected { border-color: #6366f1; }
        #rxTable tbody tr.rx-inactive-row > td {
            background: #efe6c9 !important;
            color: #1f2937 !important;
        }
        #rxTable tbody tr.rx-inactive-row > td .text-muted,
        #rxTable tbody tr.rx-inactive-row > td small,
        #rxTable tbody tr.rx-inactive-row > td .badge {
            color: inherit;
        }
        #rxTable tbody tr.rx-inactive-row > td .btn-outline-info,
        #rxTable tbody tr.rx-inactive-row > td .btn-outline-secondary,
        #rxTable tbody tr.rx-inactive-row > td .btn-outline-primary,
        #rxTable tbody tr.rx-inactive-row > td .btn-outline-danger {
            opacity: 0.95;
        }
        .rx-filter-multiselect .dropdown-menu { width:100%; min-width:260px; padding:.5rem; color:var(--text); }
        .rx-filter-multiselect { width:100%; }
        .rx-filter-multiselect > .dropdown-toggle { display:flex; align-items:center; min-width:0; }
        .rx-filter-multiselect > .dropdown-toggle > span { flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .rx-filter-multiselect-search { margin-bottom:.4rem; }
        .rx-filter-multiselect-options { max-height:185px; overflow-y:auto; }
        .rx-filter-multiselect-option { display:flex; align-items:center; gap:.45rem; padding:.25rem .1rem; font-size:.82rem; color:var(--text); cursor:pointer; }
        .rx-filter-multiselect-option:hover { background:rgba(74,144,226,.14); }
        .rx-filter-multiselect-option input { accent-color:var(--primary); }
        [data-theme="dark"] .rx-filter-multiselect .dropdown-menu { background:#1f2937 !important; border-color:#4b5563 !important; }
        [data-theme="dark"] .rx-filter-multiselect-option { color:#f8fafc !important; }
        [data-theme="dark"] .rx-filter-multiselect-search { background:#111827 !important; border-color:#4b5563 !important; color:#f8fafc !important; }
    </style>
</head>
<body>
<div class="wrapper">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>

<div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold fs-5">RX Records</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">
            <div class="glass-card p-3 mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold small text-muted text-uppercase" style="letter-spacing:.05em"><i class="fas fa-filter me-1"></i>Search &amp; Filter</span>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-link btn-sm text-muted p-0" onclick="toggleRxPanel()" style="font-size:.78rem;text-decoration:none">
                            <i class="fas fa-sliders-h me-1"></i>Advanced <i class="fas fa-chevron-down ms-1" id="rxAdvChevron"></i>
                        </button>
                    </div>
                </div>
                <!-- Basic row -->
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small fw-bold"><i class="fas fa-user me-1"></i>Patient Name</label>
                        <input type="text" class="form-control form-control-sm" id="rxFilterPatient" placeholder="First or last name...">
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small fw-bold">RX #</label>
                        <input type="text" class="form-control form-control-sm" id="rxFilterId" placeholder="RX number">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold"><i class="fas fa-clinic-medical me-1"></i>Pharmacy</label>
                        <input type="hidden" id="rxFilterPharmacy">
                        <div class="dropdown rx-filter-multiselect" id="rxFilterPharmacyPicker">
                            <button class="form-select form-select-sm text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"><span>All Pharmacies</span></button>
                            <div class="dropdown-menu"><input class="form-control form-control-sm rx-filter-multiselect-search" type="search" placeholder="Type to find pharmacy..."><div class="rx-filter-multiselect-options"></div></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold"><i class="fas fa-hospital me-1"></i>Clinic</label>
                        <input type="hidden" id="rxFilterClinic">
                        <div class="dropdown rx-filter-multiselect" id="rxFilterClinicPicker">
                            <button class="form-select form-select-sm text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"><span>All Clinics</span></button>
                            <div class="dropdown-menu"><input class="form-control form-control-sm rx-filter-multiselect-search" type="search" placeholder="Type to find clinic..."><div class="rx-filter-multiselect-options"></div></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold"><i class="fas fa-tasks me-1"></i>Workflow Status</label>
                        <input type="hidden" id="rxFilterWorkflowStatus">
                        <div class="dropdown rx-filter-multiselect" id="rxFilterWorkflowStatusPicker">
                            <button class="form-select form-select-sm text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"><span>All Workflow</span></button>
                            <div class="dropdown-menu"><input class="form-control form-control-sm rx-filter-multiselect-search" type="search" placeholder="Type to find status..."><div class="rx-filter-multiselect-options"></div></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold"><i class="fas fa-check-circle me-1"></i>Current Stage</label>
                        <input type="hidden" id="rxFilterCurrentWorkflowStage">
                        <div class="dropdown rx-filter-multiselect" id="rxFilterCurrentWorkflowStagePicker">
                            <button class="form-select form-select-sm text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"><span>All Current Stages</span></button>
                            <div class="dropdown-menu"><input class="form-control form-control-sm rx-filter-multiselect-search" type="search" placeholder="Type to find current stage..."><div class="rx-filter-multiselect-options"></div></div>
                        </div>
                    </div>
                    <div class="col-md-1 d-flex gap-1 align-items-end">
                        <button class="btn btn-primary btn-sm btn-search" id="rxFilterBtn" title="Search"><i class="fas fa-search"></i></button>
                        <button class="btn btn-outline-secondary btn-sm" id="rxClearBtn"><i class="fas fa-times"></i></button>
                    </div>
                </div>
                <!-- Advanced row -->
                <div id="rxAdvPanel" style="display:none;border-top:1px solid var(--border-color,#dee2e6);margin-top:10px;padding-top:10px">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-id-badge me-1"></i>Patient ID</label>
                            <input type="text" class="form-control form-control-sm" id="rxFilterPatientCode" placeholder="e.g. PAT-00001">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service Date From</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterDateFrom">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service Date To</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterDateTo">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service From</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterSvcFrom">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service To</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterSvcTo">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-truck me-1"></i>Patient Transport</label>
                            <select class="form-select form-select-sm" id="rxFilterPatientTransport">
                                <option value="">All Patient Transports</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-truck me-1"></i>Pharmacy Transport</label>
                            <select class="form-select form-select-sm" id="rxFilterPharmacyTransport">
                                <option value="">All Pharmacy Transports</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-warehouse me-1"></i>Warehouse Status</label>
                            <select class="form-select form-select-sm" id="rxFilterWarehouseStatus">
                                <option value="">All Warehouse Statuses</option>
                                <option value="returned">Returned to Warehouse</option>
                                <option value="not-returned">Not Returned</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-alt me-1"></i>Current Stage Date From</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterCurrentStageDateFrom" title="Date the actual Current Stage was completed">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-alt me-1"></i>Current Stage Date To</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterCurrentStageDateTo" title="Date the actual Current Stage was completed">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-building me-1"></i>Patient Type</label>
                            <select class="form-select form-select-sm" id="rxFilterPatientType">
                                <option value="">All Patient Types</option>
                                <option value="company">Company Patients</option>
                                <option value="non_company">Non-Company Patients</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="rxShowDeleted">
                                <label class="form-check-label small" for="rxShowDeleted">Show Hidden Records</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0">RX Records</h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" id="rxDeliveryLogPdfBtn" data-role-action="print" title="Open the filtered delivery log for printing or saving as PDF"><i class="fas fa-file-pdf me-1"></i>Delivery Log PDF</button>
                        <button class="btn btn-outline-success btn-sm" id="rxDeliveryLogExcelBtn" data-role-action="export" title="Download the filtered delivery log as a formatted Excel workbook"><i class="fas fa-file-excel me-1"></i>Delivery Log Excel</button>
                        <button class="btn btn-outline-success btn-sm" id="exportRxListCsvBtn"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
                        <button class="btn btn-success btn-sm" id="addRxBtn"><i class="fas fa-plus me-1"></i>New RX</button>
                    </div>
