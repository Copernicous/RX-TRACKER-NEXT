    function _rxBulkApply() {
        var sel = document.getElementById('rxBulkStepSel');
        var actionId = sel ? sel.value : '';
        if (!actionId) { showToast('Please choose a workflow step first.', 'warning'); return; }
        var n = _rxBulkSel.size;
        if (n === 0)   { showToast('No records selected.', 'warning'); return; }

        /* Collect IDs */
        var ids = [];
        _rxBulkSel.forEach(function(v) { ids.push(v); });

        /* Find action name for confirmation */
        var stepName = sel.options[sel.selectedIndex].textContent;
        if (!confirm('Apply step "' + stepName + '" to ' + n + ' selected record(s)?\n\nRecords that have not completed the previous step will be skipped.')) return;

        /* Disable button while running */
        var applyBtn = document.getElementById('rxBulkApplyBtn');
        if (applyBtn) { applyBtn.disabled = true; applyBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Working...'; }

        fetchWithAuth('/api/rx-records/bulk-workflow', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rxIds: ids, actionId: parseInt(actionId, 10) })
        }).then(function(res) {
            if (!res) throw new Error('No response');
            return res.json();
        }).then(function(data) {
            _rxShowBulkResults(data, stepName);
            // IMPROVE-03: also show a toast summary so users see result even after overlay closes
            var ok  = data.succeeded || 0;
            var bad = data.failed    || 0;
            var sn  = data.action ? data.action.name : stepName;
            if (bad === 0) {
                showToast(ok + ' record' + (ok !== 1 ? 's' : '') + ' updated — ' + sn, 'success');
            } else {
                showToast(ok + ' updated, ' + bad + ' skipped — ' + sn, 'warning');
            }
            _rxBulkSel.clear();
            _rxUpdateBulkBar();
            loadRxRecords();
            /* Restore button on success */
            if (applyBtn) { applyBtn.disabled = false; applyBtn.innerHTML = '<i class="fas fa-play me-1"></i>Apply to Selected'; }
        }).catch(function(err) {
            showToast('Bulk update failed: ' + (err.message || 'Unknown error'), 'danger');
            /* Restore button on error */
            if (applyBtn) { applyBtn.disabled = false; applyBtn.innerHTML = '<i class="fas fa-play me-1"></i>Apply to Selected'; }
        });
    }



    function _rxShowBulkResults(data, stepName) {
        var overlay = document.getElementById('rxBulkResultOverlay');
        var title   = document.getElementById('rxBulkResTitle');
        var summary = document.getElementById('rxBulkResSummary');
        var list    = document.getElementById('rxBulkResList');
        if (!overlay) return;

        var succeeded = data.succeeded || 0;
        var failed    = data.failed    || 0;
        var results   = data.results   || [];

        if (title)   title.textContent = 'Results \u2014 ' + (data.action ? data.action.name : stepName);

        /* Summary bar */
        var summaryHtml = '<div style="display:flex;gap:12px;margin-bottom:10px">';
        summaryHtml += '<span style="background:#dcfce7;color:#16a34a;border-radius:6px;padding:6px 14px;font-weight:700"><i class="fas fa-check me-1"></i>' + succeeded + ' succeeded</span>';
        summaryHtml += '<span style="background:#fee2e2;color:#dc2626;border-radius:6px;padding:6px 14px;font-weight:700"><i class="fas fa-times me-1"></i>' + failed + ' failed</span>';
        summaryHtml += '</div>';
        if (summary) summary.innerHTML = summaryHtml;

        /* Per-record list */
        if (list) {
            list.innerHTML = '';
            for (var i = 0; i < results.length; i++) {
                var r   = results[i];
                var row = document.createElement('div');
                row.style.cssText = 'display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid #f0f0f0';
                var icon = document.createElement('span');
                icon.style.cssText = 'font-size:1rem;min-width:18px;text-align:center';
                if (r.ok) {
                    icon.innerHTML = '<i class="fas fa-check-circle" style="color:#16a34a"></i>';
                } else {
                    icon.innerHTML = '<i class="fas fa-times-circle" style="color:#dc2626"></i>';
                }
                var label = document.createElement('span');
                label.style.cssText = 'flex:1;font-size:.88rem';
                var patName = r.patientName ? (' \u2014 ' + r.patientName) : '';
                var noteStr = r.skipped ? ' <em style="color:#888">(already done)</em>' : (r.error ? ' <span style="color:#dc2626">' + r.error + '</span>' : '');
                label.innerHTML = '<strong>RX #' + r.rxId + '</strong>' + patName + noteStr;
                row.appendChild(icon);
                row.appendChild(label);
                list.appendChild(row);
            }
        }

        overlay.style.display = 'flex';
    }

    /* Wire close button */
    document.addEventListener('DOMContentLoaded', function() {
        var closeBtn = document.getElementById('rxBulkResClose');
        if (closeBtn) closeBtn.addEventListener('click', function() {
            var ov = document.getElementById('rxBulkResultOverlay');
            if (ov) ov.style.display = 'none';
        });
        /* Click outside to close */
        var overlay = document.getElementById('rxBulkResultOverlay');
        if (overlay) overlay.addEventListener('click', function(e) {
            if (e.target === overlay) overlay.style.display = 'none';
        });
        /* Clear button */
        var clearBtn = document.getElementById('rxBulkClearBtn');
        if (clearBtn) clearBtn.addEventListener('click', function() {
            _rxBulkSel.clear();
            var tbody = document.getElementById('rxBody');
            if (tbody) tbody.querySelectorAll('.rx-row-cb').forEach(function(cb) { cb.checked = false; });
            _rxUpdateBulkBar();
        });
        /* Apply button */
        var applyBtn = document.getElementById('rxBulkApplyBtn');
        if (applyBtn) applyBtn.addEventListener('click', _rxBulkApply);
        /* Select-all header checkbox */
        var saEl = document.getElementById('rxSelectAll');
        if (saEl) saEl.addEventListener('change', function() {
            var tbody = document.getElementById('rxBody');
            if (!tbody) return;
            var cbs = tbody.querySelectorAll('.rx-row-cb');
            for (var i = 0; i < cbs.length; i++) {
                cbs[i].checked = saEl.checked;
                var id = parseInt(cbs[i].dataset.rxid);
                if (saEl.checked) { _rxBulkSel.add(id); } else { _rxBulkSel.delete(id); }
            }
            _rxUpdateBulkBar();
        });
    });

