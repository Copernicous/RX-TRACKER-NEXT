                var dl = document.getElementById('medCatalogList');
                if (!dl) { dl = document.createElement('datalist'); dl.id = 'medCatalogList'; document.body.appendChild(dl); }
                dl.innerHTML = '';
                allMedCatalog.forEach(function(m) { var opt = document.createElement('option'); opt.value = m.name; dl.appendChild(opt); });
            }
            console.log('[RX] Patients loaded:', allPatientsList.length, '| Pharmacies:', allPharmaciesList.length);
        } catch(e) { console.error('[RX] loadRxDropdowns error:', e); }
        // Always init patient search — even if some calls failed
        initPatientSearch();
    }

    // Reset all display fields and hide the info panel (called on modal open)
    function resetRxForm() {
        var panel = document.getElementById('rxPatientInfoPanel');
        if (panel) panel.style.display = 'none';
        ['rxPharmacyDisplay','rxServiceDisplay',
         'rxPatientTransportDisplay','rxPharmacyTransportDisplay'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.value = '';
        });
        ['rxPharmacyId','rxArrivalDate','rxServiceDate',
         'rxPatientTransport','rxPharmacyTransport'].forEach(function(id) {
