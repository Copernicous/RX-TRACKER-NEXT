    function promptResetCycle(rxId) {
        /* Build a simple inline modal-free prompt inside workflowBody */
        var body = document.getElementById('workflowBody');
        var today = new Date().toISOString().slice(0,10);

        var existing = document.getElementById('resetCycleForm');
        if (existing) { existing.remove(); }

        var form = document.createElement('div');
        form.id = 'resetCycleForm';
        form.className = 'alert alert-warning mt-3 p-3';
        form.innerHTML =
            '<strong><i class="fas fa-redo me-2"></i>Start New 90-Day Cycle</strong>' +
            '<p class="small mb-2 mt-1">This will <strong>clear all workflow progress</strong> for this RX and start a fresh cycle with the new service date.</p>' +
            '<div class="d-flex align-items-center gap-2 flex-wrap">' +
            '<label class="mb-0 small fw-semibold">New Service Date:</label>' +
            '<input type="date" class="form-control form-control-sm" id="resetCycleDateInput" style="width:160px" max="' + today + '">' +
            '<button class="btn btn-sm btn-danger fw-semibold" id="resetCycleConfirmBtn"><i class="fas fa-check me-1"></i>Confirm Reset</button>' +
            '<button class="btn btn-sm btn-outline-secondary" id="resetCycleCancelBtn">Cancel</button>' +
            '</div>';
        body.appendChild(form);

        document.getElementById('resetCycleCancelBtn').addEventListener('click', function() { form.remove(); });
        document.getElementById('resetCycleConfirmBtn').addEventListener('click', function() {
            var _btn = this;
            var inp = document.getElementById('resetCycleDateInput');
            if (!inp || !inp.value) { showToast('Please select a new service date.', 'warning'); return; }
            var confirmMsg = 'Are you sure? This will DELETE all workflow tracking for this RX record and start a new cycle.\n\nNew service date: ' + inp.value;
            if (!confirm(confirmMsg)) return;
            _btn.disabled = true;
            _btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            fetchWithAuth(window.rxUrl('/api/rx-records/') + rxId + '/reset-cycle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newServiceDate: inp.value })
            }).then(function(res) {
                if (!res) { _btn.disabled = false; _btn.innerHTML = '<i class="fas fa-check me-1"></i>Confirm Reset'; return; }
                if (res.ok) {
                    return res.json().then(function(data) {
                        showToast('New cycle started. ' + data.trackingsCleared + ' tracking record(s) cleared.', 'success');
                        form.remove();
                        return openWorkflow(rxId).then(function() { return loadRxRecords(); });
                    });
                } else {
                    return res.json().then(function(err) {
                        showToast(err.error || 'Reset failed.', 'danger');
                        _btn.disabled = false;
                        _btn.innerHTML = '<i class="fas fa-check me-1"></i>Confirm Reset';
                    });
                }
            }).catch(function() {
                showToast('Network error.', 'danger');
                _btn.disabled = false;
                _btn.innerHTML = '<i class="fas fa-check me-1"></i>Confirm Reset';
            });
        });
    }

    function returnToWarehouse() {
        var rxId = window._workflowRxId;
        if (!rxId) return;
        var noteEl = document.getElementById('warehouseNoteInput');
        var note = (noteEl ? noteEl.value : '').trim();
        var msg = 'Return this RX to the warehouse?\n\nThe workflow will reset to Step 1 (Warehouse) \u2014 all steps after Step 1 will be cleared.\n\nThe RX will be marked as returned to warehouse.';
        if (!confirm(msg)) return;
        var btn = document.getElementById('returnToWarehouseBtn');
        btn.disabled = true;
        var orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
        fetchWithAuth(window.rxUrl('/api/rx-records/return-to-warehouse'), {
            method: 'POST',
            body: JSON.stringify({ rxId: rxId, note: note })
        }).then(function(res) {
            if (!res) { btn.disabled = false; btn.innerHTML = orig; return; }
            if (res.ok) {
                showToast('RX returned to warehouse. Workflow reset to Step 1.', 'warning');
                if (noteEl) noteEl.value = '';
                return openWorkflow(rxId).then(function() { return loadRxRecords(); });
            } else {
                return res.json().then(function(err) { showToast(err.error || 'Return failed', 'danger'); });
            }
        }).catch(function() { showToast('Network error.', 'danger'); })
        .then(function() { btn.disabled = false; btn.innerHTML = orig; });
    }

    function deleteRx(id) {
        if (!confirm('Hide this RX record? You can restore it later from "Show Hidden Records".')) return;
        fetchWithAuth(window.rxUrl('/api/rx-records/') + id, { method: 'DELETE' })
        .then(function(res) {
            if (res && res.ok) { showToast('RX Record hidden.', 'success'); return loadRxRecords(); }
            else showToast('Failed to hide record.', 'danger');
        }).catch(function() { showToast('Network error.', 'danger'); });
    }

    function restoreRx(id) {
        fetchWithAuth(window.rxUrl('/api/rx-records/') + id + '/restore', { method: 'PUT' })
        .then(function(res) {
            if (res && res.ok) { showToast('RX Record restored.', 'success'); return loadRxRecords(); }
            else showToast('Restore failed.', 'danger');
        }).catch(function() { showToast('Network error.', 'danger'); });
    }

    // ---- RX History ----
    function openRxHistory(rxId) {
        var bodyEl = document.getElementById('rxHistoryBody');
        bodyEl.innerHTML = '<p class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading history...</p>';
        var modal = new bootstrap.Modal(document.getElementById('rxHistoryModal'));
        modal.show();
        fetchWithAuth(window.rxUrl('/api/rx-records/') + rxId + '/history')
        .then(function(res) {
            if (!res || !res.ok) { bodyEl.innerHTML = '<p class="text-center text-danger py-4">Failed to load history.</p>'; return; }
            return res.json().then(function(history) {
                if (!history.length) {
                    bodyEl.innerHTML = '<p class="text-center text-muted py-4">No history recorded yet for this RX record.</p>';
                    return;
                }

                var typeColors = { Create:'success', Update:'primary', Workflow:'info', Delete:'danger', Restore:'warning' };
                var typeIcons  = { Create:'plus-circle', Update:'edit', Workflow:'tasks', Delete:'eye-slash', Restore:'undo' };

                var html = '<p class="text-muted small mb-3"><i class="fas fa-info-circle me-1"></i>' +
                           history.length + ' history entr' + (history.length === 1 ? 'y' : 'ies') + ' \u2014 most recent first</p>' +
                           '<div class="timeline">';

                history.forEach(function(h, i) {
                    var dt    = new Date(h.createdAt);
                    var date  = dt.toLocaleDateString();
                    var time  = dt.toLocaleTimeString();
                    var user  = h.ChangedBy
                        ? (h.ChangedBy.username || (h.ChangedBy.firstName + ' ' + h.ChangedBy.lastName))
                        : 'System';
                    var color = typeColors[h.changeType] || 'secondary';
                    var icon  = typeIcons[h.changeType]  || 'circle';

                    var changedHtml = '';
                    if (h.changedFields) {
                        var fields = JSON.parse(h.changedFields);
                        if (fields.length) {
                            changedHtml = '<table class="table table-sm table-bordered mt-2" style="font-size:0.8rem">' +
                                '<thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead><tbody>' +
                                fields.map(function(f) {
                                    return '<tr><td class="fw-bold">' + f.field + '</td>' +
                                           '<td class="text-danger">'  + (f.from || '\u2014') + '</td>' +
                                           '<td class="text-success">' + (f.to   || '\u2014') + '</td></tr>';
                                }).join('') +
                                '</tbody></table>';
                        }
                    }

                    var connector = (i < history.length - 1)
                        ? '<div class="mx-auto" style="width:2px;background:var(--border-color,#dee2e6);min-height:20px"></div>'
                        : '';

                    html += '<div class="d-flex gap-3 mb-3">' +
                              '<div class="flex-shrink-0 text-center" style="width:48px">' +
                                '<div class="rounded-circle bg-' + color + ' text-white d-flex align-items-center justify-content-center mx-auto mb-1" style="width:36px;height:36px">' +
                                  '<i class="fas fa-' + icon + '" style="font-size:0.85rem"></i>' +
                                '</div>' + connector +
                              '</div>' +
                              '<div class="flex-grow-1 pb-2" style="border-bottom:1px solid var(--border-color,#dee2e6)">' +
                                '<div class="d-flex justify-content-between align-items-start flex-wrap gap-1">' +
                                  '<div>' +
                                    '<span class="badge bg-' + color + ' me-1">' + h.changeType + '</span>' +
                                    '<strong class="small">' + user + '</strong>' +
                                    (h.note ? '<span class="text-muted small ms-2">\u2014 ' + h.note + '</span>' : '') +
                                  '</div>' +
                                  '<small class="text-muted">' + date + ' ' + time + '</small>' +
                                '</div>' +
                                changedHtml +
                              '</div>' +
                            '</div>';
                });

                html += '</div>';
                bodyEl.innerHTML = html;
            });
        }).catch(function() { bodyEl.innerHTML = '<p class="text-center text-danger py-4">Error loading history.</p>'; });
    }



    // ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ RX Print / PDF ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬
    var _rxPrintData  = null;
    var _rxPrintLayout = 'card';

    document.querySelectorAll('input[name="rxPrintLayout"]').forEach(function(r) {
        r.addEventListener('change', function() {
            _rxPrintLayout = this.value;
            if (_rxPrintData) switchRxPrintLayout();
        });
    });

    function switchRxPrintLayout() {
        var body    = document.getElementById('rxPrintBody');
        var card    = document.getElementById('rxPrintContentCard');
        var classic = document.getElementById('rxPrintContentClassic');
        if (!card || !classic) return;
        if (_rxPrintLayout === 'card') {
            card.style.display    = '';
            classic.style.display = 'none';
            body.style.background = '#f0f2f5';
        } else {
            card.style.display    = 'none';
            classic.style.display = '';
            body.style.background = '#fff';
        }
    }

    function printRxRecord(id) {
        var bodyEl2 = document.getElementById('rxPrintBody');
        bodyEl2.innerHTML = '<p class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin me-2"></i>Loading record...</p>';
        _rxPrintLayout = 'card';
        var cardRadio = document.getElementById('rxLayoutCard');
        if (cardRadio) cardRadio.checked = true;
        var modal = new bootstrap.Modal(document.getElementById('rxPrintModal'));
        modal.show();

        var rx = null;
        for (var _rxi = 0; _rxi < allRx.length; _rxi++) { if (allRx[_rxi].id === id) { rx = allRx[_rxi]; break; } }
        if (!rx) { bodyEl2.innerHTML = '<p class="text-danger text-center py-4">Record not found.</p>'; return; }
        _rxPrintData = { rx: rx };

        var patient      = rx.Patient || {};
        var pharmacy     = rx.Pharmacy || {};
        var trackings    = rx.RXWorkflowTrackings || [];
        var totalSteps   = allWorkflowActions.length;
        var doneCount    = trackings.length;
        var pct          = totalSteps > 0 ? Math.round((doneCount / totalSteps) * 100) : 0;
        var printDate    = new Date().toLocaleString();

        var STEP_COLORS = ['#4a90e2','#7b61ff','#fd7e14','#20c997','#e24a9a','#50e3c2','#f5a623'];

        // Build workflow checklist for card
        // Helper: whole days between two dates
        function _daysBetween(d1, d2) {
            var t1 = new Date(d1); t1.setHours(0,0,0,0);
            var t2 = new Date(d2); t2.setHours(0,0,0,0);
            return Math.round((t2 - t1) / 864e5);
        }
        // Pre-build ordered date anchors: [serviceDate, step1Date, step2Date, ...]
        var _svcAnchor = rx.serviceDate ? new Date(rx.serviceDate) : null;

        // Build workflow checklist for card
        const stepsCardHtml = allWorkflowActions.map(function(wa, i) {
            var tracking   = trackings.find(function(t) { return t.workflowActionId === wa.id; });
            var done       = !!tracking;
            var dateStr    = done && tracking.completionDate ? new Date(tracking.completionDate).toLocaleDateString() : '';
            var color      = done ? '#198754' : STEP_COLORS[i % STEP_COLORS.length];
            var icon       = done ? 'fa-check-circle' : 'fa-circle';
            var label      = done ? 'color:#198754;font-weight:600' : 'color:#888';
            // Days since previous event
            var lagStr = '';
            if (done && tracking.completionDate) {
                var prevDate = null;
                if (i === 0) {
                    prevDate = _svcAnchor;
                } else {
                    var prevWa = allWorkflowActions[i-1];
                    var prevTk = trackings.find(function(t) { return t.workflowActionId === prevWa.id; });
                    if (prevTk && prevTk.completionDate) prevDate = new Date(prevTk.completionDate);
                }
                if (prevDate) {
                    var days = _daysBetween(prevDate, new Date(tracking.completionDate));
                    var prevRef = (i === 0) ? 'service date' : 'prev. step';
                    lagStr = days === 0 ? 'same as ' + prevRef : '+' + days + 'd from ' + prevRef;
                }
            }
            var lagHtml = (done && lagStr) ? '<span style="font-size:.68rem;color:#6c757d;margin-left:4px">(' + lagStr + ')</span>' : '';
            var badge   = done ? '<span style="margin-left:auto;font-size:.7rem;color:#198754;background:#19875415;padding:2px 8px;border-radius:10px">&#10003; ' + dateStr + '</span>' + lagHtml : '';
            return '<div style="display:flex;align-items:center;gap:10px;padding:6px 0;border-bottom:1px solid #f0f0f0">' +
                   '<i class="fas ' + icon + '" style="color:' + color + ';font-size:1rem;flex-shrink:0"></i>' +
                   '<span style="' + label + ';font-size:.87rem">' + wa.name + '</span>' +
                   badge +
                   '</div>';
        }).join('');


        // Build workflow steps for classic
        const stepsClassicHtml = allWorkflowActions.map(function(wa, i) {
            var tracking  = trackings.find(function(t) { return t.workflowActionId === wa.id; });
            var done      = !!tracking;
            var dateStr   = done && tracking.completionDate ? new Date(tracking.completionDate).toLocaleDateString() : '&mdash;';
            // Days lag
            var lagTd = '<td style="padding:5px 8px;border-bottom:1px solid #dee2e6;text-align:center;color:#6c757d;font-size:.82rem">&mdash;</td>';
            if (done && tracking.completionDate) {
                var prevDate2 = null;
                if (i === 0) {
                    prevDate2 = _svcAnchor;
                } else {
                    var prevWa2 = allWorkflowActions[i-1];
                    var prevTk2 = trackings.find(function(t) { return t.workflowActionId === prevWa2.id; });
                    if (prevTk2 && prevTk2.completionDate) prevDate2 = new Date(prevTk2.completionDate);
                }
                if (prevDate2) {
                    var days2 = _daysBetween(prevDate2, new Date(tracking.completionDate));
                    var lagColor = days2 <= 1 ? '#198754' : days2 <= 3 ? '#fd7e14' : '#dc3545';
                    var prevRef2  = (i === 0) ? 'service date' : 'prev. step';
                    var lagLabel  = days2 === 0 ? 'Same as ' + prevRef2 : '+' + days2 + ' day' + (days2 === 1 ? '' : 's') + ' from ' + prevRef2;
                    lagTd = '<td style="padding:5px 8px;border-bottom:1px solid #dee2e6;text-align:center;color:' + lagColor + ';font-weight:600;font-size:.82rem">' + lagLabel + '</td>';
                }
            }
            var statusTd  = done
                ? '<td style="padding:5px 8px;border-bottom:1px solid #dee2e6;text-align:center;color:#198754;font-weight:600">&#10003;</td>'
                : '<td style="padding:5px 8px;border-bottom:1px solid #dee2e6;text-align:center;color:#aaa">&#8212;</td>';
            return '<tr>' +
                   '<td style="padding:5px 8px;border-bottom:1px solid #dee2e6">' + (i+1) + '. ' + wa.name + '</td>' +
                   '<td style="padding:5px 8px;border-bottom:1px solid #dee2e6;text-align:center;color:#555;font-size:.85rem">' + dateStr + '</td>' +
                   lagTd +
                   statusTd +
                   '</tr>';
        }).join('');
        const statusColor = pct >= 100 ? '#198754' : pct >= 50 ? '#fd7e14' : '#6c757d';
        const statusLabel = pct >= 100 ? 'Completed' : pct > 0 ? 'In Progress' : 'Not Started';

        // 90-day cycle computation for print
        var _pSvcD    = rx.serviceDate ? new Date(rx.serviceDate) : null;
        var _pExpD    = _pSvcD ? new Date(_pSvcD.getTime() + 90*864e5) : null;
        var _pExpStr  = _pExpD ? _pExpD.toLocaleDateString() : '\u2014';
        var _pDLeft   = _pExpD ? Math.round((_pExpD - new Date()) / 864e5) : null;
        var _pStatus, _pStatusColor;
        if (_pDLeft === null)    { _pStatus = '\u2014';                                                          _pStatusColor = '#888'; }
        else if (_pDLeft < 0)   { _pStatus = '\u2705 Eligible for renewal (' + Math.abs(_pDLeft) + 'd ago)';  _pStatusColor = '#198754'; }
        else if (_pDLeft <= 7)  { _pStatus = '\u26a0\ufe0f Expiring (' + _pDLeft + 'd left) \u2014 Date Locked'; _pStatusColor = '#dc3545'; }
        else                    { _pStatus = '\ud83d\udd12 Active Window (' + _pDLeft + 'd remaining)';       _pStatusColor = '#0d6efd'; }
        // -- CARD --
        var cardInfoRows = [
            ['Patient',      (patient.firstName || '') + ' ' + (patient.lastName || '')],
            ['Patient Code', patient.patientCode || '--'],
            ['Pharmacy',     pharmacy.name || '--'],
            ['Service Date',      rx.serviceDate || '--'],
            ['Next Svc Date',     _pExpStr],
            ['Cycle Status',      _pStatus],
            ['Workflow',          doneCount + '/' + totalSteps + ' steps (' + pct + '%)']
        ];
        var cardInfoHtml = '';
        for (var _cii = 0; _cii < cardInfoRows.length; _cii++) {
            cardInfoHtml += '<div><div style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#888;margin-bottom:3px">' + cardInfoRows[_cii][0] + '</div>' +
                '<div style="font-size:.9rem;color:#1a2234">' + cardInfoRows[_cii][1] + '</div></div>';
        }
        var cardNotesHtml = rx.notes ? '<div style="margin:0 28px 20px;padding:12px 16px;background:#fffbea;border-left:4px solid #f5a623;border-radius:4px;font-size:.85rem;color:#7a5800"><strong>Notes:</strong><br>' + rx.notes.replace(/\n/g,'<br>') + '</div>' : '';
        var cardHTML =
            '<div id="rxPrintContentCard" style="font-family:Inter,Arial,sans-serif;background:#fff;margin:20px;border-radius:12px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.12)">' +
            '<div style="background:linear-gradient(135deg,#1a2234,#2c3e6b);color:#fff;padding:20px 28px;display:flex;justify-content:space-between;align-items:center">' +
              '<div>' +
                '<div style="font-size:1.4rem;font-weight:700">RX Record <span style="font-family:monospace">#' + rx.id + '</span></div>' +
                '<div style="font-size:.85rem;opacity:.75;margin-top:3px">Patient RX System &nbsp;&middot;&nbsp; Generated: ' + printDate + '</div>' +
              '</div>' +
              '<div style="text-align:right">' +
                '<div style="font-size:1rem;font-weight:600;opacity:.85">' + (patient.firstName || '') + ' ' + (patient.lastName || '') + '</div>' +
                '<div style="margin-top:6px"><span style="background:' + statusColor + ';color:#fff;padding:3px 12px;border-radius:20px;font-size:.78rem;font-weight:600">' + statusLabel + '</span></div>' +
              '</div>' +
            '</div>' +
            '<div style="padding:20px 28px;display:grid;grid-template-columns:1fr 1fr;gap:12px 32px;border-bottom:1px solid #e9ecef">' + cardInfoHtml + '</div>' +
            '<div style="padding:16px 28px;border-bottom:1px solid #e9ecef">' +
              '<div style="display:flex;justify-content:space-between;margin-bottom:6px">' +
                '<span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#888">Overall Progress</span>' +
                '<span style="font-size:.72rem;font-weight:700;color:' + statusColor + '">' + pct + '%</span>' +
              '</div>' +
              '<div style="height:8px;border-radius:4px;background:#e9ecef;overflow:hidden">' +
                '<div style="height:100%;border-radius:4px;background:linear-gradient(90deg,#4a90e2,' + statusColor + ');width:' + pct + '%"></div>' +
              '</div>' +
            '</div>' +
            '<div style="padding:16px 28px">' +
              '<div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#888;margin-bottom:10px">Workflow Checklist</div>' +
              stepsCardHtml +
            '</div>' +
            cardNotesHtml +
            '</div>';

        // -- CLASSIC --
        var classicNotesHtml = rx.notes ? '<div style="background:#f8f9fa;border-left:3px solid #4a90e2;padding:10px 14px;border-radius:4px;margin-bottom:20px;font-size:.85rem"><strong>Notes:</strong><br>' + rx.notes.replace(/\n/g,'<br>') + '</div>' : '';
        var classicHTML =
            '<div id="rxPrintContentClassic" style="display:none;font-family:Inter,Arial,sans-serif;color:#1a2234;padding:28px">' +
            '<div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #1a2234;padding-bottom:12px;margin-bottom:20px">' +
              '<div><h4 style="margin:0;color:#1a2234">RX Record</h4><div style="font-size:.8rem;color:#888;margin-top:4px">Printed: ' + printDate + '</div></div>' +
              '<div style="text-align:right"><div style="font-size:1.1rem;font-weight:700">#' + rx.id + ' <span style="background:' + statusColor + ';color:#fff;padding:3px 10px;border-radius:12px;font-size:.75rem;margin-left:8px">' + statusLabel + '</span></div></div>' +
            '</div>' +
            '<table style="width:100%;border-collapse:collapse;margin-bottom:20px;font-size:.875rem">' +
              '<tr><td style="width:50%;padding:5px 0"><strong>Patient:</strong> ' + (patient.firstName || '') + ' ' + (patient.lastName || '') + '</td>' +
              '<td style="width:50%;padding:5px 0"><strong>Patient Code:</strong> ' + (patient.patientCode || '--') + '</td></tr>' +
              '<tr><td style="padding:5px 0"><strong>Pharmacy:</strong> ' + (pharmacy.name || '--') + '</td>' +
              '<td style="padding:5px 0"><strong>Service Date:</strong> ' + (rx.serviceDate || '--') + '</td></tr>' +
              '<tr><td style="padding:5px 0"><strong>Next Service Date:</strong> ' + _pExpStr + '</td>' +
              '<td style="padding:5px 0"><strong>Cycle Status:</strong> <span style="color:' + _pStatusColor + ';font-weight:600">' + _pStatus + '</span></td></tr>' +
              '<tr><td style="padding:5px 0"><strong>Progress:</strong> ' + doneCount + '/' + totalSteps + ' steps (' + pct + '%)</td><td></td></tr>' +
            '</table>' +
            classicNotesHtml +
            '<h6 style="border-bottom:1px solid #dee2e6;padding-bottom:6px;margin-bottom:10px">Workflow Steps</h6>' +
            '<table style="width:100%;border-collapse:collapse;font-size:.85rem">' +
              '<thead><tr style="background:#1a2234;color:#fff">' +
                '<th style="padding:7px 10px">Step</th>' +
                '<th style="padding:7px 10px;text-align:center">Date Completed</th>' +
                '<th style="padding:7px 10px;text-align:center">Days Lag</th>' +
                '<th style="padding:7px 10px;text-align:center">Status</th>' +
              '</tr></thead>' +
              '<tbody>' + stepsClassicHtml + '</tbody>' +
            '</table></div>';

        bodyEl2.innerHTML = cardHTML + classicHTML;
        bodyEl2.style.background = '#f0f2f5';
    }

    function doPrintRx() {
        if (!_rxPrintData) return;
        var contentId = _rxPrintLayout === 'card' ? 'rxPrintContentCard' : 'rxPrintContentClassic';
        var content   = document.getElementById(contentId);
        if (!content) return;
        var rx2 = _rxPrintData.rx;
        var win = window.open('', '_blank', 'width=900,height=750');
        var cssCard = '@import url("/assets/inter.css");' +
            '*{box-sizing:border-box;margin:0;padding:0}' +
            'body{font-family:"Inter",Arial,sans-serif;background:#f0f2f5;padding:32px}' +
            '#rxPrintContentCard{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,.1)}' +
            '@media print{@page{margin:15mm;size:A4}body{background:#fff;padding:0}#rxPrintContentCard{box-shadow:none;border-radius:0}' +
            'div[style*="background:linear-gradient"]{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}}';
        var cssClassic = '@import url("/assets/inter.css");' +
            'body{font-family:Inter,Arial,sans-serif;color:#1a2234;padding:32px;max-width:860px;margin:0 auto}' +
            'table{width:100%;border-collapse:collapse}' +
            'thead tr{background:#1a2234!important;color:#fff!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}' +
            'th,td{padding:7px 10px;text-align:left;border-bottom:1px solid #dee2e6}' +
            '@media print{@page{margin:20mm}body{padding:0}}';
        var css = _rxPrintLayout === 'card' ? cssCard : cssClassic;
        win.document.write('<!DOCTYPE html><html><head>' +
            '<meta charset="UTF-8"><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">' +
            '<title>RX Record #' + rx2.id + '</title>' +
            '<style>' + css + '</style></head>' +
            '<body>' + content.outerHTML +
            '<script>window.onload=function(){window.print();}<\/script>' +
            '</body></html>');
        win.document.close();
        win.focus();
    }

    // Remove row button delegation
    document.addEventListener('click', function(e) {
        var el = e.target.closest('[data-remove-row]');
        if (el) { var row = document.getElementById(el.dataset.removeRow); if (row) row.remove(); }
    });

</script>
</body>
</html>
