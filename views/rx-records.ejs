<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RX Records - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .patient-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0; right: 0;
            z-index: 1055;
            max-height: 220px;
            overflow-y: auto;
            background: var(--card-bg, #fff);
            border: 1px solid var(--border-color, #dee2e6);
            border-radius: 0.375rem;
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        }
        .patient-dropdown.open { display: block; }
        .patient-dropdown-item {
            padding: 8px 14px;
            cursor: pointer;
            border-bottom: 1px solid var(--border-color, #f0f0f0);
            transition: background 0.15s;
        }
        .patient-dropdown-item:last-child { border-bottom: none; }
        .patient-dropdown-item:hover,
        .patient-dropdown-item.highlighted { background: rgba(99,102,241,0.12); }
        .patient-dropdown-item .pat-name  { font-weight: 600; font-size: 0.9rem; }
        .patient-dropdown-item .pat-id    { font-size: 0.78rem; color: var(--text-muted, #6c757d); }
        .patient-dropdown-empty { padding: 10px 14px; color: var(--text-muted, #6c757d); font-size: 0.85rem; }
        #patientSearchInput.is-selected { border-color: #6366f1; }
    </style>
</head>
<body>
<div class="wrapper">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>

<div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold fs-5">RX Records</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">
            <div class="glass-card p-3 mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold small text-muted text-uppercase" style="letter-spacing:.05em"><i class="fas fa-filter me-1"></i>Search &amp; Filter</span>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-link btn-sm text-muted p-0" onclick="toggleRxPanel()" style="font-size:.78rem;text-decoration:none">
                            <i class="fas fa-sliders-h me-1"></i>Advanced <i class="fas fa-chevron-down ms-1" id="rxAdvChevron"></i>
                        </button>
                    </div>
                </div>
                <!-- Basic row -->
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold"><i class="fas fa-user me-1"></i>Patient Name</label>
                        <input type="text" class="form-control form-control-sm" id="rxFilterPatient" placeholder="First or last name...">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">RX #</label>
                        <input type="text" class="form-control form-control-sm" id="rxFilterId" placeholder="RX number">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold"><i class="fas fa-clinic-medical me-1"></i>Pharmacy</label>
                        <input type="text" class="form-control form-control-sm" id="rxFilterPharmacy" placeholder="Pharmacy name">
                    </div>
                    <div class="col-md-2 d-flex gap-1 align-items-end">
                        <button class="btn btn-primary btn-sm flex-fill" id="rxFilterBtn"><i class="fas fa-search"></i></button>
                        <button class="btn btn-outline-secondary btn-sm" id="rxClearBtn"><i class="fas fa-times"></i></button>
                    </div>
                </div>
                <!-- Advanced row -->
                <div id="rxAdvPanel" style="display:none;border-top:1px solid var(--border-color,#dee2e6);margin-top:10px;padding-top:10px">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-id-badge me-1"></i>Patient ID</label>
                            <input type="text" class="form-control form-control-sm" id="rxFilterPatientCode" placeholder="e.g. PAT-00001">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service Date From</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterDateFrom">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service Date To</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterDateTo">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service From</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterSvcFrom">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold"><i class="fas fa-calendar-check me-1"></i>Service To</label>
                            <input type="date" class="form-control form-control-sm" id="rxFilterSvcTo">
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="rxShowDeleted">
                                <label class="form-check-label small" for="rxShowDeleted">Show Hidden Records</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0">RX Records</h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-success btn-sm" id="exportRxListCsvBtn"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
                        <button class="btn btn-success btn-sm" id="addRxBtn"><i class="fas fa-plus me-1"></i>New RX</button>
                    </div>
                </div>

                <!-- ── Pagination bar TOP ── -->
                <div class="d-flex align-items-center justify-content-between mb-2" id="rxPagBar">
                    <div class="d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Show</label>
                        <select class="form-select form-select-sm" style="width:auto" id="rxPageSizeSelect">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50" selected>50</option>
                            <option value="100">100</option>
                        </select>
                        <small class="text-muted" id="rxPageInfo"></small>
                    </div>
                    <nav><ul class="pagination pagination-sm mb-0" id="rxPagination"></ul></nav>
                </div>

                <!-- ── Bulk Action Toolbar (F10-03) — hidden until rows are selected ── -->
                <div id="rxBulkBar" style="display:none;background:linear-gradient(90deg,#7c3aed,#5b21b6);border-radius:8px;padding:10px 16px;margin-bottom:10px">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span class="badge bg-white text-purple fw-bold fs-6" id="rxBulkCount" style="color:#5b21b6;min-width:32px;text-align:center">0</span>
                        <span class="text-white small fw-semibold"><i class="fas fa-check-square me-1"></i>records selected</span>
                        <div class="flex-grow-1"></div>
                        <label class="text-white small fw-semibold mb-0" for="rxBulkStepSel"><i class="fas fa-tasks me-1"></i>Apply Workflow Step:</label>
                        <select id="rxBulkStepSel" class="form-select form-select-sm" style="width:auto;max-width:240px">
                            <option value="">— Choose step —</option>
                        </select>
                        <button id="rxBulkApplyBtn" class="btn btn-warning btn-sm fw-bold">
                            <i class="fas fa-play me-1"></i>Apply to Selected
                        </button>
                        <button id="rxBulkClearBtn" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-times me-1"></i>Clear
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="rxTable">
                        <thead>
                            <tr>
                                <!-- F10-02: Select-all checkbox -->
                                <th style="width:36px">
                                    <input type="checkbox" id="rxSelectAll" title="Select all on this page" style="cursor:pointer">
                                </th>
                                <th style="cursor:pointer" onclick="sortRx('id')">RX # <i class="fas fa-sort text-muted" style="opacity:0.3" id="srIcon_id"></i></th>
                                <th style="cursor:pointer" onclick="sortRx('Patient.firstName')">Patient <i class="fas fa-sort text-muted" style="opacity:0.3" id="srIcon_Patient.firstName"></i></th>
                                <th style="cursor:pointer" onclick="sortRx('serviceDate')">Service Date <i class="fas fa-sort text-muted" style="opacity:0.3" id="srIcon_serviceDate"></i></th>
                                <th style="cursor:pointer" onclick="sortRx('Pharmacy.name')">Pharmacy <i class="fas fa-sort text-muted" style="opacity:0.3" id="srIcon_Pharmacy.name"></i></th>
                                <th>Workflow Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="rxBody">
                            <tr><td colspan="7" class="text-center text-muted py-4">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RX Create Modal -->
<div class="modal fade" id="rxModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rxModalTitle">New RX Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <!-- Patient selector -->
                <div class="row g-3 mb-2">
                    <div class="col-12">
                        <label class="form-label fw-bold">Patient <span class="text-danger">*</span></label>
                        <div class="patient-search-wrapper position-relative" id="patientSearchWrapper">
                            <input type="text" class="form-control" id="patientSearchInput"
                                   placeholder="Search by name, last name or ID..."
                                   autocomplete="off">
                            <input type="hidden" id="rxPatientId">
                            <div class="patient-dropdown" id="patientDropdown"></div>
                        </div>
                        <small class="text-muted" id="patientSelectedInfo"></small>
                    </div>
                </div>

                <!-- Auto-filled info panel &mdash; shows once a patient is selected -->
                <div id="rxPatientInfoPanel" class="rounded border bg-light p-3 mb-3" style="display:none">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fas fa-user-check text-success"></i>
                        <span class="fw-semibold small text-success">Fields below are auto-filled from the patient record</span>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small mb-1 text-muted">Default Pharmacy</label>
                            <input type="text" class="form-control form-control-sm bg-white" id="rxPharmacyDisplay" readonly tabindex="-1">
                            <input type="hidden" id="rxPharmacyId">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1 text-muted">Service Date</label>
                            <input type="text" class="form-control form-control-sm bg-white" id="rxServiceDisplay" readonly tabindex="-1">
                            <input type="hidden" id="rxServiceDate">
                            <!-- arrivalDate hidden mirrors serviceDate so DB validation passes -->
                            <input type="hidden" id="rxArrivalDate">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1 text-muted">Patient Transport</label>
                            <input type="text" class="form-control form-control-sm bg-white" id="rxPatientTransportDisplay" readonly tabindex="-1">
                            <input type="hidden" id="rxPatientTransport">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1 text-muted">Pharmacy Transport</label>
                            <input type="text" class="form-control form-control-sm bg-white" id="rxPharmacyTransportDisplay" readonly tabindex="-1">
                            <input type="hidden" id="rxPharmacyTransport">
                        </div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted"><i class="fas fa-info-circle me-1"></i>To change these values, edit the patient record first.</small>
                    </div>
                </div>

                <hr>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>RX Actions</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="addMedBtn"><i class="fas fa-plus me-1"></i>Add Action</button>
                </div>
                <div id="medicationsContainer"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveRxBtn">
                    <span id="saveRxSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>Save RX
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Workflow Modal -->
<div class="modal fade" id="workflowModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">RX Workflow Tracking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="workflowBody">
                <p class="text-muted text-center">Loading...</p>
            </div>
            <!-- Return to Warehouse footer (shown only when editable and steps exist) -->
            <div class="modal-footer" id="workflowFooter" style="display:none;">
                <div class="w-100">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <i class="fas fa-warehouse text-warning"></i>
                        <input type="text" id="warehouseNoteInput" class="form-control form-control-sm flex-grow-1" placeholder="Reason / note (optional)" style="max-width:280px;">
                        <button class="btn btn-warning btn-sm fw-semibold" id="returnToWarehouseBtn" onclick="returnToWarehouse()">
                            <i class="fas fa-warehouse me-1"></i>Return to Warehouse
                        </button>
                        <span class="text-muted small">Clears all workflow steps &amp; marks as returned</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RX History Modal -->
<div class="modal fade" id="rxHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#1a2234,#243050);color:#fff">
                <h5 class="modal-title"><i class="fas fa-history me-2"></i>RX Record History</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="rxHistoryBody">
                <p class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading history...</p>
            </div>
        </div>
    </div>
</div>

<!-- RX Print Preview Modal -->
<div class="modal fade" id="rxPrintModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-print me-2"></i>RX Record &mdash; Print Preview</h5>
                <div class="btn-group btn-group-sm ms-auto me-3" role="group" id="rxPrintLayoutToggle">
                    <input type="radio" class="btn-check" name="rxPrintLayout" id="rxLayoutCard" value="card" checked autocomplete="off">
                    <label class="btn btn-outline-primary" for="rxLayoutCard"><i class="fas fa-id-card me-1"></i>Card</label>
                    <input type="radio" class="btn-check" name="rxPrintLayout" id="rxLayoutClassic" value="classic" autocomplete="off">
                    <label class="btn btn-outline-primary" for="rxLayoutClassic"><i class="fas fa-file-alt me-1"></i>Classic</label>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="rxPrintBody" style="background:#f0f2f5">
                <p class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-primary" onclick="doPrintRx()"><i class="fas fa-print me-2"></i>Print / Save PDF</button>
            </div>
        </div>
    </div>
</div>

<!-- RX Detail View Modal -->
<div class="modal fade" id="rxDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#1a2234,#2c3e6b);color:#fff">
                <h5 class="modal-title"><i class="fas fa-file-medical me-2"></i>RX Record Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="rxDetailBody">
                <p class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading...</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-primary" id="rxDetailPrintBtn"><i class="fas fa-print me-2"></i>Print</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Bulk Workflow Results Modal (F10-04) ── -->
<div id="rxBulkResultOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:2000;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:12px;padding:0;max-width:560px;width:94%;max-height:82vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,0.3)">
    <div style="background:linear-gradient(135deg,#1a2234,#2c3e6b);color:#fff;padding:16px 22px;border-radius:12px 12px 0 0;display:flex;align-items:center;gap:12px">
      <i class="fas fa-tasks" style="font-size:1.2rem"></i>
      <span class="fw-bold" id="rxBulkResTitle" style="font-size:1rem">Bulk Workflow Results</span>
      <div style="flex:1"></div>
      <button id="rxBulkResClose" style="background:none;border:none;color:#fff;font-size:1.3rem;cursor:pointer;line-height:1">&times;</button>
    </div>
    <div id="rxBulkResSummary" style="padding:12px 22px 0"></div>
    <div id="rxBulkResList" style="overflow-y:auto;flex:1;padding:10px 22px 16px"></div>
  </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>
<script>
    var allRx = [], filteredRx = [], allWorkflowActions = [];
    /* F10-02: Bulk selection Set */
    var _rxBulkSel = (typeof Set === 'function') ? new Set() : (function(){
        var d = {};
        return {
            add:    function(v){ d[v]=1; },
            delete: function(v){ delete d[v]; },
            has:    function(v){ return !!d[v]; },
            clear:  function(){ d={}; },
            forEach:function(fn){ Object.keys(d).forEach(fn); },
            get size(){ return Object.keys(d).length; }
        };
    }());

    /* ════════════════════════════════════════════════════
       F10-03 — Bulk Action Toolbar logic
       ════════════════════════════════════════════════════ */

    /* Populate the step dropdown once workflow actions are loaded */
    function _rxPopulateBulkStepSel() {
        var sel = document.getElementById('rxBulkStepSel');
        if (!sel) return;
        sel.innerHTML = '<option value="">— Choose step —</option>';
        for (var i = 0; i < allWorkflowActions.length; i++) {
            var a = allWorkflowActions[i];
            var opt = document.createElement('option');
            opt.value = a.id;
            opt.textContent = a.sequenceNumber + '. ' + a.name;
            sel.appendChild(opt);
        }
    }

    /* Show / hide the bulk bar and update count badge */
    function _rxUpdateBulkBar() {
        var bar   = document.getElementById('rxBulkBar');
        var badge = document.getElementById('rxBulkCount');
        var n = _rxBulkSel.size;
        if (!bar) return;
        if (n > 0) {
            bar.style.display = '';
            if (badge) badge.textContent = n;
        } else {
            bar.style.display = 'none';
            if (badge) badge.textContent = '0';
        }
        /* Sync select-all header checkbox */
        var saEl  = document.getElementById('rxSelectAll');
        var tbody = document.getElementById('rxBody');
        if (saEl && tbody) {
            var allCbs = tbody.querySelectorAll('.rx-row-cb');
            var checkedCount = 0;
            for (var ci = 0; ci < allCbs.length; ci++) { if (allCbs[ci].checked) checkedCount++; }
            if (allCbs.length === 0) { saEl.checked = false; saEl.indeterminate = false; }
            else if (checkedCount === 0) { saEl.checked = false; saEl.indeterminate = false; }
            else if (checkedCount === allCbs.length) { saEl.checked = true; saEl.indeterminate = false; }
            else { saEl.checked = false; saEl.indeterminate = true; }
        }
    }

    /* ════════════════════════════════════════════════════
       F10-04 — Execute bulk workflow + results modal
       ════════════════════════════════════════════════════ */

    function _rxBulkApply() {
        var sel = document.getElementById('rxBulkStepSel');
        var actionId = sel ? sel.value : '';
        if (!actionId) { showToast('Please choose a workflow step first.', 'warning'); return; }
        var n = _rxBulkSel.size;
        if (n === 0)   { showToast('No records selected.', 'warning'); return; }

        /* Collect IDs */
        var ids = [];
        _rxBulkSel.forEach(function(v) { ids.push(v); });

        /* Find action name for confirmation */
        var stepName = sel.options[sel.selectedIndex].textContent;
        if (!confirm('Apply step "' + stepName + '" to ' + n + ' selected record(s)?\n\nRecords that have not completed the previous step will be skipped.')) return;

        /* Disable button while running */
        var applyBtn = document.getElementById('rxBulkApplyBtn');
        if (applyBtn) { applyBtn.disabled = true; applyBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Working...'; }

        fetchWithAuth('/api/rx-records/bulk-workflow', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rxIds: ids, actionId: parseInt(actionId, 10) })
        }).then(function(res) {
            if (!res) throw new Error('No response');
            return res.json();
        }).then(function(data) {
            _rxShowBulkResults(data, stepName);
            _rxBulkSel.clear();
            loadRxRecords();
        }).catch(function(err) {
            showToast('Bulk update failed: ' + (err.message || 'Unknown error'), 'danger');
        }).finally ? (function(){
            if (applyBtn) { applyBtn.disabled = false; applyBtn.innerHTML = '<i class="fas fa-play me-1"></i>Apply to Selected'; }
        })() : (function(){ /* no finally fallback needed — always called */ }());

        /* Restore button regardless (finally not always available in ES5) */
        setTimeout(function() {
            if (applyBtn) { applyBtn.disabled = false; applyBtn.innerHTML = '<i class="fas fa-play me-1"></i>Apply to Selected'; }
        }, 5000);
    }

    function _rxShowBulkResults(data, stepName) {
        var overlay = document.getElementById('rxBulkResultOverlay');
        var title   = document.getElementById('rxBulkResTitle');
        var summary = document.getElementById('rxBulkResSummary');
        var list    = document.getElementById('rxBulkResList');
        if (!overlay) return;

        var succeeded = data.succeeded || 0;
        var failed    = data.failed    || 0;
        var results   = data.results   || [];

        if (title)   title.textContent = 'Results — ' + (data.action ? data.action.name : stepName);

        /* Summary bar */
        var summaryHtml = '<div style="display:flex;gap:12px;margin-bottom:10px">';
        summaryHtml += '<span style="background:#dcfce7;color:#16a34a;border-radius:6px;padding:6px 14px;font-weight:700"><i class="fas fa-check me-1"></i>' + succeeded + ' succeeded</span>';
        summaryHtml += '<span style="background:#fee2e2;color:#dc2626;border-radius:6px;padding:6px 14px;font-weight:700"><i class="fas fa-times me-1"></i>' + failed + ' failed</span>';
        summaryHtml += '</div>';
        if (summary) summary.innerHTML = summaryHtml;

        /* Per-record list */
        if (list) {
            list.innerHTML = '';
            for (var i = 0; i < results.length; i++) {
                var r   = results[i];
                var row = document.createElement('div');
                row.style.cssText = 'display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid #f0f0f0';
                var icon = document.createElement('span');
                icon.style.cssText = 'font-size:1rem;min-width:18px;text-align:center';
                if (r.ok) {
                    icon.innerHTML = '<i class="fas fa-check-circle" style="color:#16a34a"></i>';
                } else {
                    icon.innerHTML = '<i class="fas fa-times-circle" style="color:#dc2626"></i>';
                }
                var label = document.createElement('span');
                label.style.cssText = 'flex:1;font-size:.88rem';
                var patName = r.patientName ? (' — ' + r.patientName) : '';
                var noteStr = r.skipped ? ' <em style="color:#888">(already done)</em>' : (r.error ? ' <span style="color:#dc2626">' + r.error + '</span>' : '');
                label.innerHTML = '<strong>RX #' + r.rxId + '</strong>' + patName + noteStr;
                row.appendChild(icon);
                row.appendChild(label);
                list.appendChild(row);
            }
        }

        overlay.style.display = 'flex';
    }

