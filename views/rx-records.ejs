    var _rxAdvOpen = false;
    function toggleRxPanel() {
        _rxAdvOpen = !_rxAdvOpen;
        var el = document.getElementById('rxAdvPanel');
        var ch = document.getElementById('rxAdvChevron');
        if (el) el.style.display = _rxAdvOpen ? '' : 'none';
        if (ch) ch.className   = _rxAdvOpen ? 'fas fa-chevron-up ms-1' : 'fas fa-chevron-down ms-1';
    }
    var rxPage = 1, rxPageSize = 10;
    var rxTotalCount = 0, rxTotalPages = 1, rxServerPaging = true;
    var rxFilterTimer = null;
    var currentRxId = null;
    var rSortCol = 'id';
    var rSortDir = 'desc';
    var medCount = 0;
    var workflowModalInstance = null;
    var expiredAccessModalInstance = null;
    var expiredAccessRxId = null;
    var allPatientsList    = []; // for searchable patient picker
    var allPharmaciesList  = []; // pharmacies cache
    var allClinicsList     = []; // clinics cache
    var allPtList          = []; // patient transport companies cache
    var allPhtList         = []; // pharmacy transport companies cache
    var allMedCatalog      = []; // RX action catalog
    var _rxPrefillPatientId = null;
    var _rxPrefillPatientName = '';
    var rxPatientPickerPromise = null;
    var rxPatientPickerLoaded = false;
    var rxPatientSearchInitialized = false;

    // Loads all dropdown data needed for the New RX modal and workflow selectors.
    // Returns a Promise so DOMContentLoaded can chain .then(loadRxRecords).
    function loadRxDropdowns() {
        var phRes, ptRes, rxRes, waRes, catRes;
        loadRxPatientPickerData();
        fetchWithAuth(window.rxUrl('/api/lookup/clinics'), { silent: true }).then(function(res) {
            return res && res.ok ? res.json() : [];
        }).then(function(data) {
            allClinicsList = Array.isArray(data) ? data : [];
            populateRxFilterSelects();
        }).catch(function() { allClinicsList = []; });
        return Promise.all([
            fetchWithAuth(window.rxUrl('/api/lookup/pharmacies'), { silent: true }),
            fetchWithAuth(window.rxUrl('/api/lookup/patient-transport'), { silent: true }),
            fetchWithAuth(window.rxUrl('/api/lookup/pharmacy-transport'), { silent: true }),
            fetchWithAuth(window.rxUrl('/api/lookup/workflow-actions'), { silent: true }),
            fetchWithAuth(window.rxUrl('/api/lookup/medication-catalog'), { silent: true })
        ]).then(function(results) {
            phRes = results[0];
            ptRes = results[1];
            rxRes = results[2];
            waRes = results[3];
            catRes = results[4];
            if (phRes  && phRes.ok) { return phRes.json();  } return [];
        }).then(function(data) {
            allPharmaciesList = Array.isArray(data) ? data : [];
            if (ptRes  && ptRes.ok) { return ptRes.json();  } return [];
        }).then(function(data) {
            allPtList = Array.isArray(data) ? data : [];
            if (rxRes  && rxRes.ok) { return rxRes.json();  } return [];
        }).then(function(data) {
            allPhtList = Array.isArray(data) ? data : [];
            if (waRes  && waRes.ok) { return waRes.json();  } return [];
        }).then(function(data) {
            allWorkflowActions = Array.isArray(data) ? data : [];
            _rxPopulateBulkStepSel();
            if (catRes && catRes.ok) { return catRes.json(); } return [];
        }).then(function(data) {
            allMedCatalog = Array.isArray(data) ? data : [];
            var dl = document.getElementById('medCatalogList');
            if (!dl) { dl = document.createElement('datalist'); dl.id = 'medCatalogList'; document.body.appendChild(dl); }
            dl.innerHTML = '';
            for (var _mi = 0; _mi < allMedCatalog.length; _mi++) {
                var opt = document.createElement('option');
                opt.value = allMedCatalog[_mi].name;
                dl.appendChild(opt);
            }
            populateRxFilterSelects();
            initPatientSearch();
        }).catch(function(e) {
            console.error('[RX] loadRxDropdowns error:', e);
            populateRxFilterSelects();
            initPatientSearch(); // always init patient search even on partial failure
        });
    }

    function loadRxPatientPickerData() {
        if (rxPatientPickerLoaded) return Promise.resolve(allPatientsList);
        if (rxPatientPickerPromise) return rxPatientPickerPromise;
        var searchInput = document.getElementById('patientSearchInput');
        if (searchInput) searchInput.placeholder = 'Loading patients...';
        rxPatientPickerPromise = fetchWithAuth(window.rxUrl('/api/patients'), { silent: true }).then(function(res) {
            if (!res || !res.ok) return [];
            return res.json();
        }).then(function(data) {
            allPatientsList = Array.isArray(data) ? data : [];
            rxPatientPickerLoaded = true;
            if (searchInput) searchInput.placeholder = 'Search patient by name, ID...';
            return allPatientsList;
        }).catch(function(e) {
            console.error('[RX] loadRxPatientPickerData error:', e);
            if (searchInput) searchInput.placeholder = 'Search patient by name, ID...';
            return allPatientsList;
        });
        return rxPatientPickerPromise;
    }

    function selectedRxFilterIds(value) {
        return String(value || '').split(',').map(function(value) { return value.trim(); }).filter(Boolean);
    }

    function populateRxMultiFilter(hiddenId, pickerId, items, itemLabel, emptyLabel) {
        var hidden = document.getElementById(hiddenId);
        var picker = document.getElementById(pickerId);
        if (!hidden || !picker) return;
        var selected = selectedRxFilterIds(hidden.value);
        var selectedSet = new Set(selected);
        var buttonLabel = picker.querySelector('button span');
        var options = picker.querySelector('.rx-filter-multiselect-options');
        var search = picker.querySelector('.rx-filter-multiselect-search');
        var refreshLabel = function() {
            var names = items.filter(function(item) { return selectedSet.has(String(item.id)); }).map(itemLabel);
            var label = !names.length ? emptyLabel : (names.length === 1 ? names[0] : names.length + ' selected');
            buttonLabel.textContent = label;
            hidden.dataset.filterSummary = label;
        };
        options.innerHTML = '';
        items.forEach(function(item) {
            var label = document.createElement('label');
            label.className = 'rx-filter-multiselect-option';
            label.dataset.search = itemLabel(item).toLowerCase();
            var checkbox = document.createElement('input');
            checkbox.type = 'checkbox'; checkbox.value = String(item.id); checkbox.checked = selectedSet.has(checkbox.value);
            checkbox.addEventListener('change', function() {
                if (checkbox.checked) selectedSet.add(checkbox.value); else selectedSet.delete(checkbox.value);
                hidden.value = Array.from(selectedSet).join(',');
                refreshLabel();
                hidden.dispatchEvent(new Event('change', { bubbles: true }));
            });
            label.appendChild(checkbox); label.appendChild(document.createTextNode(itemLabel(item))); options.appendChild(label);
        });
        if (search) search.oninput = function() {
            var term = search.value.toLowerCase().trim();
            options.querySelectorAll('.rx-filter-multiselect-option').forEach(function(option) {
                option.style.display = !term || option.dataset.search.indexOf(term) >= 0 ? '' : 'none';
            });
        };
        refreshLabel();
    }

