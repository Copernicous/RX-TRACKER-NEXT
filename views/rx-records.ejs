    /* Returns YYYY-MM-DD from an ISO date string */
    function _isoToLocalInput(isoStr) {
        if (!isoStr) return '';
        var d = new Date(isoStr);
        if (isNaN(d.getTime())) return '';
        var pad = function(n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate());
    }

    /* Replaces the date label inline with a date-only picker */
    function editStepDate(trackingId, rxId, currentDate, prevDate, nextDate, svcDateStr, triggerBtn) {
        var listItem = triggerBtn.closest
            ? triggerBtn.closest('.list-group-item')
            : (function(el) { while (el && !el.classList.contains('list-group-item')) el = el.parentNode; return el; })(triggerBtn);
        if (!listItem) return;
        var wrap = listItem.querySelector('.wf-date-wrap');
        if (!wrap || wrap.dataset.editing === '1') return;
        wrap.dataset.editing = '1';

        var origLabel = wrap.querySelector('.wf-date-label');
        var origText  = origLabel ? origLabel.textContent : '';
        var today     = _isoToLocalInput(new Date().toISOString());
        var preVal    = currentDate ? currentDate.slice(0, 10) : today;
        /* Constrain picker: min = prev step date, max = min(today, next step date) */
        var minVal    = prevDate || '';
        /* Cap max at serviceDate + 90 days */
        var svcMax90  = svcDateStr ? new Date(new Date(svcDateStr).getTime() + 90 * 864e5).toISOString().slice(0,10) : today;
        var hardMax   = svcMax90 < today ? svcMax90 : today;
        var maxVal    = nextDate ? (nextDate < hardMax ? nextDate : hardMax) : hardMax;

        wrap.innerHTML =
            '<input type="date" class="form-control form-control-sm d-inline-block" ' +
            'style="width:auto;max-width:160px" id="wfDateInput_' + trackingId + '" ' +
            'value="' + preVal + '" min="' + minVal + '" max="' + maxVal + '">' +
            ' <button class="btn btn-sm btn-success" id="wfDateSave_' + trackingId + '" title="Save date">' +
            '<i class="fas fa-check"></i></button>' +
            ' <button class="btn btn-sm btn-outline-secondary" id="wfDateCancel_' + trackingId + '" title="Cancel">' +
            '<i class="fas fa-times"></i></button>';

        document.getElementById('wfDateCancel_' + trackingId).addEventListener('click', function() {
            wrap.innerHTML = '<small class="text-success wf-date-label">' + origText + '</small>';
            wrap.dataset.editing = '';
        });
        document.getElementById('wfDateSave_' + trackingId).addEventListener('click', function() {
            var inp = document.getElementById('wfDateInput_' + trackingId);
            if (!inp || !inp.value) { showToast('Please select a date.', 'warning'); return; }
            updateStepDate(trackingId, rxId, inp.value, wrap, origText);
        });
    }

    function updateStepDate(trackingId, rxId, newDateStr, wrap, origText) {
        var saveBtn = document.getElementById('wfDateSave_' + trackingId);
        if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }
        fetchWithAuth(window.rxUrl('/api/rx-records/workflow-date'), {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ trackingId: parseInt(trackingId, 10), newDate: newDateStr })
        }).then(function(res) {
            if (!res) {
                wrap.innerHTML = '<small class="text-success wf-date-label">' + origText + '</small>';
                wrap.dataset.editing = ''; return;
            }
            if (res.ok) {
                showToast('Completion date updated and logged in history.', 'success');
                return openWorkflow(rxId).then(function() { return loadRxRecords(); });
            } else {
                return res.json().then(function(err) {
                    showToast(err.error || 'Failed to update date.', 'danger');
                    wrap.innerHTML = '<small class="text-success wf-date-label">' + origText + '</small>';
                    wrap.dataset.editing = '';
                });
            }
        }).catch(function() {
            wrap.innerHTML = '<small class="text-success wf-date-label">' + origText + '</small>';
            wrap.dataset.editing = '';
        }).then(function() {
            var sb = document.getElementById('wfDateSave_' + trackingId);
            if (sb) { sb.disabled = false; sb.innerHTML = '<i class="fas fa-check"></i>'; }
        });
    }

