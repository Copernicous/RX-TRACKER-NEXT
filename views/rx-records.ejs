        }).then(function(r) {
            ptRes = r;
            return fetchWithAuth(window.rxUrl('/api/lookup/pharmacy-transport'), { silent: true });
        }).then(function(r) {
            rxRes = r;
            return fetchWithAuth(window.rxUrl('/api/lookup/workflow-actions'), { silent: true });
        }).then(function(r) {
            waRes = r;
