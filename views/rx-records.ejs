        window.__rxSetPatientSelection = selectPatient;
        searchInput.addEventListener('focus', function() { renderDropdown(searchInput.value); });
        searchInput.addEventListener('input', function() {
            hiddenInput.value = '';
            searchInput.classList.remove('is-selected');
            info.textContent = '';
            renderDropdown(searchInput.value);
        });

        // Keyboard navigation
        searchInput.addEventListener('keydown', function(e) {
            var items = dropdown.querySelectorAll('.patient-dropdown-item');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                hiIdx = Math.min(hiIdx + 1, items.length - 1);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                hiIdx = Math.max(hiIdx - 1, 0);
            } else if (e.key === 'Enter' && hiIdx >= 0) {
                e.preventDefault();
                var item = items[hiIdx];
                if (item) selectPatient(item.dataset.id, item.dataset.name,
                    item.dataset.serviceDate, item.dataset.ptId, item.dataset.phtId, item.dataset.pharmacyId);
                return;
            } else if (e.key === 'Escape') {
                dropdown.classList.remove('open');
                return;
            }
            for (var _ki = 0; _ki < items.length; _ki++) {
                items[_ki].classList.toggle('highlighted', _ki === hiIdx);
            }
            if (items[hiIdx]) items[hiIdx].scrollIntoView({ block: 'nearest' });
        });

        // Close on outside click
        document.addEventListener('click', function(e) {
            var wrapper = document.getElementById('patientSearchWrapper');
            if (wrapper && !wrapper.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    }

    function addMedicationRow() {
        medCount++;
        var rowId = 'med_' + medCount;
        var n = medCount;
        var div = document.createElement('div');
        div.className = 'row g-2 align-items-end mb-2 med-row';
        div.id = rowId;

        // Col 1: action name input
        var col1 = document.createElement('div'); col1.className = 'col-md-5';
        var ig = document.createElement('div'); ig.className = 'input-group input-group-sm';
        var igSpan = document.createElement('span'); igSpan.className = 'input-group-text';
        igSpan.innerHTML = '<i class="fas fa-clipboard-list"></i>';
        var nameInput = document.createElement('input');
        nameInput.type = 'text'; nameInput.className = 'form-control';
        nameInput.placeholder = 'Select or type action...';
        nameInput.name = 'medName_' + n;
        nameInput.setAttribute('list', 'medCatalogList');
        nameInput.setAttribute('autocomplete', 'off');
        nameInput.setAttribute('oninput', 'checkMedCatalog(this)');
        ig.appendChild(igSpan); ig.appendChild(nameInput); col1.appendChild(ig);
        var warn = document.createElement('small');
        warn.className = 'text-warning med-warn';
        warn.style.display = 'none'; warn.style.fontSize = '.7rem';
        warn.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Not in actions list';
        col1.appendChild(warn);

        // Col 2: quantity
        var col2 = document.createElement('div'); col2.className = 'col-md-2';
        var qtyInput = document.createElement('input');
        qtyInput.type = 'number'; qtyInput.className = 'form-control form-control-sm';
        qtyInput.placeholder = '#'; qtyInput.name = 'medQty_' + n;
        qtyInput.min = '1'; qtyInput.value = '1';
        col2.appendChild(qtyInput);

        // Col 3: notes
        var col3 = document.createElement('div'); col3.className = 'col-md-4';
        var notesInput = document.createElement('input');
        notesInput.type = 'text'; notesInput.className = 'form-control form-control-sm';
        notesInput.placeholder = 'Notes (optional)'; notesInput.name = 'medNotes_' + n;
        col3.appendChild(notesInput);

        // Col 4: remove button
        var col4 = document.createElement('div'); col4.className = 'col-md-1';
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button'; removeBtn.className = 'btn btn-outline-danger btn-sm w-100';
        removeBtn.title = 'Remove'; removeBtn.setAttribute('data-remove-row', rowId);
        removeBtn.innerHTML = '<i class="fas fa-times"></i>';
        col4.appendChild(removeBtn);

        div.appendChild(col1); div.appendChild(col2); div.appendChild(col3); div.appendChild(col4);
        document.getElementById('medicationsContainer').appendChild(div);
    }

    // Show a soft warning when the typed medication isn't in the catalog (still saveable)
    function checkMedCatalog(input) {
        var val = input.value.trim().toLowerCase();
        var row = input.closest ? input.closest('.med-row') : null;
        if (!row) {
            var p = input.parentNode;
            while (p && !p.classList.contains('med-row')) p = p.parentNode;
            row = p;
        }
        var warn = row ? row.querySelector('.med-warn') : null;
        if (!warn) return;
        var inCatalog = val === '';
        if (!inCatalog) {
            for (var _ci = 0; _ci < allMedCatalog.length; _ci++) {
                if (allMedCatalog[_ci].name.toLowerCase() === val) { inCatalog = true; break; }
            }
        }
        warn.style.display = inCatalog ? 'none' : '';
    }

    function saveRx() {
        var btn = document.getElementById('saveRxBtn');
        var spinner = document.getElementById('saveRxSpinner');
        btn.disabled = true; spinner.classList.remove('d-none');
        var medications = [];
        for (var i = 1; i <= medCount; i++) {
            var nameEl = document.querySelector('[name="medName_' + i + '"]');
            if (nameEl && nameEl.value.trim()) {
                var qtyEl   = document.querySelector('[name="medQty_'   + i + '"]');
                var notesEl = document.querySelector('[name="medNotes_' + i + '"]');
                medications.push({
                    name:     nameEl.value.trim(),
                    quantity: parseInt(qtyEl   ? qtyEl.value   : '1') || 1,
                    notes:    notesEl ? notesEl.value.trim() : ''
                });
            }
        }
        var body = {
            patientId:                  document.getElementById('rxPatientId').value || null,
            pharmacyId:                 document.getElementById('rxPharmacyId').value || null,
            arrivalDate:                document.getElementById('rxArrivalDate').value,
            serviceDate:                document.getElementById('rxServiceDate').value,
            patientTransportCompanyId:  document.getElementById('rxPatientTransport').value || null,
            pharmacyTransportCompanyId: document.getElementById('rxPharmacyTransport').value || null,
            medications:                medications
        };

        if (!body.patientId) {
            showToast('Please select a patient from the search results.', 'warning');
            btn.disabled = false; spinner.classList.add('d-none');
            document.getElementById('patientSearchInput').focus();
            return;
        }
        if (!body.pharmacyId) {
            showToast('No Default Pharmacy found. Please set a Default Pharmacy on the patient record first.', 'warning');
            btn.disabled = false; spinner.classList.add('d-none');
            return;
        }

        fetchWithAuth(window.rxUrl('/api/rx-records'), { method: 'POST', body: JSON.stringify(body) })
        .then(function(res) {
            if (!res) { btn.disabled = false; spinner.classList.add('d-none'); return; }
            if (res.ok) {
                bootstrap.Modal.getInstance(document.getElementById('rxModal')).hide();
                showToast('RX Record created!', 'success');
