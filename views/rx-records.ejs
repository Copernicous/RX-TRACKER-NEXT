                    var tracking = completedMap[action.id] || null;
                    var prevDone = idx === 0 || completedIds.indexOf(allWorkflowActions[idx-1].id) !== -1;
                    var stepCanComplete = !done && prevDone && canComplete;
                    var prevTracking = idx > 0 ? completedMap[allWorkflowActions[idx-1].id] : null;
                    var nextTracking = idx < allWorkflowActions.length-1 ? completedMap[allWorkflowActions[idx+1].id] : null;
                    var prevStepDate = prevTracking && prevTracking.completionDate ? new Date(prevTracking.completionDate).toISOString().slice(0,10) : (idx === 0 && svcDateR ? svcDateR.toISOString().slice(0,10) : '');
                    var nextStepDate = nextTracking && nextTracking.completionDate ? new Date(nextTracking.completionDate).toISOString().slice(0,10) : '';
                    var completedDateStr = done && tracking && tracking.completionDate ? new Date(tracking.completionDate).toISOString().slice(0,10) : '';
                    var isReturnedDelivery = done && returnedToPharmacy && action.deliveryOutcomeMode === 'delivered_or_returned';
                    var actionLabel = isReturnedDelivery ? 'Package Returned to Pharmacy' : action.name;
                    var actionDescription = isReturnedDelivery
                        ? (rx.deliveryOutcomeNote || 'Delivery attempt was not successful; package returned to pharmacy.')
                        : (action.description || '');
                    var completionLabel = isReturnedDelivery ? 'Returned' : 'Completed';
                    listHtml += '<div class="list-group-item d-flex align-items-center gap-3 ' + (done ? (isReturnedDelivery ? 'list-group-item-warning' : 'list-group-item-success') : '') + '">' +
                        '<span class="badge ' + (done ? (isReturnedDelivery ? 'bg-warning text-dark' : 'bg-success') : 'bg-secondary') + ' rounded-pill">' + action.sequenceNumber + '</span>' +
                        '<div class="flex-grow-1">' +
                            '<div class="fw-bold">' + actionLabel + '</div>' +
                            '<small class="text-muted">' + actionDescription + '</small>' +
                            (done && tracking ? '<br><span class="wf-date-wrap d-inline-flex align-items-center gap-1"><small class="' + (isReturnedDelivery ? 'text-warning' : 'text-success') + ' wf-date-label"><i class="fas ' + (isReturnedDelivery ? 'fa-undo' : 'fa-check') + ' me-1"></i>' + completionLabel + ': ' + new Date(tracking.completionDate).toLocaleDateString() + '</small></span>' : '') +
                        '</div>' +
                        '<div class="d-flex gap-2 wf-cell"' +
                            ' data-rxid="' + rxId + '" data-aid="' + action.id + '"' +
                            ' data-tid="' + (done && tracking ? tracking.id : '') + '"' +
                            ' data-curdate="' + completedDateStr + '"' +
                            ' data-done="' + (done ? '1' : '0') + '"' +
                            ' data-canundo="' + (canUndo && action.id === lastCompletedActionId ? '1' : '0') + '"' +
                            ' data-cancomp="' + (stepCanComplete && !isExpired ? '1' : '0') + '"' +
                            ' data-candate="' + (done && tracking && canEditWorkflowDate && (!isExpired || canOverrideExpired) ? '1' : '0') + '"' +
                            ' data-prevdate="' + prevStepDate + '"' +
                            ' data-nextdate="' + nextStepDate + '"' +
                            ' data-svcdate="' + (svcDateR ? svcDateR.toISOString().slice(0,10) : '') + '">' +
                        '</div>' +
                    '</div>';
                }

                var viewOnlyBanner = (!canComplete && !canUndo && !canWarehouse && !canOverrideExpired)
                ? '<div class="alert alert-info d-flex align-items-center py-2 mb-3"><i class="fas fa-eye me-2"></i><span>View Only - you do not have permission to update workflow steps.</span></div>'
                    : '';
                var overrideOnlyBanner = (!canComplete && !canUndo && !canWarehouse && canOverrideExpired)
                ? '<div class="alert alert-warning d-flex align-items-center py-2 mb-3"><i class="fas fa-key me-2"></i><span>Override Only - you can resolve expired RX workflow locks and update old-cycle workflow dates.</span></div>'
                    : '';

                var html = viewOnlyBanner + overrideOnlyBanner + expiryBanner + globalOverrideBanner + activeLockBanner + warehouseBanner + '<div class="list-group">' + listHtml + '</div>';
                document.getElementById('workflowBody').innerHTML = html;

                var expiredAccessBtn = document.getElementById('expiredAccessBtn');
                if (expiredAccessBtn) {
                    expiredAccessBtn.addEventListener('click', function() {
                        showExpiredAccessModal(rxId, 'This RX record is past the 90-day window. Old-cycle date edits require override access.', canCloseExpired);
                    });
                }
                var closeExpiredInlineBtn = document.getElementById('closeExpiredInlineBtn');
                if (closeExpiredInlineBtn) {
                    closeExpiredInlineBtn.addEventListener('click', function() {
                        showExpiredAccessModal(rxId, 'Closing this RX will mark all remaining workflow steps complete at the 90-day expiry date.', true);
                    });
                }

                /* Wire action buttons inside each wf-cell */
                document.getElementById('workflowBody').querySelectorAll('.wf-cell').forEach(function(cell) {
                    var _rid = parseInt(cell.dataset.rxid);
                    var _aid = parseInt(cell.dataset.aid);
                    var _tid = cell.dataset.tid    || '';
                    var _cur = cell.dataset.curdate || '';
                    var _done= cell.dataset.done   === '1';
                    var _cu  = cell.dataset.canundo === '1';
                    var _cc  = cell.dataset.cancomp === '1';
                    var _cd  = cell.dataset.candate === '1';
                    if (_done) {
                        if (_cu) {
                            var bu = document.createElement('button');
                            bu.className = 'btn btn-sm btn-outline-danger';
                            bu.textContent = 'Undo';
                            bu.dataset.rxid = _rid;
                            bu.addEventListener('click', function() { undoStep(parseInt(this.dataset.rxid)); });
                            cell.appendChild(bu);
                        }
                        if (_cd && _tid) {
                            var bed = document.createElement('button');
                            bed.className = 'btn btn-sm btn-outline-secondary';
                            bed.title = 'Edit completion date';
                            bed.innerHTML = '<i class="fas fa-calendar-alt"></i>';
                            bed.dataset.tid     = _tid;
                            bed.dataset.rxid    = _rid;
                            bed.dataset.curdate = _cur;
                            bed.dataset.prevdate = cell.dataset.prevdate || '';
                            bed.dataset.nextdate = cell.dataset.nextdate || '';
                            bed.dataset.svcdate  = cell.dataset.svcdate  || '';
                            bed.addEventListener('click', function() {
                                editStepDate(this.dataset.tid, parseInt(this.dataset.rxid),
                                    this.dataset.curdate, this.dataset.prevdate,
                                    this.dataset.nextdate, this.dataset.svcdate, this);
                            });
                            cell.appendChild(bed);
                        }
                        cell.insertAdjacentHTML('beforeend', '<i class="fas fa-check-circle text-success fs-5"></i>');
                    } else if (_cc) {
                        var bc = document.createElement('button');
                        bc.className = 'btn btn-sm btn-primary';
                        bc.textContent = 'Complete';
                        bc.dataset.rxid = _rid;
                        bc.dataset.aid  = _aid;
                        bc.addEventListener('click', function() {
                            completeStep(parseInt(this.dataset.rxid), parseInt(this.dataset.aid));
                        });
                        cell.appendChild(bc);
                    } else {
                        cell.insertAdjacentHTML('beforeend', '<i class="fas fa-lock text-muted"></i>');
                    }
                });
            }); // end res.json().then(function(rx)
        }).catch(function() {
            document.getElementById('workflowBody').innerHTML = '<p class="text-danger text-center py-3">Error loading workflow.</p>';
        });
    } // end openWorkflow

    function chooseDeliveryOutcome() {
        return new Promise(function (resolve) {
            var element = document.createElement('div');
            element.className = 'modal fade';
            element.tabIndex = -1;
            element.innerHTML = '<div class="modal-dialog modal-dialog-centered"><div class="modal-content">' +
                '<div class="modal-header"><h5 class="modal-title">Delivery Outcome</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>' +
                '<div class="modal-body"><p class="text-muted small">Select the final outcome for this delivery attempt.</p>' +
                '<div class="form-check mb-2"><input class="form-check-input" type="radio" name="deliveryOutcome" id="deliveryOutcomeDelivered" value="delivered" checked><label class="form-check-label fw-semibold text-success" for="deliveryOutcomeDelivered"><i class="fas fa-check-circle me-1"></i>Delivered to patient</label></div>' +
                '<div class="form-check mb-3"><input class="form-check-input" type="radio" name="deliveryOutcome" id="deliveryOutcomeReturned" value="returned"><label class="form-check-label fw-semibold text-warning" for="deliveryOutcomeReturned"><i class="fas fa-undo me-1"></i>Package returned to pharmacy</label></div>' +
                '<label class="form-label small" for="deliveryOutcomeNote">Return reason <span class="text-muted">(optional)</span></label><textarea id="deliveryOutcomeNote" class="form-control" rows="2" disabled></textarea></div>' +
                '<div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="confirmDeliveryOutcome">Save Outcome</button></div>' +
                '</div></div>';
            document.body.appendChild(element);
            var modal = new bootstrap.Modal(element);
            var settled = false;
            function finish(value) { if (settled) return; settled = true; resolve(value); }
            element.querySelectorAll('input[name="deliveryOutcome"]').forEach(function (input) {
                input.addEventListener('change', function () { element.querySelector('#deliveryOutcomeNote').disabled = this.value !== 'returned'; });
            });
            element.querySelector('#confirmDeliveryOutcome').addEventListener('click', function () {
                var outcome = element.querySelector('input[name="deliveryOutcome"]:checked').value;
                var note = element.querySelector('#deliveryOutcomeNote').value.trim();
                finish({ outcome: outcome, note: outcome === 'returned' ? note : '' });
                modal.hide();
            });
            element.addEventListener('hidden.bs.modal', function () { finish(null); element.remove(); });
            modal.show();
        });
    }

    function completeStep(rxId, actionId) {
        var action = (allWorkflowActions || []).find(function (item) { return Number(item.id) === Number(actionId); });
        if (action && action.deliveryOutcomeMode === 'delivered_or_returned') {
            return chooseDeliveryOutcome().then(function (selection) {
                if (!selection) return;
                return fetchWithAuth(window.rxUrl('/api/rx-records/delivery-outcome'), {
                    method: 'POST',
                    body: JSON.stringify({ rxId: rxId, actionId: actionId, outcome: selection.outcome, note: selection.note })
                }).then(function (res) {
                    if (!res) return;
                    if (!res.ok) return res.json().then(function (err) { showToast(err.error || 'Outcome failed', 'danger'); });
                    showToast(selection.outcome === 'returned' ? 'Package returned to pharmacy.' : 'Package delivered.', 'success');
                    return openWorkflow(rxId).then(function () { return loadRxRecords(); });
                }).catch(function () { showToast('Network error.', 'danger'); });
            });
        }
        fetchWithAuth(window.rxUrl('/api/rx-records/workflow'), { method: 'POST', body: JSON.stringify({ rxId: rxId, actionId: actionId }) })

        .then(function(res) {
            if (!res) return;
            if (res.ok) {
                showToast('Step completed!', 'success');
                return openWorkflow(rxId).then(function() { return loadRxRecords(); });
            } else {
                return res.json().then(function(err) { showToast(err.error || 'Failed', 'danger'); });
            }
        }).catch(function() { showToast('Network error.', 'danger'); });
    }

    function undoStep(rxId) {
        if (!confirm('Are you sure you want to undo the last workflow step?')) return;
        fetchWithAuth(window.rxUrl('/api/rx-records/undo-workflow'), { method: 'POST', body: JSON.stringify({ rxId: rxId }) })
        .then(function(res) {
            if (!res) return;
            if (res.ok) {
                showToast('Workflow step undone.', 'success');
                return openWorkflow(rxId).then(function() { return loadRxRecords(); });
            } else {
                return res.json().then(function(err) { showToast(err.error || 'Undo failed', 'danger'); });
            }
        }).catch(function() { showToast('Network error.', 'danger'); });
