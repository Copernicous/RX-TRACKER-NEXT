        }
        new bootstrap.Modal(document.getElementById('rxModal')).show();
    }

    function applyRxPrefillPatient() {
        if (!_rxPrefillPatientId && !_rxPrefillPatientName) return false;
        var prefId = _rxPrefillPatientId ? String(_rxPrefillPatientId) : '';
        var patient = null;
        if (prefId) {
            for (var i = 0; i < allPatientsList.length; i++) {
                if (String(allPatientsList[i].id) === prefId) {
                    patient = allPatientsList[i];
                    break;
                }
            }
        }
        if (!patient && _rxPrefillPatientName) {
            var target = _rxPrefillPatientName.toLowerCase();
            for (var j = 0; j < allPatientsList.length; j++) {
                var _name = ((allPatientsList[j].firstName || '') + ' ' + (allPatientsList[j].lastName || '')).toLowerCase();
                var _rev = ((allPatientsList[j].lastName || '') + ' ' + (allPatientsList[j].firstName || '')).toLowerCase();
                if (_name === target || _rev === target) {
                    patient = allPatientsList[j];
                    break;
                }
            }
        }
        if (!patient || typeof window.__rxSetPatientSelection !== 'function') return false;

        window.__rxSetPatientSelection(
            patient.id,
            (patient.firstName || '') + ' ' + (patient.lastName || ''),
            patient.serviceDate || '',
            patient.patientTransportCompanyId || '',
            patient.pharmacyTransportCompanyId || '',
            patient.pharmacyId || ''
        );
        return true;
    }

