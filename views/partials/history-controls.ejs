<div id="<%= prefix %>Controls" class="mt-3 mb-3">
    <div class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label class="form-label small mb-1" for="<%= prefix %>Range"><%= dateLabel %></label>
            <select id="<%= prefix %>Range" class="form-select form-select-sm">
                <option value="week">This week</option>
                <option value="month" selected>This month</option>
                <option value="lastMonth">Last month</option>
                <option value="year">This year</option>
                <option value="lastYear">Last year</option>
                <option value="all">All dates</option>
                <option value="custom">Custom dates</option>
            </select>
        </div>
        <div>
            <label class="form-label small mb-1" for="<%= prefix %>From">From</label>
            <input type="date" id="<%= prefix %>From" class="form-control form-control-sm">
        </div>
        <div>
            <label class="form-label small mb-1" for="<%= prefix %>To">To</label>
            <input type="date" id="<%= prefix %>To" class="form-control form-control-sm">
        </div>
        <div class="flex-grow-1" style="min-width:12rem">
            <label class="form-label small mb-1" for="<%= prefix %>Search"><%= searchLabel %></label>
            <input type="search" id="<%= prefix %>Search" maxlength="200" class="form-control form-control-sm" placeholder="<%= searchLabel %>">
        </div>
        <button type="button" id="<%= prefix %>Apply" class="btn btn-sm btn-primary">Apply filters</button>
        <button type="button" id="<%= prefix %>All" class="btn btn-sm btn-outline-secondary">Show all history</button>
        <button type="button" id="<%= prefix %>Export" class="btn btn-sm btn-outline-success">Export filtered history (CSV)</button>
    </div>
    <div class="small text-muted mt-2">Dates use this computer's local time; weeks start Monday. Apply filters before exporting. CSV includes every matching history row across all pages.</div>
    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
        <label class="small mb-0" for="<%= prefix %>Size">Rows per page</label>
        <select id="<%= prefix %>Size" class="form-select form-select-sm w-auto">
            <option value="20">20</option><option value="50">50</option><option value="100">100</option>
        </select>
        <button type="button" id="<%= prefix %>Previous" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
        <span id="<%= prefix %>Page" class="small" aria-live="polite"></span>
        <button type="button" id="<%= prefix %>Next" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
        <span id="<%= prefix %>Status" class="small" role="status" aria-live="polite"></span>
    </div>
</div>
