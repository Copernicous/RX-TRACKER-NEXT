<div class="modal fade" id="rxStageReportModal" tabindex="-1" aria-labelledby="rxStageReportTitle" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-sm-down">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rxStageReportTitle">RX Stage Report</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="rxStageReportForm" class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label" for="stageReportScope">Stage scope</label>
            <select id="stageReportScope" class="form-select">
              <option value="current">Currently at selected stage</option>
              <option value="reached">Reached selected stage (including moved forward)</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" id="stageReportStagesLabel">Stages</label>
            <div class="dropdown">
              <button type="button" id="stageReportStagesBtn" class="form-select text-start" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-labelledby="stageReportStagesLabel stageReportStagesBtn">Select stages</button>
              <div id="stageReportStages" class="dropdown-menu w-100 p-3" style="max-height:240px;overflow-y:auto"></div>
            </div>
          </div>
          <div class="col-sm-4"><label class="form-label" for="stageReportFrom">Stage date from</label><input type="date" id="stageReportFrom" class="form-control"></div>
          <div class="col-sm-4"><label class="form-label" for="stageReportTo">Stage date to</label><input type="date" id="stageReportTo" class="form-control"></div>
          <div class="col-sm-4"><label class="form-label" for="stageReportSort">Sort within each stage</label><select id="stageReportSort" class="form-select"><option value="asc">Oldest to newest</option><option value="desc">Newest to oldest</option></select></div>
          <div class="col-12 d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary" id="stageReportApply">Apply filters</button>
            <button type="button" class="btn btn-outline-success" id="stageReportExport" disabled>Export CSV</button>
          </div>
        </form>
        <p class="small text-muted">This report uses its own filters. Stages are grouped in workflow order. Current stage means the latest reached active workflow step; dates and elapsed calendar days use the application timezone.</p>
        <div id="stageReportStatus" role="status" aria-live="polite" class="mb-2">Select stages and apply filters.</div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead><tr><th>RX ID</th><th>Patient ID</th><th>Patient</th><th>Clinic</th><th id="stageReportDriverHeading">Current driver</th><th>Stage</th><th>Stage date</th><th>Days elapsed</th></tr></thead>
            <tbody id="stageReportRows"></tbody>
          </table>
        </div>
        <div class="d-flex gap-3 align-items-center justify-content-end">
          <button type="button" id="stageReportPrevious" class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
          <span id="stageReportPage"></span>
          <button type="button" id="stageReportNext" class="btn btn-outline-secondary btn-sm" disabled>Next</button>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>
