<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Patient RX System</title>
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">

    <!-- Sidebar -->
    <%- include('partials/sidebar') %>
    <!-- Page Content -->
    <div id="content">
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm">
                <i class="fas fa-bars"></i>
            </button>
            <span class="ms-3 fw-bold fs-5"><%= title %></span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0"><%= title %></h5>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="text" class="form-control form-control-sm" id="tableSearch"
                               placeholder="Search..." style="width:200px">
                        <div class="form-check form-switch mb-0" id="showInactiveWrapper" style="display:none!important">
                            <input class="form-check-input" type="checkbox" id="showInactiveToggle">
                            <label class="form-check-label small text-muted" for="showInactiveToggle">Show Disabled</label>
                        </div>
                        <button class="btn btn-outline-success btn-sm" id="exportCsvBtn">
                            <i class="fas fa-file-csv me-1"></i>Export CSV
                        </button>
                        <button class="btn btn-success btn-sm" id="addNewBtn">
                            <i class="fas fa-plus me-1"></i>Add New
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="crudTable">
                        <thead id="tableHeaders"><tr></tr></thead>
                        <tbody id="tableBody">
                            <tr><td colspan="10" class="text-center text-muted py-4">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small class="text-muted" id="pageInfo">Loading...</small>
                    <nav><ul class="pagination pagination-sm mb-0" id="pagination"></ul></nav>
                </div>
            </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="crudModal" tabindex="-1" aria-labelledby="crudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crudModalLabel">Add Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="crudForm"></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveCrudBtn">
                    <span id="saveSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Are you sure you want to delete this record? This action cannot be undone.</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>
<script>
    const MODULE_NAME  = '<%= module %>';
    const API_ENDPOINT = '<%= apiEndpoint %>';

    document.addEventListener('DOMContentLoaded', () => {
        initApp();
        loadCrudModule(MODULE_NAME, API_ENDPOINT);

        // Show the "Show Disabled" toggle only for soft-delete modules
        const cfg = (typeof MODULE_CONFIGS !== 'undefined') && MODULE_CONFIGS[MODULE_NAME];
        if (cfg && cfg.softDelete) {
            const wrapper = document.getElementById('showInactiveWrapper');
            if (wrapper) wrapper.style.removeProperty('display');
            const toggle = document.getElementById('showInactiveToggle');
            if (toggle) toggle.addEventListener('change', () => refreshTable());
        }

        // Export CSV
        const exportBtn = document.getElementById('exportCsvBtn');
        if (exportBtn) {
            exportBtn.addEventListener('click', () => {
                const config = crudState.config;
                if (!config || !crudState.filtered.length) {
                    showToast('No data to export.', 'warning');
                    return;
                }
                const headers = config.headers;
                const rows = crudState.filtered.map(row => config.columns.map(col => {
                    const val = row[col];
                    if (val === true) return 'Yes';
                    if (val === false) return 'No';
                    return val ?? '';
                }));
                exportToCsv(MODULE_NAME.replace(/[^a-z0-9]/gi,'_') + '_export.csv', headers, rows);
            });
        }
        // Add link to Roles page on the Users module
        if (MODULE_NAME === 'users') {
            const title = document.querySelector('#content .glass-card h5');
            if (title) {
                const link = document.createElement('a');
                link.href = '/roles';
                link.className = 'btn btn-sm btn-outline-warning ms-2';
                link.innerHTML = '<i class="fas fa-shield-alt me-1"></i>Manage Roles';
                title.parentElement.querySelector('.d-flex')?.prepend(link);
            }
        }
    });
</script>
</body>
</html>
