{
  "name": "patient-rx-system",
  "version": "2.0.12",
  "description": "Patient RX Delivery Management System",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "build:exe": "npx --yes @yao-pkg/pkg app.js --target node22-win-x64 --output dist/server.exe --compress GZip"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "scripts": [
      "models/**/*.js",
      "controllers/**/*.js",
      "routes/**/*.js",
      "middleware/**/*.js",
      "services/**/*.js",
      "node_modules/bcryptjs/**/*.js",
      "node_modules/ejs/**/*.js",
      "node_modules/jsonwebtoken/**/*.js",
      "node_modules/qrcode/**/*.js",
      "node_modules/speakeasy/**/*.js",
      "node_modules/csv-parser/**/*.js",
      "node_modules/nodemailer/**/*.js",
      "node_modules/node-cron/**/*.js",
      "node_modules/multer/**/*.js",
      "node_modules/sequelize/**/*.js",
      "node_modules/pg/**/*.js"
    ],
    "assets": [
      "views/**/*",
      "public/**/*",
      "config/**/*",
      "migrations/**/*",
      "seeders/**/*",
      "data/**/*",
      "CHANGELOG.md",
      ".env.example"
    ],
    "outputPath": "dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.4.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}

